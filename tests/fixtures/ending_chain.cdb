bu mgs_integral_native!NewRanking ".printf \"OBSERVE ranking constructor story=%d roll_phase=%d completions=%d unlock=%d vsync=%d\\n\", wo(mgs_integral_native!var_buf+a), by(mgs_integral_native!var_buf+3d7), wo(mgs_integral_native!linkvarbuf), wo(mgs_integral_native!linkvarbuf+6), poi(mgs_integral_native!frames); gc"
