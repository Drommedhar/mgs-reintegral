+vec4 readCardTexel(ivec2 position) {
+    if (any(lessThan(position, ivec2(captionBounds.xy))) ||
+        any(greaterThanEqual(position, ivec2(captionBounds.zw)))) return vec4(0.0);
+    uvec2 wrapped = (uvec2(position) & uvec2(255u) & texWindow.xy) | texWindow.zw;
+    if (textureMode == 1u) return readVram(pageBase + ivec2(wrapped));
+    uint word = rgb5551ToU16(readVram(pageBase + ivec2(wrapped.x >> texelShift, wrapped.y)));
+    uint index = (word >> ((wrapped.x & subPixelMask) * indexShift)) & indexMask;
+    return readVram(ivec2((clut % 64u) * 16u + index, clut / 64u));
+}
+
+vec4 cubicWeights(float t) {
+    float t2 = t * t;
+    float t3 = t2 * t;
+    return vec4(-0.5 * t + t2 - 0.5 * t3, 1.0 - 2.5 * t2 + 1.5 * t3,
+                0.5 * t + 2.0 * t2 - 1.5 * t3, -0.5 * t2 + 0.5 * t3);
+}
+
+vec4 readCard() {
+    vec2 position = rawUV - vec2(0.5);
+    ivec2 base = ivec2(floor(position));
+    vec4 wx = cubicWeights(fract(position.x));
+    vec4 wy = cubicWeights(fract(position.y));
+    vec4 color = vec4(0.0);
+    float mask = 0.0;
+    for (int y = 0; y < 4; ++y) {
+        for (int x = 0; x < 4; ++x) {
+            vec4 sampleColor = readCardTexel(base + ivec2(x - 1, y - 1));
+            color.rgb += sampleColor.rgb * wx[x] * wy[y];
+            if (wx[x] * wy[y] > 0.0) mask = max(mask, sampleColor.a);
+        }
+    }
+    return vec4(clamp(color.rgb, 0.0, 1.0), mask);
+}
