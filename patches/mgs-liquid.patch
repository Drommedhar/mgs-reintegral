diff --git a/source/animal/liquid/b_smoke.c b/source/animal/liquid/b_smoke.c
new file mode 100644
index 000000000..74a7521da
--- /dev/null
+++ b/source/animal/liquid/b_smoke.c
@@ -0,0 +1,61 @@
+#include "b_smoke.h"
+
+#include <stddef.h>
+#include "anime/animconv/anime.h"
+#include "libgcl/libgcl.h"
+
+void AN_Smoke_800CE55C(SVECTOR *pos);
+
+_Static_assert(sizeof(BlackSmokeWork) == 76, "Original black-smoke actor size");
+_Static_assert(offsetof(BlackSmokeWork, phases) == 64, "Original smoke emission phases");
+
+void BlackSmokeAct(BlackSmokeWork *work)
+{
+    for (int i = 0; i < work->count; i++)
+    {
+        if (work->timer % 8 == work->phases[i])
+            AN_Smoke_800CE55C(&work->positions[i]);
+    }
+    work->timer++;
+}
+
+static void BlackSmokeDie(BlackSmokeWork *work)
+{
+}
+
+static int ReadPositions(SVECTOR *positions)
+{
+    int   count = 0;
+    char *text;
+    while ((text = GCL_NextStr()) != NULL)
+    {
+        if (count >= 4)
+            return count;
+        GCL_StrToSV(text, &positions[count++].vx);
+    }
+    return count;
+}
+
+static int BlackSmokeResources(BlackSmokeWork *work)
+{
+    if (GCL_GetOption('p') == NULL)
+        return -1;
+    work->count = ReadPositions(work->positions);
+    for (int i = 0; i < work->count; i++)
+        work->phases[i] = i * (8 / work->count);
+    return 0;
+}
+
+void *NewBlackSmoke(void)
+{
+    BlackSmokeWork *work = GV_NewActor(GV_ACTOR_USER, sizeof(*work));
+    if (work == NULL)
+        return NULL;
+    GV_SetNamedActor(&work->actor, BlackSmokeAct, BlackSmokeDie, "b_smoke.c");
+    if (BlackSmokeResources(work) < 0)
+    {
+        GV_DestroyActor(&work->actor);
+        return NULL;
+    }
+    return work;
+}
