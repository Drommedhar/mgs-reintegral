+/* Private presentation adapter; included after the native title Work definition. */
+static void TitleUiTexture(Work *work, const void *poly, unsigned name)
+{
+    const POLY_FT4 *groups[] = {work->f18C_polys, work->f4FC_polys, work->f7CC_polys};
+    const unsigned sizes[] = {22, 18, 9};
+    unsigned index = 0;
+    for (unsigned group = 0; group < 3; ++group)
+        for (unsigned item = 0; item < sizes[group]; ++item, ++index)
+            if (poly == &groups[group][item]) work->ui_textures[index] = name;
+    for (unsigned item = 0; item < 6; ++item)
+        if (poly == &work->f934_polys[item]) work->ui_textures[49 + item] = name;
+}
+
+static void TitleUiTexts(Work *work)
+{
+    for (unsigned index = 0; index < MGS_TITLE_TEXTS; ++index) {
+        if (!(work->ui_text_mask & (1u << index)) || work->unk[index].num != 1) continue;
+        const RECT *rect = &work->unk[index].rect;
+        MgsGodotTitleText(index, (MgsSubtitleFrame){.active=1, .visible=1,
+            .x=rect->x, .y=rect->y, .width=rect->w, .height=rect->h}, work->kcb[index].cbuffer);
+    }
+}
+
+static unsigned TitleUiRgb(unsigned r, unsigned g, unsigned b) { return r | (g << 8) | (b << 16); }
+
+static MgsTitleElement TitleUiElement(unsigned identity, int layer, MgsTitleElement element)
+{
+    DG_TEX *texture = DG_GetTexture(identity);
+    element.texture = identity;
+    element.x += 160;
+    element.y += 112;
+    element.source_x = (element.source_x - texture->off_x) & 255;
+    element.source_y = (element.source_y - texture->off_y) & 255;
+    element.source_width = (element.source_width & 255) ? element.source_width & 255 : 256;
+    element.source_height = (element.source_height & 255) ? element.source_height & 255 : 256;
+    element.layer = layer / 256;
+    return element;
+}
+
+static void TitleUiView(Work *work)
+{
+    MgsTitleFrame frame = {.active=work->fA74==18 || work->fA74==19 || work->fA74==21,
+        .mode=work->fA74, .selection=work->fA78, .difficulty=work->f24E4+1,
+        .extreme=work->demo_rank!=0, .storage_choice=work->f24E0,
+        .storage={work->f24F0,work->f24F4}};
+    const POLY_FT4 *groups[] = {work->f18C_polys, work->f4FC_polys, work->f7CC_polys};
+    const int *layers[] = {work->f30, work->fF8, work->f140};
+    const unsigned sizes[] = {22,18,9};
+    MgsTitleElement elements[MGS_TITLE_ELEMENTS];
+    unsigned index = 0;
+    for (unsigned group = 0; group < 3; ++group) {
+        for (unsigned item = 0; item < sizes[group]; ++item, ++index) {
+            const POLY_FT4 *p = &groups[group][item];
+            elements[index] = TitleUiElement(work->ui_textures[index], layers[group][item],
+                (MgsTitleElement){.x=p->x0,.y=p->y0,.width=p->x1-p->x0,.height=p->y2-p->y0,
+                    .source_x=p->u0,.source_y=p->v0,.source_width=p->u1-p->u0,.source_height=p->v2-p->v0,
+                    .top_rgb=TitleUiRgb(p->r0,p->g0,p->b0),.bottom_rgb=TitleUiRgb(p->r0,p->g0,p->b0),
+                    .blend=(p->code&2) ? 1+((p->tpage>>5)&3) : 0});
+        }
+    }
+    for (unsigned item = 0; item < 6; ++item, ++index) {
+        const POLY_GT4 *p = &work->f934_polys[item];
+        elements[index] = TitleUiElement(work->ui_textures[index], work->fE0[item],
+            (MgsTitleElement){.x=p->x0,.y=p->y0,.width=p->x1-p->x0,.height=p->y2-p->y0,
+                .source_x=p->u0,.source_y=p->v0,.source_width=p->u1-p->u0,.source_height=p->v2-p->v0,
+                .top_rgb=TitleUiRgb(p->r0,p->g0,p->b0),.bottom_rgb=TitleUiRgb(p->r2,p->g2,p->b2),
+                .blend=(p->code&2) ? 1+((p->tpage>>5)&3) : 0});
+    }
+    for (unsigned item = 0; item < MGS_TITLE_ELEMENTS; ++item)
+        if (elements[item].layer) frame.active = 1;
+    MgsGodotTitleView(frame,elements);
+}
