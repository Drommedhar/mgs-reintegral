diff --git a/psyz/src/platform/sdl3_gpu_debug.h b/psyz/src/platform/sdl3_gpu_debug.h
new file mode 100644
index 0000000..57e2f6b
--- /dev/null
+++ b/psyz/src/platform/sdl3_gpu_debug.h
@@ -0,0 +1,104 @@
+#ifndef SDL3_GPU_DEBUG_H
+#define SDL3_GPU_DEBUG_H
+
+enum { DEBUG_PANEL_W = 328, DEBUG_PANEL_H = 28 };
+static SDL_Surface* debug_surface;
+static SDL_Renderer* debug_renderer;
+static SDL_GPUTexture* debug_texture;
+static SDL_GPUTransferBuffer* debug_transfer;
+static char debug_uploaded[256];
+
+static void DebugPanelDestroy(SDL_GPUDevice* gpu) {
+    SDL_DestroyRenderer(debug_renderer);
+    SDL_DestroySurface(debug_surface);
+    if (debug_texture)
+        SDL_ReleaseGPUTexture(gpu, debug_texture);
+    if (debug_transfer)
+        SDL_ReleaseGPUTransferBuffer(gpu, debug_transfer);
+    debug_renderer = NULL;
+    debug_surface = NULL;
+    debug_texture = NULL;
+    debug_transfer = NULL;
+    debug_uploaded[0] = 0;
+}
+
+static bool DebugPanelInit(SDL_GPUDevice* gpu) {
+    debug_surface = SDL_CreateSurface(DEBUG_PANEL_W, DEBUG_PANEL_H, SDL_PIXELFORMAT_RGBA32);
+    if (!debug_surface)
+        return false;
+    debug_renderer = SDL_CreateSoftwareRenderer(debug_surface);
+    SDL_GPUTextureCreateInfo texture = {
+        .type = SDL_GPU_TEXTURETYPE_2D,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width = DEBUG_PANEL_W, .height = DEBUG_PANEL_H,
+        .layer_count_or_depth = 1, .num_levels = 1,
+    };
+    debug_texture = SDL_CreateGPUTexture(gpu, &texture);
+    SDL_GPUTransferBufferCreateInfo transfer = {
+        .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+        .size = DEBUG_PANEL_W * DEBUG_PANEL_H * 4,
+    };
+    debug_transfer = SDL_CreateGPUTransferBuffer(gpu, &transfer);
+    return debug_renderer && debug_texture && debug_transfer;
+}
+
+static bool DebugPanelUpload(SDL_GPUDevice* gpu, SDL_GPUCommandBuffer* cmd, const char* text) {
+    char lines[256];
+    SDL_strlcpy(lines, text, sizeof(lines));
+    char* second = strchr(lines, '\n');
+    if (second)
+        *second++ = 0;
+    if (!SDL_SetRenderDrawColor(debug_renderer, 12, 18, 24, 255) ||
+        !SDL_RenderClear(debug_renderer) ||
+        !SDL_SetRenderDrawColor(debug_renderer, 230, 245, 240, 255) ||
+        !SDL_RenderDebugText(debug_renderer, 4, 5, lines) ||
+        (second && !SDL_RenderDebugText(debug_renderer, 4, 15, second)) ||
+        !SDL_RenderPresent(debug_renderer))
+        return false;
+    unsigned char* pixels = SDL_MapGPUTransferBuffer(gpu, debug_transfer, true);
+    if (!pixels)
+        return false;
+    for (int row = 0; row < DEBUG_PANEL_H; ++row)
+        memcpy(pixels + row * DEBUG_PANEL_W * 4,
+               (const unsigned char*)debug_surface->pixels + row * debug_surface->pitch,
+               DEBUG_PANEL_W * 4);
+    SDL_UnmapGPUTransferBuffer(gpu, debug_transfer);
+    SDL_GPUTextureTransferInfo source = {
+        .transfer_buffer = debug_transfer,
+        .pixels_per_row = DEBUG_PANEL_W, .rows_per_layer = DEBUG_PANEL_H,
+    };
+    SDL_GPUTextureRegion destination = {
+        .texture = debug_texture, .w = DEBUG_PANEL_W, .h = DEBUG_PANEL_H, .d = 1,
+    };
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    SDL_UploadToGPUTexture(copy, &source, &destination, true);
+    SDL_EndGPUCopyPass(copy);
+    SDL_strlcpy(debug_uploaded, text, sizeof(debug_uploaded));
+    return true;
+}
+
+static bool DebugPanelDraw(SDL_GPUDevice* gpu, SDL_GPUCommandBuffer* cmd,
+                           SDL_GPUTexture* output, Uint32 width, Uint32 height,
+                           const char* text) {
+    if (!*text)
+        return true;
+    if (!debug_texture && !DebugPanelInit(gpu))
+        return false;
+    if (strcmp(text, debug_uploaded) && !DebugPanelUpload(gpu, cmd, text))
+        return false;
+    Uint32 scale = height >= 960 && width >= DEBUG_PANEL_W * 2 + 16 ? 2 : 1;
+    Uint32 panel_w = SDL_min(DEBUG_PANEL_W * scale, width);
+    Uint32 panel_h = SDL_min(DEBUG_PANEL_H * scale, height);
+    Uint32 margin = SDL_min(12, width - panel_w);
+    SDL_GPUBlitInfo blit = {
+        .source = {.texture = debug_texture, .w = DEBUG_PANEL_W, .h = DEBUG_PANEL_H},
+        .destination = {.texture = output, .x = width - panel_w - margin,
+                        .y = SDL_min(12, height - panel_h), .w = panel_w, .h = panel_h},
+        .load_op = SDL_GPU_LOADOP_LOAD, .filter = SDL_GPU_FILTER_NEAREST,
+    };
+    SDL_BlitGPUTexture(cmd, &blit);
+    return true;
+}
+
+#endif
