+static void ObserveRefill(int queued) {
+    Uint64 now = SDL_GetTicksNS();
+    double gap_us = last_refill_ns ? (now - last_refill_ns) / 1000.0 : 0;
+    if (gap_us > audio_stats.max_refill_gap_us)
+        audio_stats.max_refill_gap_us = gap_us;
+    last_refill_ns = now;
+    if (!queued && queued_once)
+        ++audio_stats.empty_refills;
+    queued_once = true;
+}
+
+int Psyz_AudioStats(PsyzAudioStats* stats) {
+    if (!stats)
+        return -1;
+    *stats = audio_stats;
+    stats->paused = !sdl_stream || SDL_AudioStreamDevicePaused(sdl_stream);
+    int queued = sdl_stream ? SDL_GetAudioStreamQueued(sdl_stream) : 0;
+    if (queued < 0)
+        return -1;
+    stats->queued_frames = (unsigned)queued / (N_CHANNELS * SAMPLE_SIZE);
+    return 0;
+}
 
