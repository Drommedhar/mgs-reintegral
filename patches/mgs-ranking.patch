+    }
+    if (file >= 0)
+    {
+        rank_800CC70C(0x4300000c);
+        rank_800CC70C(0x4300000d);
+        if (rank_800CC70C(0x10000000))
+            goto retry;
+        if (memcard_check(PocketPortState[0]))
+            goto retry_error;
+        if (!memcard_delete(PocketPortState[0], card->files[file].name))
+            goto card_error;
+        card = memcard_files(PocketPortState[0]);
