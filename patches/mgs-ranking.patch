+static int PocketDetectPorts(void)
+{
+    int port, count = 0;
+    PocketPortMask = 0;
+    for (port = 0; port < 2; ++port)
+    {
+        int status = memcard_check(port);
+        PocketCardStatus[port] = (unsigned char)status;
+        if ((status & 0x01000000) && PocketPortState[1] == port)
+            PocketPortState[1] = -1;
+        if ((unsigned char)status != 3)
+        {
+            if (rank_800CC104(port))
+            {
+                ++count;
+                PocketPortMask |= 1 << port;
+            }
+            else
+                memcard_files(port);
+        }
+    }
+    return count;
+}
+
+static int PocketWaitForPort(void)
+{
+    int port;
+    PocketResponse = -2;
+    PocketRequest = 0x20000001;
+    PocketPortMask &= ~0x80;
+    do
+    {
+        for (port = 0; port < 2; ++port)
+        {
+            int status = (unsigned char)memcard_check(port);
+            if (status == PocketCardStatus[port])
+                continue;
+            PocketCardStatus[port] = status;
+            if (status == 3)
+            {
+                PocketPortMask &= ~(1 << port);
+                if (PocketPortState[1] == port)
+                    PocketPortState[1] = -1;
+            }
+            else if (rank_800CC104(port))
+                PocketPortMask |= 1 << port;
+            PocketPortMask |= 0x80;
+        }
+        if (PocketResponse == -1)
+            return -1;
+        if (PocketResponse >= 0)
+        {
+            if (!(PocketPortMask & (1 << PocketResponse)))
+            {
+                PocketPortState[0] = PocketPortState[1] = -1;
+                return 0;
+            }
+            PocketPortState[0] = PocketResponse;
+            if (PocketPortState[1] != PocketResponse)
+                PocketPortState[2] = -1;
+            PocketPortState[1] = PocketResponse;
+        }
+    } while (PocketResponse == -2);
+    return 1;
+}
+
+static int PocketFinishTransfer(int success)
+{
+    rank_800CC70C(0x010000ff);
+    if (success)
+    {
+        GM_PadResetDisable = 0;
+        PocketResult = 0;
+        return rank_800CC70C(0xc1000001);
+    }
+    rank_800CC70C(0x45000003);
+    GM_PadResetDisable = 0;
+    PocketResult = 5;
+    return rank_800CC70C(0xc5000002);
+}
