diff --git a/source/overlays/rank/onoda/rank/rank_stats.c b/source/overlays/rank/onoda/rank/rank_stats.c
new file mode 100644
index 000000000..d6b82e4c6
--- /dev/null
+++ b/source/overlays/rank/onoda/rank/rank_stats.c
@@ -0,0 +1,175 @@
+#include "rank_native.h"
+
+typedef struct RankStatsStyle
+{
+    int label_red;
+    int shared_green;
+    int label_blue;
+    int value_green;
+    int layout;
+} RankStatsStyle;
+
+static void StatsLocate(const RankStatsStyle *style, int x, int row, int align)
+{
+    static const int first_y[] = {60, 57, 53, 47};
+    if ((unsigned)style->layout < 4)
+        MENU_Locate(x, first_y[style->layout] + row * (style->layout == 0 ? 14 : 11), align);
+}
+
+static void LabelColor(const RankStatsStyle *style)
+{
+    MENU_Color(style->label_red, style->shared_green, style->label_blue);
+}
+
+static void ValueColor(const RankStatsStyle *style)
+{
+    MENU_Color(style->shared_green, style->value_green, style->value_green);
+}
+
+static void StatsDigit(const RankStatsStyle *style, int x, int row, int digit)
+{
+    StatsLocate(style, x, row, 16);
+    ValueColor(style);
+    MENU_Printf("%d", digit);
+}
+
+static void PlayTime(RankWork *work, const RankStatsStyle *style)
+{
+    int hours = work->play_hours;
+    int minutes = work->play_minutes;
+    int seconds = work->play_seconds;
+    StatsLocate(style, 164, 0, 17);
+    LabelColor(style);
+    MENU_Printf("PLAY TIME /");
+    if (hours >= 100)
+    {
+        hours = 99;
+        minutes = seconds = 59;
+    }
+    StatsDigit(style, 172, 0, hours / 10);
+    StatsDigit(style, 181, 0, hours % 10);
+    StatsLocate(style, 193, 0, 16);
+    ValueColor(style);
+    MENU_Printf(":");
+    StatsDigit(style, 199, 0, minutes / 10);
+    StatsDigit(style, 208, 0, minutes % 10);
+    StatsLocate(style, 220, 0, 16);
+    ValueColor(style);
+    MENU_Printf(":");
+    StatsDigit(style, 226, 0, seconds / 10);
+    StatsDigit(style, 235, 0, seconds % 10);
+}
+
+static void Counter(const RankStatsStyle *style, int row, const char *label, int value, const char *units)
+{
+    int hundreds;
+    int tens;
+    StatsLocate(style, 164, row, 17);
+    LabelColor(style);
+    MENU_Printf(label);
+    if (value >= 1000)
+        value = 999;
+    hundreds = value / 100;
+    tens = value % 100 / 10;
+    if (hundreds != 0)
+        StatsDigit(style, 172, row, hundreds);
+    if (tens != 0 || hundreds != 0)
+        StatsDigit(style, 181, row, tens);
+    StatsDigit(style, 190, row, value % 10);
+    StatsLocate(style, 214, row, 16);
+    LabelColor(style);
+    MENU_Printf(units);
+}
+
+static void GameLevel(const RankStatsStyle *style, int y)
+{
+    static const char *const names[] = {"VERY EASY", "EASY", "NORMAL", "HARD", "EXTREME"};
+    MENU_Locate(164, y, 17);
+    LabelColor(style);
+    MENU_Printf("GAME LEVEL /");
+    MENU_Locate(172, y, 16);
+    ValueColor(style);
+    if (GM_GameLevel >= -1 && GM_GameLevel <= 3)
+        MENU_Printf(names[GM_GameLevel + 1]);
+}
+
+static void UsedItems(const RankStatsStyle *style, int y, int stealth, int both)
+{
+    MENU_Locate(164, y, 17);
+    LabelColor(style);
+    MENU_Printf(both ? "USED ITEMS /" : "USED ITEM /");
+    MENU_Locate(172, y, 16);
+    ValueColor(style);
+    MENU_Printf(stealth || both ? "STEALTH" : "BANDANA");
+    if (both)
+    {
+        MENU_Locate(172, y + 11, 16);
+        ValueColor(style);
+        MENU_Printf("BANDANA");
+    }
+}
+
+static void ExtraStats(RankWork *work, const RankStatsStyle *style)
+{
+    switch (style->layout)
+    {
+    case 0:
+        break;
+    case 1:
+        if (work->field_49C)
+            GameLevel(style, 46);
+        else
+            UsedItems(style, 112, work->field_4A0, 0);
+        break;
+    case 2:
+        if (work->field_49C)
+        {
+            GameLevel(style, 42);
+            UsedItems(style, 119, work->field_4A0, 0);
+        }
+        else
+            UsedItems(style, 108, 1, 1);
+        break;
+    default:
+        GameLevel(style, 36);
+        UsedItems(style, 113, 1, 1);
+        break;
+    }
+    MENU_Locate(115 - rank_sizes[work->field_494], 143, 16);
+    LabelColor(style);
+    MENU_Printf("CODE NAME");
+    if (GM_GameLevel != -1)
+    {
+        MENU_Locate(107, 163, 16);
+        LabelColor(style);
+        MENU_Printf("SPECIAL ITEMS");
+    }
+}
+
+static void DrawStats(RankWork *work, int time)
+{
+    RankStatsStyle style;
+    style.label_red = 82 - 82 * time / 32;
+    style.shared_green = 140 - 140 * time / 32;
+    style.label_blue = 123 - 123 * time / 32;
+    style.value_green = 181 - 181 * time / 32;
+    style.layout = work->field_498;
+    PlayTime(work, &style);
+    Counter(&style, 1, "SAVE /", GM_SaveCount, "TIMES");
+    Counter(&style, 2, "CONTINUE /", GM_ContinueCount, "TIMES");
+    Counter(&style, 3, "BEING FOUND /", GM_EnemyWatchCount, "TIMES");
+    Counter(&style, 4, "ENEMIES /", GM_EnemyKillCount, "KILLED");
+    Counter(&style, 5, "RATIONS /", GM_RationUseCount, "USED");
+    ExtraStats(work, &style);
+}
+
+void rank_800D536C(RankWork *work)
+{
+    DrawStats(work, 0);
+}
+
+void rank_800D705C(RankWork *work)
+{
+    if (work->time < 33)
+        DrawStats(work, work->time);
+}
