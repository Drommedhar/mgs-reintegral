+#include "pocket_menu.h"
+#include "mgs_pocket_device.h"
+
+extern char *MGS_MemoryCardName;
+
+static uint32_t PocketReadWord(const unsigned char *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 | (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static void PocketWriteWord(unsigned char *bytes, uint32_t value)
+{
+    int i;
+    for (i = 0; i < 4; ++i)
+        bytes[i] = value >> (8 * i);
+}
+
+static unsigned char PocketEncodeCharacter(unsigned char character)
+{
+    if (character >= 'A' && character <= 'Z')
+        return character - 33;
+    if (character >= '0' && character <= '9')
+        return character - '0';
+    switch (character)
+    {
+    case '!':
+        return 58;
+    case '?':
+        return 59;
+    case ':':
+        return 15;
+    case '[':
+        return 61;
+    case ']':
+        return 62;
+    default:
+        return 31;
+    }
+}
+
+static char PocketDecodeCharacter(unsigned char code)
+{
+    if (code >= 32 && code <= 57)
+        return code + 33;
+    if (code <= 9)
+        return code + '0';
+    switch (code)
+    {
+    case 58:
+        return '!';
+    case 59:
+        return '?';
+    case 15:
+        return ':';
+    case 61:
+        return '[';
+    case 62:
+        return ']';
+    default:
+        return ' ';
+    }
+}
+
+void rank_800CBD14(int mode, int character, char *name)
+{
+    unsigned char *end = pocket_image + PocketImageSize;
+    uint32_t       first = 0x80000000, second;
+    int            i, digits = 0;
+    memset(end - 512, 0, 512);
+    for (i = 0; i < 64; ++i)
+        PocketWriteWord(end - 512 + i * 4, PocketBitmap[i]);
+    for (i = 0; i < 8; ++i)
+    {
+        if (name[i] >= '0' && name[i] <= '9')
+            ++digits;
+        name[i] = PocketEncodeCharacter((unsigned char)name[i]);
+    }
+    if (digits == 8)
+    {
+        PocketNameId = 0;
+        for (i = 0; i < 8; ++i)
+            PocketNameId = PocketNameId * 10 + name[i];
+    }
+    for (i = 0; i < 5; ++i)
+        first |= (uint32_t)(unsigned char)name[i] << (6 * i);
+    second = ((uint32_t)(unsigned char)mode << 24) | ((uint32_t)(unsigned char)character << 18);
+    for (i = 5; i < 8; ++i)
+        second |= (uint32_t)(unsigned char)name[i] << (6 * (i - 5));
+    PocketWriteWord(end - 248, 604800);
+    PocketWriteWord(end - 232, 604800);
+    PocketWriteWord(end - 228, 0);
+    PocketWriteWord(end - 240, first);
+    PocketWriteWord(end - 236, second);
+    PocketWriteWord(end - 124, first);
+    PocketWriteWord(end - 120, second);
+    rank_800CC19C(PocketFilename);
+    memcpy(end - 144, PocketFilename, 16);
+}
+
+static int PocketReadSerial(int port)
+{
+    unsigned char *end = pocket_image + PocketImageSize;
+    uint32_t       serial, identity;
+    if (MgsPocketSerial(port, &serial) != MGS_POCKET_OK)
+        return 0;
+    PocketWriteWord(end - 244, serial);
+    if ((uint32_t)PocketNameId == (serial & 0xffffff))
+    {
+        identity = PocketReadWord(end - 236) & 0xff03ffff;
+        PocketWriteWord(end - 236, identity);
+        PocketWriteWord(end - 120, identity);
+    }
+    return 1;
+}
+
+int rank_800CC104(int port)
+{
+    MgsPocketResult result;
+    int             retry = 4;
+    do
+    {
+        result = MgsPocketProbe(port);
+    } while (result == MGS_POCKET_IO_ERROR && --retry > 0);
+    return result == MGS_POCKET_OK || result == MGS_POCKET_NEW_DEVICE;
+}
+
+void rank_800CC19C(char *filename)
+{
+    snprintf(filename, sizeof(PocketFilename), "%s", MGS_MemoryCardName);
