+    PocketTransferProgress = 0;
+    rank_800CC70C(0x01000009);
+    GM_PadResetDisable = 1;
+    return PocketFinishTransfer(rank_800CC260(card));
+retry_error:
+    rank_800CC70C(0x45000003);
+    goto retry;
+no_space:
+    rank_800CC70C(0x43200004);
+    goto finish_error;
+card_error:
+    rank_800CC70C(0x45000003);
+finish_error:
+    GM_PadResetDisable = 0;
+    PocketResult = 5;
+    return rank_800CC70C(0xc5000002);
+}
