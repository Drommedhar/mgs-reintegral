diff --git a/source/overlays/rank/onoda/rank/rank_award.c b/source/overlays/rank/onoda/rank/rank_award.c
new file mode 100644
index 000000000..18b99ccf9
--- /dev/null
+++ b/source/overlays/rank/onoda/rank/rank_award.c
@@ -0,0 +1,83 @@
+#include "rank_native.h"
+
+static int rank_group(void)
+{
+    int alerts = GM_EnemyWatchCount, kills = GM_EnemyKillCount;
+    int hours = GM_PlayTimeHours, rations = GM_RationUseCount, saves = GM_SaveCount;
+    int ratio = kills <= 25 ? 1000 : 10 * alerts / (kills - 25);
+    if (GM_ContinueCount == 0 && alerts < 5 && kills < 26 && rations < 2 && hours < 3)
+        return 0;
+    if (hours < 2 || (hours == 2 && GM_PlayTimeSeconds / 60 < 30))
+        return 1;
+    if (kills >= 250)
+        return 2;
+    if (hours >= 18 && rations >= 130 && saves >= 80)
+        return 6;
+    if (rations >= 130)
+        return 3;
+    if (saves >= 80)
+        return 4;
+    if (hours >= 18)
+        return 5;
+    if (alerts < 31)
+        return ratio < 9 ? 7 : ratio < 17 ? 9 : 10;
+    if (alerts < 56)
+        return ratio < 5 ? 8 : ratio < 21 ? 9 : 11;
+    return ratio < 9 ? 8 : ratio < 17 ? 9 : 11;
+}
+
+void rank_800D8EE4(RankWork *work)
+{
+    POLY_FT4 *packet = &work->pol[12];
+    int       group = rank_group();
+    int       half_width;
+    if (GM_GameLevel >= -1 && GM_GameLevel <= 3)
+        work->field_494 = group * 4 + (GM_GameLevel < 0 ? 0 : GM_GameLevel);
+    if (work->field_494 == 3)
+    {
+        rank_800D8E64(work, GV_StrCode("big_back_l"), &work->pol[0]);
+        rank_800D8E64(work, GV_StrCode("big_back_r"), &work->pol[1]);
+    }
+    half_width = rank_sizes[work->field_494];
+    setXY4(packet, 40 - half_width, 30, 40 + half_width, 30, 40 - half_width, 38, 40 + half_width, 38);
+    rank_800D8E64(work, rank_texture_ids[work->field_494], packet);
+    work->field_49C = 1;
+    ++work->field_498;
+    if (GM_StealthFlag > 0)
+    {
+        work->field_4A0 = 1;
+        ++work->field_498;
+    }
+    if (GM_BandanaFlag > 0)
+    {
+        work->field_4A4 = 1;
+        ++work->field_498;
+    }
+    if (GM_GameLevel == -1)
+    {
+        work->field_4AC = 0;
+        work->field_4B0 = 0;
+        work->field_4B4 = 0;
+        work->field_4A8 = 0;
+    }
+    else
+    {
+        if (GM_CameraFlag >= 0)
+        {
+            work->field_4AC = 1;
+            ++work->field_4A8;
+        }
+        if (GM_ClearFlag >= 2)
+        {
+            work->field_4B0 = 1;
+            ++work->field_4A8;
+        }
+        if (GM_ClearFlag == 1 || GM_ClearFlag >= 3)
+        {
+            work->field_4B4 = 1;
+            ++work->field_4A8;
+        }
+    }
+    GM_PDA_ClearRank = (GM_PDA_ClearRank & 0xff00) | (work->field_494 & 0xff);
+    GM_Result = work->field_494;
+}
