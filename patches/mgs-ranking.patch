+        goto retry_error;
+    rank_800CC19C(PocketFilename);
+    file = rank_800CC1E0(card, PocketFilename);
+    if (upload)
+    {
+        if (file < 0)
+            goto no_space;
+        rank_800CC70C(0x01000009);
+        snprintf(PocketFilename, sizeof(PocketFilename), "%s", card->files[file].name);
