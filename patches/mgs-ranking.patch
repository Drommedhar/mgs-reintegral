+        uint32_t first = PocketReadWord(PocketCardData + 132 + i * 12);
+        uint32_t second = PocketReadWord(PocketCardData + 136 + i * 12);
+        if (!(first & 0x80000000))
+            break;
+        for (j = 0; j < 5; ++j)
+            names[i][j] = PocketDecodeCharacter((first >> (6 * j)) & 63);
+        for (j = 5; j < 8; ++j)
+            names[i][j] = PocketDecodeCharacter((second >> (6 * (j - 5))) & 63);
+        characters[i] = (second >> 18) & 63;
+        modes[i] = second >> 24;
+        ++count;
+    }
+    if (!count)
+        return 0;
+    PocketScoreboard.count = count;
+    memcpy(PocketScoreboard.first.name, names[0], 12);
+    PocketScoreboard.first.mode = modes[0];
+    PocketScoreboard.first.character = characters[0];
+    PocketScoreboard.first.flags = 0;
+    PocketScoreboard.first.time = PocketReadWord(PocketCardData + 8) & 0x3fffff;
+    for (i = 1; i < count; ++i)
+    {
+        PocketScore *score = &PocketScoreboard.others[i - 1];
+        memcpy(score->name, names[i], 12);
+        score->mode = modes[i];
+        score->character = characters[i];
+    }
+    return 1;
+}
