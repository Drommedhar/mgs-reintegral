+                    goto retry;
+            PocketPortState[1] = -1;
+            goto finish_error;
+        }
+        selected = PocketWaitForPort();
+        if (!selected)
+            goto retry;
+        if (selected < 0)
+        {
+            rank_800CC70C(0x80000000);
+            PocketResult = 1;
+            return 1;
+        }
+    }
+    else
+    {
+        status = memcard_check(PocketPortState[0]);
+        if (status & 0x01000000)
+            PocketPortState[2] = -1;
+        PocketCardStatus[PocketPortState[0]] = (unsigned char)status;
+        if ((unsigned char)status == 3)
+        {
+            PocketPortState[2] = -1;
+            goto retry;
+        }
+    }
+    status = PocketCardStatus[PocketPortState[0]];
+    if (status == (int)0x80000000)
