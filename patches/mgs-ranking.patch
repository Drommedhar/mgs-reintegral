+
+void rank_800D4CB8(RankWork *work, int index)
+{
+    KCB      *font = &work->kcb[index];
+    RankText *text = &work->text[index];
+    RECT      rect;
+    if (work->clut_x + 21 >= 512)
+    {
+        work->clut_x = 256;
+        work->font_x = 960;
+        work->clut_y = 276;
+        work->font_y = 960;
+    }
+    rect = (RECT){work->font_x, work->clut_x, 64, 21};
+    text->unk[5] = work->font_x;
+    text->unk[6] = work->clut_x;
+    work->clut_x += 21;
+    font_init_kcb(font, &rect, work->font_y, work->clut_y);
+    text->unk[7] = work->font_y;
+    text->unk[8] = work->clut_y;
+    work->clut_y += 21;
+    font_set_kcb(font, -1, -1, 0, 6, 2, 0);
+    font_set_buffer(font, GV_AllocMemory(2, font_get_buffer_size(font)));
+    font_set_color(font, 0, 26425, 0);
+    font_clut_update(font);
+}
+
+void rank_800D4E2C(RankWork *work, int index)
+{
+    RankText *text = &work->text[index];
+    KCB      *font = &work->kcb[index];
+    if (text->string == NULL)
+        return;
+    font_print_string(font, text->string);
+    font_update(font);
+    font_clut_update(font);
+    text->unk[3] = (unsigned char)font->max_width;
+    text->unk[4] = font->max_height - 1;
+    text->unk[1] = 160 - (unsigned char)font->max_width / 2;
+    text->unk[2] = 200 - font->max_height / 2;
+    text->string = NULL;
+    text->num = 1;
+}
+
+void rank_800D4F70(RankWork *work, OT_TYPE *ot)
+{
+    static const signed char shadow_offsets[4][2] = {{-1, 0}, {1, 0}, {0, 1}, {0, -1}};
+    RankText                *text = &work->text[0];
+    SPRT                    *sprite = &text->sprt[GV_Clock];
+    if (text->num != 1)
+        return;
+    setSprt(sprite);
+    setRGB0(sprite, 128, 128, 128);
+    setXY0(sprite, text->unk[1], text->unk[2]);
+    setWH(sprite, text->unk[3], text->unk[4]);
+    setUV0(sprite, 0, text->unk[6]);
+    setClut(sprite, text->unk[7], text->unk[8]);
+    addPrim(ot, sprite);
+    for (int index = 0; index < 4; ++index)
+    {
+        SPRT *shadow = &text->sprt[2 + GV_Clock * 4 + index];
+        *shadow = *sprite;
+        setRGB0(shadow, 0, 0, 0);
+        shadow->x0 += shadow_offsets[index][0];
+        shadow->y0 += shadow_offsets[index][1];
+        addPrim(ot, shadow);
+    }
+    setDrawTPage(&work->draw_mode, 1, 0, 0x1e);
+    addPrim(ot, &work->draw_mode);
+}
+
+void rank_800D51EC(RankWork *work, int index, int color)
+{
+    font_set_color(&work->kcb[index], 0, color, 0);
+    font_clut_update(&work->kcb[index]);
+}
+
+void rank_800D8E64(RankWork *work, int name, POLY_FT4 *packet)
+{
+    DG_TEX *texture = DG_GetTexture(name);
+    (void)work;
+    setUV4(packet, texture->off_x, texture->off_y, texture->off_x + texture->w + 1, texture->off_y, texture->off_x,
+           texture->off_y + texture->h + 1, texture->off_x + texture->w + 1, texture->off_y + texture->h + 1);
+    packet->tpage = texture->tpage;
+    packet->clut = texture->clut;
+}
+
+void rank_800D98D4(RankWork *work, int x, int y, int width, int height, int shade, int mode)
+{
+    static const unsigned char cells[9][2] = {{0, 0}, {2, 0}, {0, 2}, {2, 2}, {1, 0}, {1, 2}, {0, 1}, {2, 1}, {1, 1}};
+    short                      xs[4], ys[4];
+    int                        inset = mode == 1 ? 2 : 0;
+    int                        border = mode == 1 ? 6 : 8;
+    x = (short)x;
+    y = (short)y;
+    for (int index = 0; index < 9; ++index)
+    {
+        work->z_cur[index] = 512;
+        setRGB0(&work->pol_cur[index], shade, shade, shade);
+    }
+    if (mode != 0 && mode != 1)
+        return;
+    xs[0] = x - border;
+    xs[1] = x + inset;
+    xs[2] = x + width - inset;
+    xs[3] = x + width + border;
+    ys[0] = y - border;
+    ys[1] = y + inset;
+    ys[2] = y + height - inset;
+    ys[3] = y + height + border;
+    for (int index = 0; index < 9; ++index)
+    {
+        int column = cells[index][0], row = cells[index][1];
+        setXY4(&work->pol_cur[index], xs[column], ys[row], xs[column + 1], ys[row], xs[column], ys[row + 1],
+               xs[column + 1], ys[row + 1]);
+    }
+}
