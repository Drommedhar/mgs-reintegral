@@ -0,0 +1,89 @@
+#ifndef MGS_S15C_DYNCON_H
+#define MGS_S15C_DYNCON_H
+
+#include "game/game.h"
+
+typedef struct
+{
+    TARGET *target;
+    OBJECT_NO_ROTS objects[2];
+    SVECTOR position;
+    SVECTOR rotation;
+    MATRIX light[2];
+} ContainerEntry;
+
+typedef struct
+{
+    OBJECT_NO_ROTS object;
+    SVECTOR position;
+    SVECTOR rotation;
+    MATRIX light[2];
+} ContainerPanel;
+
+typedef struct
+{
+    OBJECT_NO_ROTS object;
+    MATRIX light[2];
+} ContainerTop;
+
+typedef struct
+{
+    OBJECT_NO_ROTS object;
+    SVECTOR *position;
+    SVECTOR *rotation;
+    SVECTOR step;
+    SVECTOR offset;
+    MATRIX light[2];
+    int state;
+} ContainerFragment;
+
+typedef struct _DynCon
+{
+    GV_ACT actor;
+    int map;
+    ContainerEntry entries[72];
+    int object_active[72][2];
+    ContainerPanel panels[8];
+    int panel_active[8];
+    ContainerTop tops[4];
+    ContainerFragment fragments[4];
+    int field_3594[5][2];
+    HZD_SEG segs[5][2][4];
+    HZD_FLR floors[5][2][2];
+    int field_3BFC[4];
+    SVECTOR field_3C0C[4];
+    int field_3C2C[36];
+    int field_3CBC[36];
+    int field_3D4C[36];
+    int copies;
+    int models[36];
+    int field_3E70[36];
+    int field_3F00[4];
+    int field_3F10[4];
+    int field_3F20[4];
+    int field_3F30[4];
+    SVECTOR field_3F40[4];
+    SVECTOR field_3F60[4];
+    short field_3F80[4][4];
+    HZD_SEG slots[4][2];
+    int field_4020[4];
+    int field_4030[4];
+    int field_4040[4];
+    int field_4050;
+    int save_procs[3];
+    int saved_state[40];
+    char pad_4100[0x60];
+    int field_4160[4];
+} DynCon;
+
+#ifdef MGS_NATIVE
+_Static_assert(sizeof(ContainerEntry) == 156, "Original container entry layout");
+_Static_assert(sizeof(ContainerPanel) == 116, "Original panel layout");
+_Static_assert(sizeof(ContainerFragment) == 128, "Original fragment layout");
+_Static_assert(offsetof(DynCon, field_3594) == 0x3594, "Original dynamic hazard layout");
+_Static_assert(offsetof(DynCon, field_3C0C) == 0x3C0C, "Original container bounds layout");
+_Static_assert(offsetof(DynCon, field_4050) == 0x4050, "Original container mode layout");
+_Static_assert(sizeof(DynCon) == 0x4170, "Original container actor allocation");
+#endif
+
+#endif
diff --git a/source/overlays/s15c/okajima/valcan/dyncon_geo.c b/source/overlays/s15c/okajima/valcan/dyncon_geo.c
new file mode 100644
index 000000000..b7b8552c1
--- /dev/null
+++ b/source/overlays/s15c/okajima/valcan/dyncon_geo.c
@@ -0,0 +1,110 @@
+#ifdef MGS_NATIVE
+#include "libdg/libdg.h"
+#include "libhzd/libhzd.h"
+
+static void MakeCorners(SVECTOR *corners, const SVECTOR *minimum, const SVECTOR *maximum)
+{
+    int i;
+    for (i = 0; i < 8; ++i)
+    {
+        corners[i].vx = (i & 2) ? maximum->vx : minimum->vx;
+        corners[i].vy = (i & 4) ? maximum->vy : minimum->vy;
+        corners[i].vz = ((i + 1) & 2) ? maximum->vz : minimum->vz;
+        corners[i].pad = 0;
+    }
+}
+
+static int IsExtreme(const SVECTOR *candidate, const SVECTOR *current, int side)
+{
+    switch (side)
+    {
+    case 0:
+        return candidate->vx < current->vx ||
+               (candidate->vx == current->vx && candidate->vz < current->vz);
+    case 1:
+        return candidate->vz > current->vz ||
+               (candidate->vz == current->vz && candidate->vx < current->vx);
+    case 2:
+        return candidate->vx > current->vx ||
+               (candidate->vx == current->vx && candidate->vz > current->vz);
+    default:
+        return candidate->vz < current->vz ||
+               (candidate->vz == current->vz && candidate->vx > current->vx);
+    }
+}
+
+static HZD_VEC HazardPoint(SVECTOR position, int height)
+{
+    HZD_VEC point;
+    point.x = position.vx;
+    point.z = position.vz;
+    point.y = position.vy;
+    point.h = height;
+    return point;
+}
+
+static void MakeFloor(HZD_FLR *floor, const SVECTOR *vertices)
+{
+    static const int order[4] = {0, 3, 2, 1};
+    HZD_VEC points[4];
+    int nx, nz, ny, length, i;
+    for (i = 0; i < 4; ++i)
+        points[i] = HazardPoint(vertices[order[i]], 0);
+    floor->b1 = floor->b2 = points[0];
+    for (i = 1; i < 4; ++i)
+    {
+        floor->b1.x = MIN(floor->b1.x, points[i].x);
+        floor->b1.z = MIN(floor->b1.z, points[i].z);
+        floor->b1.y = MIN(floor->b1.y, points[i].y);
+        floor->b2.x = MAX(floor->b2.x, points[i].x);
+        floor->b2.z = MAX(floor->b2.z, points[i].z);
+        floor->b2.y = MAX(floor->b2.y, points[i].y);
+    }
+    nx = ((points[1].y - points[0].y) * (points[2].z - points[1].z) -
+          (points[1].z - points[0].z) * (points[2].y - points[1].y)) >> 16;
+    nz = ((points[1].x - points[0].x) * (points[2].y - points[1].y) -
+          (points[1].y - points[0].y) * (points[2].x - points[1].x)) >> 16;
+    ny = ((points[1].z - points[0].z) * (points[2].x - points[1].x) -
+          (points[1].x - points[0].x) * (points[2].z - points[1].z)) >> 16;
+    length = SquareRoot0(nx * nx + nz * nz + ny * ny);
+    if (length == 0)
+        length = 1;
+    points[0].h = 255 * nx / length;
+    points[1].h = 255 * nz / length;
+    points[2].h = 255 * ny / length;
+    floor->p1 = points[0];
+    floor->p2 = points[1];
+    floor->p3 = points[2];
+    floor->p4 = points[3];
+}
+
+void s15c_dyncon_800D3F24(HZD_SEG *segments, HZD_FLR *floors, MATRIX *matrix,
+                        SVECTOR *minimum, SVECTOR *maximum)
+{
+    static const int edges[4][2] = {{0, 1}, {1, 2}, {3, 2}, {0, 3}};
+    SVECTOR corners[8], lower[4], upper[4];
+    int side, i, index;
+    MakeCorners(corners, minimum, maximum);
+    DG_SetPos(matrix);
+    DG_PutVector(corners, corners, 8);
+    for (side = 0; side < 4; ++side)
+    {
+        index = 0;
+        for (i = 1; i < 8; ++i)
+            if (IsExtreme(&corners[i], &corners[index], side))
+                index = i;
+        lower[side] = upper[side] = corners[index];
+        index &= 3;
+        lower[side].vy = MIN(corners[index].vy, corners[index + 4].vy);
+        upper[side].vy = MAX(corners[index].vy, corners[index + 4].vy);
+    }
+    for (side = 0; side < 4; ++side)
+    {
+        int first = edges[side][0], second = edges[side][1];
+        segments[side].p1 = HazardPoint(lower[first], upper[first].vy - lower[first].vy);
+        segments[side].p2 = HazardPoint(lower[second], upper[second].vy - lower[second].vy);
+    }
+    MakeFloor(&floors[0], lower);
+    MakeFloor(&floors[1], upper);
+}
+#endif
