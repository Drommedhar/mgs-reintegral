diff --git a/source/takabe/mg_demo1.c b/source/takabe/mg_demo1.c
new file mode 100644
index 000000000..24c86dedc
--- /dev/null
+++ b/source/takabe/mg_demo1.c
@@ -0,0 +1,254 @@
+#include "game/game.h"
+#include "libgcl/libgcl.h"
+#include "takabe/thing.h"
+#include "chara/snake/sna_init.h"
+
+extern CONTROL *tenage_ctrls_800BDD30[16];
+extern int      tenage_ctrls_count_800BDD70;
+void            Voicesys_800CE2D0(void);
+void            Voicesys_800CE310(void);
+
+typedef struct
+{
+    GV_ACT         actor;
+    int            map;
+    int            name;
+    int            timer;
+    int            timer2;
+    int            unused[2];
+    int            sound_delay;
+    int            stream_started;
+    int            buttons;
+    int            horizontal;
+    int            vertical;
+    int            heading;
+    int            heading_offset;
+    int            saved_item;
+    int            saved_weapon;
+    CONTROL        control;
+    OBJECT         body;
+    MOTION_CONTROL motion;
+    MOTION_SEGMENT segments[17];
+    SVECTOR        adjust[17];
+    MATRIX         light[2];
+    TARGET        *target;
+    int            procedure;
+} RexDemoWork;
+
+static unsigned char empty_sounds[4] = {136, 137, 138, 0};
+static unsigned char loaded_sounds[4] = {132, 133, 135, 0};
+static SVECTOR       target_size = {500, 500, 500, 0};
+
+_Static_assert(sizeof(RexDemoWork) == 1344, "original REX cinematic actor layout");
+
+static int AnalogAxis(int value)
+{
+    int offset;
+    if (value < 128)
+    {
+        offset = value - 64;
+        return offset > 0 ? 0 : offset * 2;
+    }
+    offset = value - 192;
+    return offset < 0 ? 0 : offset * 2;
+}
+
+static void ReadInput(RexDemoWork *work)
+{
+    unsigned short buttons = GV_PadData[0].status;
+    int            x = 0;
+    int            y = 0;
+    if (GV_PadData[0].analog == 2)
+    {
+        x = AnalogAxis(GV_PadData[0].left_dx);
+        y = AnalogAxis(GV_PadData[0].left_dy);
+    }
+    if (!x && !y)
+    {
+        if (buttons & PAD_LEFT)
+            x = -128;
+        if (buttons & PAD_RIGHT)
+            x = 127;
+        if (buttons & PAD_UP)
+            y = -128;
+        if (buttons & PAD_DOWN)
+            y = 127;
+    }
+    if (GM_PlayerStatus & 1)
+    {
+        unsigned char axis = y + 128;
+        GM_CheckShukanReverse(&buttons);
+        GM_CheckShukanReverseAnalog(&axis);
+        y = axis - 128;
+    }
+    work->buttons = buttons;
+    work->horizontal = x;
+    work->vertical = y;
+}
+
+static void PlayResponse(RexDemoWork *work)
+{
+    int            index = GV_RandU(2);
+    unsigned char *sounds = GM_StingerFlag > 0 ? loaded_sounds : empty_sounds;
+    int            sound = sounds[index];
+    sounds[index] = sounds[3];
+    sounds[3] = sound;
+    GM_SeSet(NULL, sound);
+    work->sound_delay = 60;
+}
+
+static void Begin(RexDemoWork *work)
+{
+    if (work->timer == 20)
+    {
+        GV_PadMask = 61568;
+        GM_PlayerStatus |= 0x20000000;
+    }
+    if (work->timer < 5)
+    {
+        GM_PlayerControl->rot.vy = work->heading;
+        GM_PlayerControl->turn.vy = work->heading;
+        GM_NoisePower = 0;
+        GM_NoiseLength = 0;
+        DG_InvisibleObjs(GM_PlayerBody->objs);
+    }
+    if (work->timer == 3)
+    {
+        GV_PadMask = 0;
+        GM_GameStatus = (GM_GameStatus & 0xe7b5cfff) | 0x08001000;
+        work->saved_weapon = GM_Weapon;
+        GM_Weapon = 4;
+        work->saved_item = GM_Item;
+        GM_Item = -1;
+    }
+}
+
+static void Act(RexDemoWork *work)
+{
+    int pitch;
+    int status;
+    ReadInput(work);
+    ++work->timer;
+    ++work->timer2;
+    pitch = GM_PlayerControl->turn.vx + work->vertical / 4;
+    if (pitch >= -99)
+        pitch = -100;
+    if (pitch < -400)
+        pitch = -400;
+    GM_PlayerControl->turn.vx = pitch;
+    work->heading_offset -= work->horizontal / 4;
+    if (work->heading_offset >= 151)
+        work->heading_offset = 150;
+    if (work->heading_offset < -150)
+        work->heading_offset = -150;
+    GM_PlayerControl->turn.vy = work->heading + work->heading_offset;
+    status = GM_StreamStatus();
+    if (status == 2)
+    {
+        if (GV_PadData[0].release & 0x80)
+        {
+            if (work->sound_delay)
+                --work->sound_delay;
+            else
+            {
+                PlayResponse(work);
+                --work->sound_delay;
+            }
+            goto finish;
+        }
+    }
+    else if (work->timer < 30)
+        Begin(work);
+    else if (!work->stream_started && status == 1)
+    {
+        Voicesys_800CE2D0();
+        work->stream_started = 1;
+        GM_GameStatus &= 0x7fffffff;
+    }
+    else if (work->stream_started == 1 && status == -1 && work->procedure)
+    {
+        GV_PadMask = 0;
+        DG_UnDrawFrameCount = 8;
+        GM_Item = work->saved_item;
+        GM_Weapon = work->saved_weapon;
+        GM_PlayerStatus &= ~0x20000000;
+        GM_GameStatus &= ~0x1000;
+        GCL_ExecProc(work->procedure, NULL);
+        GV_PadData[0].status = 0;
+        GV_PadData[0].press = 0;
+        GV_PadData[0].release = 0;
+        Voicesys_800CE310();
+        GV_DestroyActor(work);
+        return;
+    }
+    if (work->sound_delay)
+        --work->sound_delay;
+finish:
+    DG_GetLightMatrix2(&work->control.mov, work->light);
+    GM_ActMotion(&work->body);
+}
+
+static void Die(RexDemoWork *work)
+{
+    GM_FreeTarget(work->target);
+    GM_FreeObject(&work->body);
+    GM_FreeControl(&work->control);
+}
+
+void *RexNewDemo(int name, int where)
+{
+    int          index;
+    RexDemoWork *work = GV_NewActor(4, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, Act, Die, "mg_demo1.c");
+    if (GCL_GetOption('e'))
+        work->procedure = GCL_StrToInt(GCL_NextStr());
+    GM_PlayerStatus = 0;
+    GV_PadMask = 0;
+    GV_PadData[0].release = 0;
+    GV_PadData[0].press = 0;
+    GM_PlayerStance = 0;
+    GV_PadData[0].status = 0;
+    GM_Camera.first_person = 2;
+    GM_GameStatus |= 0x184a2000;
+    work->heading = THING_Gcl_GetInt('r');
+    GM_InitControl(&work->control, 1, where);
+    GM_ConfigControlHazard(&work->control, 0, -2, 0);
+    if (GCL_GetOption('n'))
+    {
+        GCL_StrToSV(GCL_NextStr(), &work->control.mov.vx);
+        GCL_StrToSV(GCL_NextStr(), &work->control.turn.vx);
+        work->control.rot = work->control.turn;
+    }
+    GM_InitObject(&work->body, 30065, 813, 0);
+    GM_ConfigMotionControl(&work->body, &work->motion, 49865, work->segments, work->segments, &work->control,
+                           work->adjust);
+    GM_ConfigObjectLight(&work->body, work->light);
+    GM_ConfigObjectAction(&work->body, 0, 0, 0);
+    GM_ActMotion(&work->body);
+    work->control.mov.vy += work->body.height;
+    GM_ActControl(&work->control);
+    GM_ActObject(&work->body);
+    work->target = GM_AllocTarget();
+    if (!work->target)
+    {
+        GV_DestroyActor(work);
+        return NULL;
+    }
+    GM_SetTarget(work->target, 4, 2, &target_size);
+    GM_MoveTarget(work->target, &work->control.mov);
+    if (tenage_ctrls_count_800BDD70)
+    {
+        for (index = 0; index < 16; ++index)
+        {
+            if (tenage_ctrls_800BDD30[index])
+                tenage_ctrls_800BDD30[index]->mov.pad = 1;
+        }
+    }
+    GM_NoisePower = 0;
+    GM_NoiseLength = 0;
+    work->map = where;
+    work->name = name;
+    return work;
+}
