+void RexMeshLaserRibbon(SVECTOR *vertices, SVECTOR *near_position, SVECTOR *far_position)
+{
+    SVECTOR position = *far_position;
+    int     x = (near_position->vx - far_position->vx) / 8;
+    int     y = (near_position->vy - far_position->vy) / 8;
+    int     z = (near_position->vz - far_position->vz) / 8;
+    int     index;
+    for (index = 0; index < 9; ++index)
+    {
+        vertices[index] = position;
+        vertices[index + 72] = position;
+        position.vx += x;
+        position.vy += y;
+        position.vz += z;
+    }
+}
