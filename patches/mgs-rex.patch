@@ -0,0 +1,83 @@
+#include "anime/animconv/anime.h"
+#include "game/game.h"
+#include "overlays/s17a/rex_effects.h"
+
+static char      script1[] = {0, 31, 4,  0,  11,   0,  15,   0, 24, 0, 33, 2,  0,  1,   15, 10,  -1, -50, -1, -50, 2, 0,
+                              1, 15, 10, -1, -100, -1, -100, 2, 0,  1, 15, 10, -1, 106, -1, 106, 2,  0,   1,  15,  0, 0};
+static ANIMATION animation1 = {18335, 1, 1, 1, 1, 230, 1, 300, 300, 255, NULL, script1};
+
+static char      script2[] = {0, 16, 1, 0, 5, 2, 0, 1, 8, -16, -16, -16, 10, 3, -24, 3, -24, 2, 0, 1, 15, 0, 0, 0};
+static ANIMATION animation2 = {18335, 1, 1, 1, 1, 230, 1, 1000, 1000, 32, NULL, script2};
+
+static char      script3[] = {0, 8, 1, 0, 5, 12, 0, 60, 2, 0, 1, 13, 15, 0, 0, 0};
+static ANIMATION animation3 = {18335, 1, 1, 1, 1, 500, 1, 200, 200, 255, NULL, script3};
+
+static char      script4[] = {0, 13, 2, 0, 7, 0, 11, 2, 0, 1, 15, 10, -2, 112, -2, 112, 2, 0, 1, 15};
+static ANIMATION animation4 = {18335, 1, 1, 1, 1, 500, 1, 2000, 2000, 64, NULL, script4};
+
+static char      script5[] = {0, 4, 1, 0, 5, 2, 0, 1, 15, 0, 0, 0};
+static ANIMATION animation5 = {18335, 1, 1, 1, 1, 0, 0, 20, 20, 255, NULL, script5};
+
+static char      script6[] = {0,  19, 1,  0, 5, 8, -56, -56, -1,  2,   0,   1,   12,  0,   31,  8,
+                              -6, -6, -8, 2, 0, 1, 13,  15,  109, 103, 114, 101, 120, 108, 122, 114};
+static ANIMATION animation6 = {43469, 1, 1, 1, 1, 230, 1, 0, 0, 255, NULL, script6};
+
+static void *Animate(ANIMATION *animation, SVECTOR *position, unsigned short script)
+{
+    PRESCRIPT preset = {*position, DG_ZeroVector, script, 0};
+    animation->pre_script = &preset;
+    return NewAnime(NULL, 0, animation);
+}
+
+void *RexAnimateMatrix(MATRIX *world)
+{
+    SVECTOR position = {world->t[0], world->t[1], world->t[2], 0};
+    return Animate(&animation1, &position, 1);
+}
+
+void *RexAnimate1(SVECTOR *position, unsigned short script)
+{
+    return Animate(&animation1, position, script);
+}
+
+void *RexAnimate2(SVECTOR *position)
+{
+    return Animate(&animation2, position, 0);
+}
+
+void *RexAnimate3(SVECTOR *position)
+{
+    return Animate(&animation3, position, 0);
+}
+
+void *RexAnimate4(SVECTOR *position, unsigned short script)
+{
+    return Animate(&animation4, position, script);
+}
+
+void *RexAnimate5(SVECTOR *position)
+{
+    return Animate(&animation5, position, 0);
+}
+
+void *RexAnimateParticle(MATRIX *world, short size, unsigned char red, unsigned char green, unsigned char blue,
+                         unsigned char life, unsigned char x, unsigned char y, unsigned char z, char *script)
+{
+    ANIMATION animation = animation6;
+    PRESCRIPT preset = {0};
+    preset.pos.vx = world->t[0];
+    preset.pos.vy = world->t[1];
+    preset.pos.vz = world->t[2];
+    memcpy(script, script6, sizeof(script6));
+    animation.script = script;
+    animation.pre_script = &preset;
+    animation.size_w = animation.size_h = size;
+    script[6] = red;
+    script[7] = green;
+    script[8] = blue;
+    script[14] = life;
+    script[16] = x;
+    script[17] = y;
+    script[18] = z;
+    return NewAnime(NULL, 0, &animation);
+}
diff --git a/source/kojo/rex_particles.c b/source/kojo/rex_particles.c
new file mode 100644
index 000000000..743e34fcd
--- /dev/null
+++ b/source/kojo/rex_particles.c
@@ -0,0 +1,231 @@
+#include "overlays/s17a/rex_particles.h"
+#include "takabe/prim.h"
+
+void RexSetParticleFrame(POLY_FT4 *packet, DG_TEX *texture, int frame, int columns)
+{
+    int x = frame & (columns - 1);
+    int y = frame / columns;
+    int width = texture->w + 1;
+    int height = texture->h + 1;
+    int left = texture->off_x + width * x / columns;
+    int right = texture->off_x + width * (x + 1) / columns - 1;
+    int top = texture->off_y + height * y / 4;
+    int bottom = texture->off_y + height * (y + 1) / 4 - 1;
+    setUV4(packet, left, top, right, top, left, bottom, right, bottom);
+}
+
+static void Emit(RexParticleWork *work)
+{
+    int               index = work->next;
+    SVECTOR          *position = &work->vertices[index];
+    SVECTOR          *speed = &work->speeds[index];
+    RexParticleState *state = &work->states[index];
+    state->life = work->life;
+    state->frame = GV_RandU(16);
+    state->fade = work->kind == REX_DRUM_SMOKE ? 0 : 255;
+    if (work->kind == REX_DRUM_FIRE)
+    {
+        position->vx = (short)work->world.t[0] + GV_RandS(256) / 2;
+        position->vz = (short)work->world.t[2] + GV_RandS(256) / 2;
+        position->pad = 20 * work->life;
+        if (position->pad < 400)
+            position->pad = 400;
+        position->vy = (short)work->world.t[1] + position->pad;
+    }
+    else
+    {
+        DG_SetPos(&work->world);
+        DG_PutVector(&work->offset, position, 1);
+        if (work->kind == REX_LEG_SMOKE)
+        {
+            DG_RotVector(&work->velocity, speed, 1);
+            position->pad = 1300;
+            speed->vx += GV_RandS(32);
+            speed->vy += GV_RandS(32);
+            speed->vz += GV_RandS(32);
+            speed->pad = 15;
+        }
+        else
+        {
+            int spread = work->kind == REX_DRUM_SMOKE ? 8 : 16;
+            position->pad = work->kind == REX_DRUM_SMOKE ? 750 : 1300;
+            speed->vx = GV_RandS(spread);
+            speed->vy = GV_RandS(spread) + (work->kind == REX_DRUM_SMOKE ? 30 : 50);
+            speed->vz = GV_RandS(spread);
+        }
+    }
+    work->delay = work->kind == REX_LEG_SMOKE ? -1 : 12;
+    work->next = (index + 1) & 15;
+}
+
+static void MoveParticle(RexParticleWork *work, SVECTOR *position, SVECTOR *speed)
+{
+    if (work->kind == REX_DRUM_FIRE)
+    {
+        position->pad -= 10;
+        if (position->pad < 400)
+            position->pad = 400;
+        if (position->pad != 400)
+            position->vy -= 10;
+        return;
+    }
+    position->vx += speed->vx;
+    position->vy += speed->vy;
+    position->vz += speed->vz;
+    position->pad += work->kind == REX_LEG_SMOKE ? speed->pad : work->kind == REX_DRUM_SMOKE ? 5 : 15;
+    if (work->kind == REX_LEG_SMOKE && position->vy < 0)
+    {
+        position->vy = 0;
+        speed->vy = GV_RandU(32) + 1;
+        speed->vx = speed->vx / 4 + GV_RandS(128);
+        speed->vz = speed->vz / 4 + GV_RandS(128);
+        speed->pad = 20;
+        position->vx += speed->vx;
+        position->vy += speed->vy;
+        position->vz += speed->vz;
+    }
+}
+
+void RexParticleStep(RexParticleWork *work, int index, POLY_FT4 *packet)
+{
+    RexParticleState *state = &work->states[index];
+    SVECTOR          *position = &work->vertices[index];
+    int               color;
+    int               columns = work->kind == REX_DRUM_FIRE ? 4 : 8;
+    int               factor = work->kind == REX_LEG_SMOKE ? 64 : work->kind == REX_DRUM_FIRE ? 16 : 2;
+    if (state->life == 0)
+    {
+        position->pad = 0;
+        setRGB0(packet, 0, 0, 0);
+        return;
+    }
+    MoveParticle(work, position, &work->speeds[index]);
+    RexSetParticleFrame(packet, work->texture, state->frame, columns);
+    if (++state->frame >= (work->kind == REX_DRUM_FIRE ? 16 : 30))
+        state->frame = 0;
+    color = factor * state->life;
+    if (color >= 256)
+        color = 255;
+    if (work->kind != REX_DRUM_SMOKE && state->fade > 0)
+    {
+        color -= state->fade;
+        if (color < 0)
+            color = 0;
+        state->fade /= 2;
+    }
+    if (work->kind == REX_SMOKE || work->kind == REX_LEG_SMOKE)
+        color /= 4;
+    setRGB0(packet, color, color, color);
+    --state->life;
+}
+
+static void Act(RexParticleWork *work)
+{
+    int       index;
+    int       emit = work->duration > 0 || work->kind == REX_DRUM_SMOKE || work->kind == REX_SMOKE;
+    POLY_FT4 *packets = work->prim->packs[GV_Clock];
+    GM_CurrentMap = work->map;
+    if ((work->flags & 1) || work->kind == REX_LEG_SMOKE)
+        work->world = *work->root;
+    if (emit)
+    {
+        if (work->delay >= 0)
+            --work->delay;
+        else
+            Emit(work);
+    }
+    for (index = 0; index < 16; ++index)
+        RexParticleStep(work, index, &packets[index]);
+    if (work->duration <= 0 && work->life-- == 0)
+    {
+        GV_DestroyActor(work);
+        return;
+    }
+    --work->duration;
+}
+
+static void Die(RexParticleWork *work)
+{
+    if (work->prim)
+    {
+        DG_DequeuePrim(work->prim);
+        DG_FreePrim(work->prim);
+    }
+}
+
+static void *NewParticles(MATRIX *root, SVECTOR *offset, SVECTOR *velocity, int flags, int duration,
+                          RexParticleKind kind)
+{
+    RexParticleWork *work = GV_NewActor(5, sizeof(*work));
+    int              buffer;
+    int              index;
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, Act, Die, "rex_particles.c");
+    work->map = GM_CurrentMap;
+    work->root = root;
+    work->world = *root;
+    work->kind = kind;
+    work->flags = flags;
+    work->duration = duration;
+    work->life = kind == REX_DRUM_FIRE ? 40 : kind == REX_LEG_SMOKE ? 13 : 80;
+    if (offset)
+        work->offset = *offset;
+    if (velocity)
+        work->velocity = *velocity;
+    work->texture = DG_GetTexture(kind == REX_DRUM_FIRE ? 23400 : 20781);
+    work->prim = Takabe_MakeIndividualRect3DPrim(16, work->vertices);
+    if (!work->texture || !work->prim)
+    {
+        GV_DestroyActor(work);
+        return NULL;
+    }
+    work->prim->world = DG_ZeroMatrix;
+    work->prim->raise = kind == REX_DRUM_SMOKE ? 500 : 1000;
+    for (buffer = 0; buffer < 2; ++buffer)
+    {
+        POLY_FT4 *packets = work->prim->packs[buffer];
+        for (index = 0; index < 16; ++index)
+        {
+            POLY_FT4 *packet = &packets[index];
+            setPolyFT4(packet);
+            setSemiTrans(packet, 1);
+            setRGB0(packet, 0, 0, 0);
+            RexSetParticleFrame(packet, work->texture, 0, 4);
+            packet->clut = work->texture->clut;
+            packet->tpage = (kind == REX_DRUM_FIRE || kind == REX_LEG_SMOKE) ? work->texture->tpage | 0x60
+                                                                             : (work->texture->tpage & ~0x60) | 0x40;
+        }
+    }
+    return work;
+}
+
+void *RexNewDrumSmoke(MATRIX *root, int flags, int duration)
+{
+    return NewParticles(root, NULL, NULL, flags, duration, REX_DRUM_SMOKE);
+}
+
+void *RexNewDrumSmokeAt(MATRIX *root, SVECTOR *offset, int flags, int duration)
+{
