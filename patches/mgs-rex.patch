index 000000000..a1f40f0a5
--- /dev/null
+++ b/source/kojo/mg_laser.c
@@ -0,0 +1,312 @@
+#include "game/game.h"
+#include "gtemac.h"
+#include "takabe/thing.h"
+#include "anime/animconv/anime.h"
+#include "overlays/s17a/rex_effects.h"
+
+typedef struct
+{
+    GV_ACT           actor;
+    int              map;
+    int              unused[9];
+    TARGET           damage;
+    MATRIX           unused_light[2];
+    MATRIX          *root;
+    SVECTOR          start;
+    SVECTOR          end;
+    int              life;
+    TARGET           push;
+    int              sound_timer;
+    DG_PRIM         *flare;
+    DG_PRIM         *sparks;
+    int              brightness;
+    int              next_spark;
+    int              spark_lives[8];
+    SVECTOR          spark_positions[8];
+    OBJECT_NO_ROTS   body;
+    MATRIX           light[2];
+    int              ring;
+    RexLaserGeometry geometry;
+    int              unused_tail;
+} RexLaser;
+
+_Static_assert(sizeof(RexLaser) == 2752, "Original REX weapon laser layout");
+_Static_assert(offsetof(RexLaser, root) == 208, "Original laser root offset");
+_Static_assert(offsetof(RexLaser, geometry) == 524, "Original laser geometry offset");
+
+extern int RexData_800E5E30;
+
+static struct
+{
+    DG_DEF definition;
+    DG_MDL model;
+} laser_model = {.definition = {.n_models = 1,
+                                .n_x_models = 1,
+                                .lx = -32000,
+                                .ly = -32000,
+                                .lz = -32000,
+                                .ux = 32000,
+                                .uy = 32000,
+                                .uz = 32000},
+                 .model = {.flag = 1027,
+                           .n_faces = 56,
+                           .lx = -32000,
+                           .ly = -32000,
+                           .lz = -32000,
+                           .ux = 32000,
+                           .uy = 32000,
+                           .uz = 32000,
+                           .parent = -1,
+                           .extend = -1,
+                           .n_verts = 72,
+                           .n_norms = 8}};
+
+static void TransformRoot(MATRIX *root, MATRIX *world)
+{
+    static SVECTOR offset = {0, -500, 1800, 0};
+    static SVECTOR rotation = {-854, 0, 0, 0};
+    MATRIX         rotated;
+    DG_SetPos(root);
+    DG_MovePos(&offset);
+    RotMatrix_gte(&rotation, &rotated);
+    DG_MulRotMatrix0(&rotated, world);
+    SetRotMatrix(world);
+    ReadRotMatrix(world);
+}
+
+int RexLaserClip(SVECTOR *start, VECTOR *destination, SVECTOR *result, int length)
+{
+    int coordinates[3] = {destination->vx, destination->vy, destination->vz};
+    int origin[3] = {start->vx, start->vy, start->vz};
+    int axis, other, clipped = 0;
+    for (axis = 0; axis < 3; ++axis)
+    {
+        int old = coordinates[axis];
+        int boundary, numerator, denominator;
+        if (old >= -32752 && old < 32752)
+            continue;
+        boundary = old < -32752 ? -32752 : 32751;
+        numerator = (boundary - origin[axis]) >> 4;
+        denominator = (old - origin[axis]) >> 4;
+        coordinates[axis] = boundary;
+        for (other = 0; other < 3; ++other)
+            if (other != axis)
+                coordinates[other] =
+                    (int)((unsigned int)(coordinates[other] - origin[other]) * (unsigned int)numerator) / denominator +
+                    origin[other];
+        clipped = 1;
+    }
+    if (clipped || length == -1)
+    {
+        VECTOR delta = {(coordinates[0] - origin[0]) >> 4, (coordinates[1] - origin[1]) >> 4,
+                        (coordinates[2] - origin[2]) >> 4, 0};
+        Square0(&delta, &delta);
+        length = 16 * SquareRoot0(delta.vx + delta.vy + delta.vz);
+    }
+    result->vx = coordinates[0];
+    result->vy = coordinates[1];
+    result->vz = coordinates[2];
+    return length;
+}
+
+static void InitPackets(DG_PRIM *prim, int count, int blend)
+{
+    DG_TEX *texture = DG_GetTexture(49129);
+    int     buffer, index;
+    for (buffer = 0; buffer < 2; ++buffer)
+        for (index = 0; index < count; ++index)
+        {
+            POLY_FT4 *packet = &((POLY_FT4 *)prim->packs[buffer])[index];
+            setPolyFT4(packet);
+            setSemiTrans(packet, 1);
+            setRGB0(packet, 0, 0, 0);
+            setUVWH(packet, texture->off_x, texture->off_y, texture->w, texture->h);
+            packet->tpage = texture->tpage | blend;
+            packet->clut = texture->clut;
+        }
+    prim->raise = 1000;
+}
+
+void RexLaserUpdateSparks(RexLaser *work, int emit)
+{
+    POLY_FT4 *packet = work->sparks->packs[GV_Clock];
+    int       i;
+    if (emit)
+    {
+        work->spark_positions[work->next_spark] = work->end;
+        work->spark_lives[work->next_spark] = 8;
+        if (++work->next_spark >= 8)
+            work->next_spark = 0;
+    }
+    for (i = 0; i < 8; ++i)
+    {
+        int color = 0;
+        if (work->spark_lives[i])
+        {
+            color = 255 * work->spark_lives[i] / 8;
+            --work->spark_lives[i];
+        }
+        setRGB0(&packet[i], color, color, color);
+    }
+}
+
+static void Trace(RexLaser *work, MAP *map, MATRIX *world)
+{
+    SVECTOR start, end, clipped_end, hit, step;
+    SVECTOR direction = {0, -15000, 0, 0};
+    SVECTOR segment = {0, -20000, 0, 0};
+    VECTOR  destination;
+    int     length, remaining, distance, target_hit = 0;
+    TransformRoot(work->root, world);
+    work->start = (SVECTOR){world->t[0], world->t[1], world->t[2], 0};
+    start = work->start;
+    DG_SetPos(world);
+    ApplyRotMatrix(&direction, &destination);
+    destination.vx = 2 * destination.vx + start.vx;
+    destination.vy = 2 * destination.vy + start.vy;
+    destination.vz = 2 * destination.vz + start.vz;
+    length = RexLaserClip(&start, &destination, &clipped_end, 30000);
+    remaining = length / 20000 + 1;
+    DG_RotVector(&segment, &step, 1);
+    distance = 20000;
+    do
+    {
+        if (length >= distance)
+            GV_AddVec3(&start, &step, &end);
+        else
+            end = clipped_end;
+        if (HZD_OnlineHazardCheck(map->hzd, &start, &end, 15, 14))
+        {
+            HZD_GetOnlinePoint(&end);
+            remaining = 1;
+        }
+        if (!target_hit)
+        {
+            if (GM_OnlineTargetCheck(&start, &end, map->index, &hit, work->damage.side))
+                target_hit = 1;
+            else
+                hit = end;
+        }
+        start = end;
+        distance += 20000;
+    } while (--remaining > 0);
+    work->end = end;
+    DG_SetPos(world);
+    GM_MoveTarget(&work->damage, &hit);
+    GM_PowerTarget(&work->damage);
+    AN_RecoilSmoke(&work->end);
+    if (--work->sound_timer <= 0)
+    {
+        GM_SeSetMode(&work->start, 183, 1);
+        work->sound_timer = 7;
+    }
+}
+
+static void Act(RexLaser *work)
+{
+    static unsigned short messages[] = {24203, 12835};
+    int                   message = THING_Msg_CheckMessage(15177, 2, messages);
+    MATRIX                world;
+    SVECTOR              *vertices;
+    int                   buffer;
+    if (message == 1)
+    {
+        GV_DestroyActor(work);
+        return;
+    }
+    if (message == 0)
+        work->life = -1;
+    GM_CurrentMap = work->map;
+    if (work->life >= 0)
+        Trace(work, GM_GetMap(work->map), &world);
+    work->ring = (work->ring + 7) & 7;
+    vertices = &work->geometry.vertices[9 * work->ring];
+    work->body.objs->def->models[0].verts = vertices;
+    RexMeshLaserRibbon(vertices, &work->start, &work->end);
+    work->brightness = work->life <= 0 ? GV_NearExp2(work->brightness, 0) : GV_NearSpeed(work->brightness, 128, 20);
+    RexLaserUpdateSparks(work, work->life > 0);
+    for (buffer = 0; buffer < 2; ++buffer)
+    {
+        POLY_FT4 *packet = work->flare->packs[buffer];
+        setRGB0(packet, work->brightness, work->brightness, work->brightness);
+    }
+    if (abs(GM_PlayerPosition.vx - work->end.vx) < 5000 && abs(GM_PlayerPosition.vz - work->end.vz) < 5000)
+        RexData_800E5E30 = 45;
+    work->push.center = work->end;
+    GM_PushTarget(&work->push);
+    if (--work->life < -8)
+        GV_DestroyActor(work);
+}
+
+static void Die(RexLaser *work)
+{
+    GM_FreeObject((OBJECT *)&work->body);
+    if (work->flare)
+    {
+        DG_DequeuePrim(work->flare);
+        DG_FreePrim(work->flare);
+    }
+    if (work->sparks)
+    {
+        DG_DequeuePrim(work->sparks);
+        DG_FreePrim(work->sparks);
+    }
+}
+
+static int Resources(RexLaser *work, MATRIX *root, int side, int power)
+{
+    static RECT    flare_rect = {300, 300, 600, 600};
+    static RECT    spark_rect = {500, 500, 1000, 1000};
+    static SVECTOR damage_size = {100, 500, 100, 0};
+    static SVECTOR push_size = {300, 1500, 300, 0};
+    MATRIX         world;
+    SVECTOR        position;
+    TransformRoot(root, &world);
+    position = (SVECTOR){world.t[0], world.t[1], world.t[2], 0};
+    RexInitLaserGeometry(&work->geometry, &position, &laser_model.model);
+    work->body.flag = 349;
+    work->body.light = work->light;
+    work->body.map_name = GM_CurrentMap;
+    work->body.objs = DG_MakeObjs(&laser_model.definition, 349, 0);
+    if (!work->body.objs)
+        return -1;
+    work->light[0].m[0][0] = 4096;
+    work->light[1].m[0][0] = work->light[1].m[1][0] = work->light[1].m[2][0] = 2048;
+    DG_QueueObjs(work->body.objs);
+    work->body.objs->group_id = work->body.map_name;
+    work->body.objs->world = DG_ZeroMatrix;
+    work->body.objs->light = work->light;
+    work->body.objs->objs[0].raise = 1000;
+    work->flare = GM_MakePrim(1042, 1, &work->start, &flare_rect);
+    if (!work->flare)
+        return -1;
+    InitPackets(work->flare, 1, 0);
+    work->sparks = GM_MakePrim(1042, 8, work->spark_positions, &spark_rect);
+    if (!work->sparks)
+        return -1;
+    InitPackets(work->sparks, 8, 0x60);
+    work->sparks->world = DG_ZeroMatrix;
+    GM_SetTarget(&work->damage, 4, side, &damage_size);
+    GM_SetPowerTarget(&work->damage, 0, -1, power, 0, &DG_ZeroVector);
+    GM_SetTarget(&work->push, 8, 1, &push_size);
+    work->root = root;
+    work->map = GM_CurrentMap;
+    GM_SeSetMode(&work->start, 182, 1);
+    work->sound_timer = 10;
+    return 0;
+}
+
+void *RexNewWeaponLaser(MATRIX *root, int side, int power, int duration)
+{
+    RexLaser *work = GV_NewActor(5, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, Act, Die, "mg_laser.c");
+    if (Resources(work, root, side, power) < 0)
+    {
+        GV_DestroyActor(work);
+        return NULL;
+    }
+    work->life = duration;
+    return work;
+}
