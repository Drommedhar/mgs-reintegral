diff --git a/source/kojo/spark2l.c b/source/kojo/spark2l.c
new file mode 100644
index 000000000..b641c6f7e
--- /dev/null
+++ b/source/kojo/spark2l.c
@@ -0,0 +1,130 @@
+#include "game/game.h"
+#include "gtemac.h"
+#include <stddef.h>
+
+typedef struct
+{
+    GV_ACT   actor;
+    int      map;
+    DG_PRIM *prim;
+    MATRIX   world;
+    SVECTOR  velocities[32];
+    SVECTOR  vertices[64];
+    SVECTOR  light_position;
+    char     unused[64];
+    SVECTOR  position;
+    int      time;
+} RexSparks;
+
+typedef struct
+{
+    DR_TPAGE tpage;
+    CVECTOR  color;
+    short    x0, y0, x1, y1;
+} SparkPacket;
+
+void s03e_spark2_800CA1CC(SVECTOR *velocity, SVECTOR *vertices, MATRIX *world, int count);
+void s03e_spark2_800CA2D4(SVECTOR *velocity, SVECTOR *vertices, int count);
+
+_Static_assert(sizeof(RexSparks) == 924, "Original REX spark actor layout");
+
+static void Directions(void)
+{
+    MATRIX  *rotation = (MATRIX *)SCRPAD_ADDR;
+    SVECTOR *vector = (SVECTOR *)(SCRPAD_ADDR + 0x20);
+    SVECTOR *angles = (SVECTOR *)(SCRPAD_ADDR + 0x28);
+    SVECTOR *output = (SVECTOR *)(SCRPAD_ADDR + 0x30);
+    int      i;
+    *vector = DG_ZeroVector;
+    angles->vz = 0;
+    for (i = 0; i < 32; ++i)
+    {
+        angles->vx = GV_RandS(256);
+        angles->vy = GV_RandS(256);
+        RotMatrixYXZ_gte(angles, rotation);
+        DG_SetPos(rotation);
+        vector->vz = GV_RandU(512) + 64;
+        DG_RotVector(vector, &output[i], 1);
+    }
+}
+
+static void Act(RexSparks *work)
+{
+    SparkPacket *packets;
+    int          old_time, brightness, i;
+    GM_CurrentMap = work->map;
+    if (work->time == 8)
+        GM_SeSet(&work->position, 59);
+    old_time = work->time;
+    if (--work->time <= 0)
+    {
+        GV_DestroyActor(work);
+        return;
+    }
+    s03e_spark2_800CA2D4(work->velocities, work->vertices, 32);
+    brightness = work->time * 16 + 50;
+    if (brightness > 255)
+        brightness = 255;
+    packets = work->prim->packs[GV_Clock];
+    for (i = 0; i < 32; ++i)
+    {
+        packets[i].color.r = brightness;
+        packets[i].color.g = brightness / 2;
+        packets[i].color.b = brightness / 2;
+    }
+    brightness = (old_time - 29) * 512;
+    if (brightness > 0)
+        DG_SetTmpLight(&work->light_position, brightness, 1000);
+    work->world.t[1] -= 16;
+    DG_SetPos(&work->world);
+    DG_PutPrim(work->prim);
+}
+
+static void Die(RexSparks *work)
+{
+    GM_FreePrim(work->prim);
+}
+
+static int Resources(RexSparks *work, MATRIX *world)
+{
+    SVECTOR light_offset = {0, 0, 500, 0};
+    int     buffer, i;
+    work->map = GM_CurrentMap;
+    Directions();
+    s03e_spark2_800CA1CC(work->velocities, work->vertices, world, 32);
+    DG_SetFreePrimParam(sizeof(SparkPacket), 2, offsetof(SparkPacket, x0), 4);
+    work->prim = GM_MakePrim(DG_PRIM_FREE, 32, work->vertices, NULL);
+    if (!work->prim)
+        return -1;
+    DG_SetPos(world);
+    DG_PutPrim(work->prim);
+    DG_PutVector(&light_offset, &work->light_position, 1);
+    for (buffer = 0; buffer < 2; ++buffer)
+        for (i = 0; i < 32; ++i)
+        {
+            SparkPacket *packet = &((SparkPacket *)work->prim->packs[buffer])[i];
+            setlen(&packet->tpage, 4);
+            packet->tpage.code[0] = _get_mode(0, 1, getTPage(0, 1, 0, 0));
+            LSTORE(0x428080FF, &packet->color);
+        }
+    work->world = DG_ZeroMatrix;
+    for (i = 0; i < 3; ++i)
+        work->world.t[i] = world->t[i];
+    work->position = (SVECTOR){world->t[0], world->t[1], world->t[2], 0};
+    work->time = 8;
+    return 0;
+}
+
+void *RexNewSparks(MATRIX *world)
+{
+    RexSparks *work = GV_NewActor(5, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(work, Act, Die, "spark2l.c");
+    if (Resources(work, world) < 0)
+    {
+        GV_DestroyActor(work);
+        return NULL;
+    }
+    return work;
+}
