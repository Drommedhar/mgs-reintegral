diff --git a/source/kojo/bloodhzd.c b/source/kojo/bloodhzd.c
new file mode 100644
index 000000000..896fe877a
--- /dev/null
+++ b/source/kojo/bloodhzd.c
@@ -0,0 +1,127 @@
+#include "game/game.h"
+#include <stdlib.h>
+
+typedef struct
+{
+    GV_ACT   actor;
+    int      map;
+    DG_PRIM *prims[5];
+    SVECTOR  vertices[20];
+} BloodHazard;
+
+void sub_8007EF34(SVECTOR *position, SVECTOR *rotation, MATRIX *world);
+
+static void Act(BloodHazard *work)
+{
+    GM_CurrentMap = work->map;
+}
+
+static void Die(BloodHazard *work)
+{
+    int i;
+    for (i = 0; i < 5; ++i)
+        if (work->prims[i])
+        {
+            DG_DequeuePrim(work->prims[i]);
+            DG_FreePrim(work->prims[i]);
+        }
+}
+
+static DG_TEX *SelectTexture(int x, int y, int width, int height, DG_TEX *previous)
+{
+    static const char *names[] = {"chi_02", "chi_03", "chi_04", "chi_05"};
+    if (x / (width / 3) == 1 && y / (height / 3) == 1)
+        return DG_GetTexture(GV_StrCode("chi_01"));
+    x /= width >> 1;
+    y /= height >> 1;
+    if (x < 0 || x > 1 || y < 0 || y > 1)
+        return previous;
+    return DG_GetTexture(GV_StrCode(names[x + 2 * y]));
+}
+
+static void HazardNormal(SVECTOR *normal)
+{
+    void *hazard = HZD_GetOnlineHazard();
+    if (HZD_HAZARD_IS_WALL(hazard))
+    {
+        HZD_SEG *wall = HZD_HAZARD_POINTER(hazard);
+        normal->vx = -((wall->p1.z - wall->p2.z) * -wall->p1.h);
+        normal->vy = 0;
+        normal->vz = (wall->p1.x - wall->p2.x) * -wall->p1.h;
+    }
+    else
+    {
+        HZD_FLR *floor = HZD_HAZARD_POINTER(hazard);
+        normal->vx = (floor->p2.y - floor->p3.y) * (floor->p1.z - floor->p2.z) -
+                     (floor->p2.z - floor->p3.z) * (floor->p1.y - floor->p2.y);
+        normal->vy = (floor->p2.z - floor->p3.z) * (floor->p1.x - floor->p2.x) -
+                     (floor->p2.x - floor->p3.x) * (floor->p1.z - floor->p2.z);
+        normal->vz = (floor->p2.x - floor->p3.x) * (floor->p1.y - floor->p2.y) -
+                     (floor->p2.y - floor->p3.y) * (floor->p1.x - floor->p2.x);
+    }
+}
+
+static void Project(BloodHazard *work, int index, SVECTOR *from, SVECTOR *rotation, int size, short distance)
+{
+    SVECTOR  to = {0, 0, distance, 0};
+    SVECTOR *vertices = &work->vertices[index * 4];
+    MAP     *map = GM_GetMap(work->map);
+    DG_SetPos2(&DG_ZeroVector, rotation);
+    DG_PutVector(&to, &to, 1);
+    to.vx += from->vx;
+    to.vy += from->vy;
+    to.vz += from->vz;
+    if (!HZD_OnlineHazardCheck(map->hzd, from, &to, 15, 0))
+        return;
+    HazardNormal(&to);
+    rotation->vx = -ratan2(to.vy, SquareRoot0(to.vx * to.vx + to.vz * to.vz));
+    rotation->vy = ratan2(to.vx, to.vz);
+    rotation->vz = 0;
+    vertices[0] = (SVECTOR){-(size >> 1), -(size >> 1), 0, 0};
+    vertices[1] = (SVECTOR){-(size >> 1), size >> 1, 0, 0};
+    vertices[2] = (SVECTOR){size >> 1, -(size >> 1), 0, 0};
+    vertices[3] = (SVECTOR){size >> 1, size >> 1, 0, 0};
+    HZD_GetOnlinePoint(&to);
+    DG_SetPos2(&to, rotation);
+    DG_PutVector(vertices, vertices, 4);
+}
+
+void *RexNewBloodHazard(MATRIX *world, int width, int height, int size, short distance)
+{
+    BloodHazard *work = GV_NewActor(5, sizeof(*work));
+    SVECTOR      from, base_rotation, rotation;
+    DG_TEX      *texture = NULL;
+    int          i, buffer;
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, Act, Die, "bloodhzd.c");
+    work->map = GM_CurrentMap;
+    sub_8007EF34(&from, &base_rotation, world);
+    for (i = 0; i < 5; ++i)
+    {
+        rotation.vx = rand() % width;
+        rotation.vy = rand() % height;
+        work->prims[i] = GM_MakePrim(18, 1, &work->vertices[i * 4], NULL);
+        texture = SelectTexture(rotation.vx, rotation.vy, width, height, texture);
+        if (!work->prims[i] || !texture)
+        {
+            GV_DestroyActor(work);
+            return NULL;
+        }
+        for (buffer = 0; buffer < 2; ++buffer)
+        {
+            POLY_FT4 *packet = work->prims[i]->packs[buffer];
+            setPolyFT4(packet);
+            setSemiTrans(packet, 1);
+            setUVWH(packet, texture->off_x, texture->off_y, texture->w, texture->h);
+            packet->tpage = texture->tpage | 0x40;
+            packet->clut = texture->clut;
+            setRGB0(packet, 0, 255, 255);
+        }
+        rotation.vx += base_rotation.vx - (width >> 1);
+        rotation.vy += base_rotation.vy - (height >> 1);
+        rotation.vz = base_rotation.vz;
+        Project(work, i, &from, &rotation, size, distance);
+    }
+    return work;
+}
diff --git a/source/kojo/drum2.c b/source/kojo/drum2.c
new file mode 100644
index 000000000..213594bcf
--- /dev/null
+++ b/source/kojo/drum2.c
@@ -0,0 +1,150 @@
+#include "game/game.h"
+#include "libgcl/libgcl.h"
+#include "takabe/thing.h"
+#include "bullet/blast.h"
+#include "overlays/s17a/rex_particles.h"
+
+extern BLAST_DATA blast_data_8009F4B8[8];
+
+typedef struct
+{
+    GV_ACT  actor;
+    int     map;
+    CONTROL control;
+    OBJECT  body;
+    MATRIX  light[2];
+    SVECTOR size;
+    TARGET *target;
+    int     unused[12];
+    int     original_height;
+    int     radius;
+    SVECTOR minimum;
+    SVECTOR maximum;
+    int     procedure;
+} RexDrum;
+
+_Static_assert(sizeof(RexDrum) == 540, "Original REX drum layout");
+
+static void Explode(RexDrum *work)
+{
+    static SVECTOR offsets[] = {{-875, 1000, 0, 0}, {875, 1000, 0, 0}};
+    MATRIX         world;
+    int            i;
+    if (work->procedure)
+        GCL_ExecProc(work->procedure, NULL);
+    for (i = 0; i < 2; ++i)
+    {
+        DG_SetPos(&work->body.objs->world);
+        DG_MovePos(&offsets[i]);
+        ReadRotMatrix(&world);
+        NewBlast(&world, &blast_data_8009F4B8[0]);
+        world.t[1] = 0;
+        RexNewDrumSmoke(&world, 0, 150);
+        RexNewDrumFire(&world, 0, 100);
+    }
+    GV_DestroyActor(work);
+}
+
+static void Act(RexDrum *work)
+{
+    TARGET *target = work->target;
+    GV_MSG *message;
+    GM_CurrentMap = work->map;
+    if (target->damaged & 12)
+    {
+        if (target->vital < 0 || target->a_mode == 2 || (target->damaged & 8))
+            Explode(work);
+        target->damaged &= ~12;
+    }
+    GM_ActControl(&work->control);
+    GM_ActObject2(&work->body);
+    GM_MoveTarget(target, &work->control.mov);
+    GM_PushTarget(target);
+    message = work->control.msg;
+    if (message && message->message_len && message->message[0] == 50075)
+    {
+        target->vital = -1;
+        target->a_mode = 2;
+        target->damaged |= 4;
+    }
+}
+
+static void Die(RexDrum *work)
+{
+    GM_FreeControl(&work->control);
+    if (work->body.objs)
+        DG_FreePreshade(work->body.objs);
+    GM_FreeObject(&work->body);
+    GM_FreeTarget(work->target);
+}
+
+static void GetBounds(DG_DEF *definition, SVECTOR *minimum, SVECTOR *maximum)
+{
+    int i;
+    *minimum = (SVECTOR){32767, 32767, 32767, 0};
+    *maximum = (SVECTOR){-32768, -32768, -32768, 0};
+    for (i = 0; i < definition->n_models; ++i)
+    {
+        DG_MDL *model = &definition->models[i];
+        if (model->lx < minimum->vx)
+            minimum->vx = model->lx;
+        if (model->ly < minimum->vy)
+            minimum->vy = model->ly;
+        if (model->lz < minimum->vz)
+            minimum->vz = model->lz;
+        if (model->ux > maximum->vx)
+            maximum->vx = model->ux;
+        if (model->uy > maximum->vy)
+            maximum->vy = model->uy;
+        if (model->uz > maximum->vz)
+            maximum->vz = model->uz;
+    }
+}
+
+static int Resources(RexDrum *work, int name, int where)
+{
+    CONTROL *control = &work->control;
+    char    *position, *rotation;
+    if (GM_InitControl(control, name, where) < 0)
+        return -1;
+    GM_ConfigControlHazard(control, -1, -2, -1);
+    GM_ConfigControlInterp(control, 0);
+    position = GCL_GetOption('p');
+    rotation = GCL_GetOption('d');
+    GM_ConfigControlString(control, position, rotation);
+    work->procedure = THING_Gcl_GetInt('e');
+    work->radius = THING_Gcl_GetIntDefault('r', 500);
+    GM_InitObject(&work->body, THING_Gcl_GetInt('m'), 87, 0);
+    if (!work->body.objs)
+        return -1;
+    DG_SetPos2(&control->mov, &control->rot);
+    DG_PutObjs(work->body.objs);
+    DG_MakePreshade(work->body.objs, control->map->lit->lights, control->map->lit->n_lights);
+    GetBounds(work->body.objs->def, &work->minimum, &work->maximum);
+    work->target = GM_AllocTarget();
+    if (!work->target)
+        return -1;
+    work->size = (SVECTOR){(work->maximum.vx - work->minimum.vx) / 4, (work->maximum.vy - work->minimum.vy) / 4,
+                           (work->maximum.vz - work->minimum.vz) / 4, 0};
+    GM_SetTarget(work->target, 28, 0, &work->size);
+    GM_SetPowerTarget(work->target, 1, -1, 20, 0, &DG_ZeroVector);
+    work->original_height = control->mov.vy;
+    control->mov.vy -= work->minimum.vy;
+    GM_MoveTarget(work->target, &control->mov);
+    work->map = where;
+    return 0;
+}
+
+void *RexNewDrum(int name, int where)
+{
+    RexDrum *work = GV_NewActor(5, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(work, Act, Die, "drum2.c");
+    if (Resources(work, name, where) < 0)
+    {
+        GV_DestroyActor(work);
+        return NULL;
+    }
+    return work;
+}
diff --git a/source/kojo/hmissile.c b/source/kojo/hmissile.c
new file mode 100644
index 000000000..9c65c1dc9
--- /dev/null
+++ b/source/kojo/hmissile.c
@@ -0,0 +1,239 @@
+#include "overlays/s17a/rex_native.h"
+#include "overlays/s17a/rex_effects.h"
+#include "bullet/blast.h"
+#include "takabe/prim.h"
+#include "takabe/windcrcl.h"
+
+extern BLAST_DATA blast_data_8009F4B8[8];
+static SVECTOR    missile_bounds[2] = {{15000, 32000, 24000, 0}, {-15000, 4000, -24000, 0}};
+static SVECTOR    missile_target_size = {1000, 1500, 1000, 0};
+
+_Static_assert(sizeof(RexMissileWork) == 952, "original REX missile actor layout");
+
+void RexMissileTrail(RexMissileWork *work, int emit)
+{
+    int       index;
+    POLY_FT4 *packets = work->prim->packs[GV_Clock];
+    for (index = 0; index < 32; ++index)
+    {
+        SVECTOR *position = &work->trail[index];
+        SVECTOR *velocity = &work->trail_speeds[index];
+        DVECTOR *state = &work->trail_states[index];
+        if (state->vx)
+        {
+            position->pad += 25;
+            position->vx += velocity->vx;
+            position->vy += velocity->vy;
+            position->vz += velocity->vz;
+            RexSetParticleFrame(&packets[index], work->texture, state->vy, 8);
+            if (++state->vy >= 30)
+                state->vy = 0;
+            setRGB0(&packets[index], 8 * state->vx, 8 * state->vx, 8 * state->vx);
+            --state->vx;
+        }
+        else
+        {
+            position->pad = 0;
+            setRGB0(&packets[index], 0, 0, 0);
+        }
+    }
+    if (emit)
+    {
+        index = work->next;
+        work->trail_states[index].vx = 31;
+        work->trail_states[index].vy = GV_RandU(16);
+        work->trail[index] = work->position;
+        work->trail[index].pad = 200;
+        work->trail_speeds[index].vx = GV_RandS(16);
+        work->trail_speeds[index].vy = GV_RandS(16);
+        work->trail_speeds[index].vz = GV_RandS(16);
+        work->next = (index + 1) & 31;
+    }
+}
+
+static int CheckCollision(RexMissileWork *work, MAP *map)
+{
+    SVECTOR from = work->position;
+    SVECTOR to;
+    int     inside;
+    GV_AddVec3(&from, &work->velocity, &to);
+    inside = from.vx < missile_bounds[0].vx && from.vy < missile_bounds[0].vy && from.vz < missile_bounds[0].vz &&
+             from.vx > missile_bounds[1].vx && from.vy > missile_bounds[1].vy && from.vz > missile_bounds[1].vz;
+    if (!inside)
+    {
+        if (HZD_OnlineHazardCheck(map->hzd, &from, &to, 15, 8))
+        {
+            HZD_GetOnlinePoint(&work->position);
+            return 1;
+        }
+        if (GM_OnlineTargetCheck(&from, &to, map->index, &work->position, work->side))
+            return 2;
+    }
+    work->position = to;
+    return 0;
+}
+
+static void Steer(RexMissileWork *work)
+{
+    MATRIX  relative = work->world;
+    MATRIX  rotation;
+    VECTOR  delta;
+    VECTOR  square;
+    int     yaw;
+    int     pitch;
+    int     timer;
+    SVECTOR direction = {0, 0, 0, 0};
+    DG_GetLightMatrix2(&work->position, work->light);
+    direction.vz = (short)work->speed + 50 * rsin(work->phase) / 4096;
+    DG_RotVector(&direction, &work->velocity, 1);
+    work->velocity.vy -= 20;
+    work->speed = GV_NearSpeed(work->speed, 500, 10);
+    if (!(GM_GameStatus & 1))
+    {
+        work->aim.vx = GM_PlayerPosition.vx >> 2;
+        work->aim.vy = GM_PlayerPosition.vy >> 2;
+        work->aim.vz = GM_PlayerPosition.vz >> 2;
+    }
+    relative.t[0] >>= 2;
+    relative.t[1] >>= 2;
+    relative.t[2] >>= 2;
+    RexInverseTransform(&relative, &work->aim, &delta);
+    Square0(&delta, &square);
+    yaw = ratan2(delta.vx, delta.vz) & 4095;
+    pitch = ratan2(-delta.vy, SquareRoot0(square.vx + square.vz)) & 4095;
+    if (yaw >= 2048)
+        yaw -= 4096;
+    if (pitch >= 2048)
+        pitch -= 4096;
+    work->turn.vy = GV_NearSpeed(work->turn.vy, yaw, work->turn_speed);
+    work->turn.vx = GV_NearSpeed(work->turn.vx, pitch, work->turn_speed);
+    RotMatrixYXZ_gte(&work->turn, &rotation);
+    MulMatrix(&work->world, &rotation);
+    work->turn.vx = 0;
+    work->turn.vy = 0;
+    timer = work->timer++;
+    if (timer >= 10)
+        work->turn_speed = GV_NearSpeed(work->turn_speed, timer < 40 ? 25 : 0, timer < 40 ? 4 : 1);
+    if (++work->sound_timer > 0)
+        work->sound_timer = -90000;
+    if (!work->sound_timer)
+        GM_SeSetMode(&work->position, 187, 1);
+    work->phase += 50;
+    if (abs(GM_PlayerPosition.vx - work->position.vx) < 12000 && abs(GM_PlayerPosition.vz - work->position.vz) < 12000)
+        RexData_800E5E30 = 45;
+}
+
+static void Act(RexMissileWork *work)
+{
+    MAP *map;
+    int  collision;
+    GM_CurrentMap = work->map;
+    map = GM_GetMap(GM_CurrentMap);
+    if (work->decay != -1)
+    {
+        RexMissileTrail(work, 0);
+        if (work->decay-- == 0)
+            GV_DestroyActor(work);
+        return;
+    }
+    RexMissileTrail(work, 1);
+    collision = CheckCollision(work, map);
+    work->world.t[0] = work->position.vx;
+    work->world.t[1] = work->position.vy;
+    work->world.t[2] = work->position.vz;
+    DG_SetPos(&work->world);
+    GM_ActObject2((OBJECT *)&work->body);
+    if (collision)
+    {
+        NewBlast(&work->world, &blast_data_8009F4B8[3]);
+        work->target.center = work->position;
+        GM_PushTarget(&work->target);
+        DG_InvisibleObjs(work->body.objs);
+        work->decay = 32;
+        if (collision == 1)
+        {
+            MATRIX impact = DG_ZeroMatrix;
+            impact.t[0] = work->world.t[0];
+            impact.t[1] = work->world.t[1];
+            impact.t[2] = work->world.t[2];
+            NewWindcrcl_800CF6BC(&impact, 4000);
+        }
+    }
+    else
+        Steer(work);
+}
+
+static void Die(RexMissileWork *work)
+{
+    GM_FreeObject((OBJECT *)&work->body);
+    if (work->prim)
+    {
+        DG_DequeuePrim(work->prim);
+        DG_FreePrim(work->prim);
+    }
+}
+
+static int InitTrail(RexMissileWork *work)
+{
+    int buffer;
+    int index;
+    work->texture = DG_GetTexture(20781);
+    work->prim = Takabe_MakeIndividualRect3DPrim(32, work->trail);
+    if (!work->texture || !work->prim)
+        return -1;
+    for (buffer = 0; buffer < 2; ++buffer)
+    {
+        POLY_FT4 *packets = work->prim->packs[buffer];
+        for (index = 0; index < 32; ++index)
+        {
+            setPolyFT4(&packets[index]);
+            setSemiTrans(&packets[index], 1);
+            setRGB0(&packets[index], 0, 0, 0);
+            RexSetParticleFrame(&packets[index], work->texture, 0, 4);
+            packets[index].clut = work->texture->clut;
+            packets[index].tpage = work->texture->tpage | 0x60;
+        }
+    }
+    work->prim->world = DG_ZeroMatrix;
+    return 0;
+}
+
+void *RexNewMissile(MATRIX *world, SVECTOR *aim, int side)
+{
+    MATRIX          matrix;
+    SVECTOR         rotation;
+    RexMissileWork *work = GV_NewActor(5, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, Act, Die, "hmissile.c");
+    GM_InitObjectNoRots(&work->body, GV_StrCode("rex_mis"), 877, 0);
+    GM_ConfigObjectLight((OBJECT *)&work->body, work->light);
+    work->body.objs->objs[0].raise = -500;
+    rotation.vx = GV_RandS(64);
+    rotation.vy = GV_RandS(64);
+    rotation.vz = GV_RandS(64);
+    RotMatrix_gte(&rotation, &matrix);
+    MulMatrix0(world, &matrix, &work->world);
+    work->position.vx = work->world.t[0] = world->t[0];
+    work->position.vy = work->world.t[1] = world->t[1];
+    work->position.vz = work->world.t[2] = world->t[2];
+    work->aim.vx = aim->vx >> 2;
+    work->aim.vy = aim->vy >> 2;
+    work->aim.vz = aim->vz >> 2;
+    GM_SetTarget(&work->target, 8, 1, &missile_target_size);
+    work->map = GM_CurrentMap;
+    work->speed = GV_RandU(64) + 40;
+    work->turn.vz = 180;
+    work->turn_speed = 10;
+    work->phase = GV_RandU(1024);
+    work->sound_timer = -15;
+    work->side = side;
+    GM_SeSetMode(&work->position, 186, 1);
+    if (InitTrail(work) < 0)
+    {
+        GV_DestroyActor(work);
+        return NULL;
+    }
+    work->decay = -1;
+    return work;
+}
diff --git a/source/kojo/mg_hatch.c b/source/kojo/mg_hatch.c
new file mode 100644
index 000000000..b8adc148d
--- /dev/null
+++ b/source/kojo/mg_hatch.c
@@ -0,0 +1,76 @@
+#include "overlays/s17a/rex_effects.h"
+#include "anime/animconv/anime.h"
+#include "takabe/spark2.h"
+
+_Static_assert(sizeof(RexHatchWork) == 204, "original REX hatch actor layout");
+
+void RexHatchMove(RexHatchWork *work)
+{
+    GV_AddVec3(&work->position, &work->velocity, &work->position);
+    GV_AddVec3(&work->rotation, &work->spin, &work->rotation);
+    work->velocity.vx -= work->velocity.vx / 8;
+    work->velocity.vz -= work->velocity.vz / 8;
+    work->velocity.vy -= 40;
+    work->spin.vx -= work->spin.vx / 16;
+    work->spin.vy -= work->spin.vy / 16;
+    work->spin.vz -= work->spin.vz / 16;
+    if (work->position.vy < 0)
+    {
+        work->position.vy = -work->position.vy - 100;
+        work->velocity.vy = -work->velocity.vy / 4;
+        work->velocity.vx -= work->velocity.vx / 4;
+        work->velocity.vz -= work->velocity.vz / 4;
+        work->rotation = DG_ZeroVector;
+        work->spin.vx -= work->spin.vx / 2;
+        work->spin.vy -= work->spin.vy / 2;
+        work->spin.vz -= work->spin.vz / 2;
+    }
+}
+
+static void Act(RexHatchWork *work)
+{
+    GM_CurrentMap = work->map;
+    if (work->timer < 6)
+        AN_RecoilSmoke(&work->position);
+    RexHatchMove(work);
+    if (work->position.vy < 0)
+        GV_DestroyActor(work);
+    DG_SetPos2(&work->position, &work->rotation);
+    GM_ActObject2((OBJECT *)&work->body);
+    if (work->timer >= 61)
+    {
+        if (work->timer & 1)
+            DG_VisibleObjs(work->body.objs);
+        else
+            DG_InvisibleObjs(work->body.objs);
+    }
+    if (work->timer >= 81)
+        GV_DestroyActor(work);
+    ++work->timer;
+}
+
+static void Die(RexHatchWork *work)
+{
+    GM_FreeObject((OBJECT *)&work->body);
+}
+
+void *RexNewHatch(MATRIX *world)
+{
+    SVECTOR       velocity = {0, 0, 300, 0};
