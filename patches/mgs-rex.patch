+    }
+    packet = work->prim->packs[GV_Clock];
+    for (i = 0; i < 8; ++i)
+    {
+        for (j = 0; j < 4; ++j)
+        {
+            work->vertices[4 * i + j].vx += work->speeds[i].vx;
+            work->vertices[4 * i + j].vy += work->speeds[i].vy;
+            work->vertices[4 * i + j].vz += work->speeds[i].vz;
+        }
+        setRGB0(&packet[i], work->color.vx * (10 * work->life) / 256, work->color.vy * (10 * work->life) / 256,
+                work->color.vz * (10 * work->life) / 256);
+    }
+}
+
+static void BurstDie(LaserBurst *work)
+{
+    if (work->prim)
+    {
+        DG_DequeuePrim(work->prim);
+        DG_FreePrim(work->prim);
+    }
+}
+
+static void *NewBurst(MATRIX *world)
+{
+    static RECT rectangle = {50, 50, 100, 100};
+    LaserBurst *work;
+    DG_TEX     *texture;
+    SVECTOR     direction, jitter, points[4];
+    int         i, j, angle, scale;
+    texture = DG_GetTexture(GV_StrCode("awa3"));
+    if (!texture)
+        return NULL;
+    work = GV_NewActor(5, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, BurstAct, BurstDie, "ninjalzr.c");
+    work->map = GM_CurrentMap;
+    work->life = 8;
+    work->color = (SVECTOR){255, 255, 255, 0};
+    DG_SetPos(world);
+    for (i = 0; i < 8; ++i)
+    {
+        angle = GV_RandU(4096);
+        direction.vx = rcos(angle);
+        direction.vz = rsin(angle);
+        scale = GV_RandU(256) + 64;
+        direction.vx /= scale;
+        direction.vy = scale;
+        direction.vz /= scale;
+        direction.pad = 0;
+        jitter = (SVECTOR){GV_RandS(512), GV_RandS(512), GV_RandS(512), 0};
+        points[0] = direction;
+        points[1] = (SVECTOR){direction.vx + jitter.vx, direction.vy + jitter.vy, direction.vz + jitter.vz, 0};
+        points[2] = (SVECTOR){direction.vx - jitter.vx, direction.vy - jitter.vy, direction.vz - jitter.vz, 0};
+        points[3] = (SVECTOR){direction.vx * 4, direction.vy * 4, direction.vz * 4, 0};
+        DG_RotVector(&direction, &work->speeds[i], 1);
+        DG_PutVector(points, &work->vertices[4 * i], 4);
+    }
+    work->prim = DG_MakePrim(18, 8, 0, work->vertices, &rectangle);
+    if (!work->prim)
+    {
+        GV_DestroyActor(&work->actor);
+        return NULL;
+    }
+    DG_QueuePrim(work->prim);
+    work->prim->group_id = work->map;
+    for (i = 0; i < 2; ++i)
+        for (j = 0; j < 8; ++j)
+        {
+            POLY_FT4 *packet = &((POLY_FT4 *)work->prim->packs[i])[j];
+            InitPacket(packet, texture);
+            packet->tpage |= 0x20;
+            setRGB0(packet, 127, 255, 255);
+        }
+    return work;
+}
+
+static void Emit(NinjaLaser *work, MATRIX *world, int size, int red, int blue)
+{
+    int i;
+    for (i = 0; i < 100; ++i)
+        if (work->particles[i].age == 0)
+        {
+            work->particles[i].age = 7;
+            RexAnimateParticle(world, size, red, red, blue, 6, 0, 0, 0, work->particles[i].script);
+            return;
+        }
+}
+
+static void FreePrims(NinjaLaser *work)
+{
+    int i;
+    for (i = 0; i < 7; ++i)
+        if (work->prims[i])
+        {
+            DG_DequeuePrim(work->prims[i]);
+            DG_FreePrim(work->prims[i]);
+            work->prims[i] = NULL;
+        }
+}
+
+static void UpdateCharge(NinjaLaser *work, MATRIX *world)
+{
+    int     i, active, random_mask, random_base, radius;
+    SVECTOR delta, facing, offset, *vertices;
+    active = 7 * (work->total - work->remaining) / (work->total - 30);
+    random_mask = 8 * (work->remaining - 30) / (work->total - 30);
+    random_base = 7 * (work->remaining - 30) / (work->total - 30);
+    for (i = 0; i < active; ++i)
+    {
+        if (work->timers[i])
+        {
+            work->offsets[i].vx -= work->offsets[i].vx / work->timers[i];
+            work->offsets[i].vy -= work->offsets[i].vy / work->timers[i];
+            work->offsets[i].vz -= work->offsets[i].vz / work->timers[i];
+            --work->timers[i];
+        }
+        else
+        {
+            work->offsets[i].vx = (rand() & (work->size >> 1)) - (work->size >> 2);
+            work->offsets[i].vy = (rand() & (work->size >> 1)) - (work->size >> 2);
+            work->offsets[i].vz = work->size + (rand() & (work->size >> 1)) - (work->size >> 2);
+            work->timers[i] = (rand() & random_mask) + random_base + 5;
+            setRGB0((POLY_FT4 *)work->prims[i]->packs[0], 128, 128, 255);
+            setRGB0((POLY_FT4 *)work->prims[i]->packs[1], 118, 118, 245);
+        }
+        vertices = &work->vertices[4 * i];
+        radius = work->size >> 5;
+        vertices[0] = (SVECTOR){-radius, -radius, 0, 0};
+        vertices[1] = (SVECTOR){-radius, radius, 0, 0};
+        vertices[2] = (SVECTOR){radius, -radius, 0, 0};
+        vertices[3] = (SVECTOR){radius, radius, 0, 0};
+        delta.vx = (world->t[0] - gUnkCameraStruct2_800B7868.position.vx) >> 2;
+        delta.vy = (world->t[1] - gUnkCameraStruct2_800B7868.position.vy) >> 2;
+        delta.vz = (world->t[2] - gUnkCameraStruct2_800B7868.position.vz) >> 2;
+        facing.vx = -ratan2(delta.vy, SquareRoot0(delta.vx * delta.vx + delta.vz * delta.vz));
+        facing.vy = ratan2(delta.vx, delta.vz);
+        facing.vz = 0;
+        DG_SetPos2(&DG_ZeroVector, &facing);
+        DG_PutVector(vertices, vertices, 4);
+        DG_SetPos(world);
+        offset = work->offsets[i];
+        DG_PutVector(&offset, &offset, 1);
+        DG_SetPos2(&offset, &DG_ZeroVector);
+        DG_PutVector(vertices, vertices, 4);
+    }
+}
+
+static void UpdateDischarge(NinjaLaser *work, MATRIX *world)
+{
+    MATRIX  transformed;
+    SVECTOR offset = {0, 0, 0, 0};
+    if (work->remaining == 30)
+    {
+        FreePrims(work);
+        work->mesh_timer = 10;
+        work->mesh = RexNewMeshLaser(&work->jitter_world);
+        return;
+    }
+    if (work->remaining == 10)
+    {
+        VECTOR  scale = {512, 512, 512, 0};
+        SVECTOR rotation = {1024, 0, 0, 0};
+        DG_SetPos(world);
+        DG_RotatePos(&rotation);
+        ReadRotMatrix(&transformed);
+        ScaleMatrix(&transformed, &scale);
+        NewBurst(&transformed);
+    }
+    if (work->remaining >= 7)
+        Emit(work, world, work->size, 127 / (30 - work->remaining), 255 / (30 - work->remaining));
+    if (work->remaining >= 11)
+    {
+        offset.vz = work->size >> 2;
+        DG_SetPos(world);
+        DG_MovePos(&offset);
+        ReadRotMatrix(&transformed);
+        Emit(work, &transformed, work->size >> 1, 95 / (30 - work->remaining), 255 / (30 - work->remaining));
+    }
+    if (work->remaining >= 16)
+    {
+        offset.vz = work->size >> 1;
+        DG_SetPos(world);
+        DG_MovePos(&offset);
+        ReadRotMatrix(&transformed);
+        Emit(work, &transformed, work->size >> 1, 63 / (30 - work->remaining), 255 / (30 - work->remaining));
+    }
+}
+
+static void Act(NinjaLaser *work)
+{
+    MATRIX  world;
+    SVECTOR rotation = {1024, 0, 0, 0};
+    SVECTOR offset = {0, 0, 350, 0};
+    int     i, range;
+    if (work->remaining <= 0)
+    {
+        GV_DestroyActor(&work->actor);
+        return;
+    }
+    GM_CurrentMap = work->map;
+    if (--work->mesh_timer <= 0 && work->mesh)
+    {
+        GV_DestroyActor(work->mesh);
+        work->mesh = NULL;
+    }
+    for (i = 0; i < 100; ++i)
+        if (--work->particles[i].age < 0)
+            work->particles[i].age = 0;
+    DG_SetPos(work->root);
+    DG_RotatePos(&rotation);
+    DG_MovePos(&offset);
+    ReadRotMatrix(&world);
+    ReadRotMatrix(&work->jitter_world);
+    range = work->size / 10;
+    if (!range)
+    {
+        printf("Ninja laser has zero jitter range\n");
+        abort();
+    }
+    for (i = 0; i < 3; ++i)
+        work->jitter_world.t[i] += rand() % range - (range >> 1);
+    if (work->remaining < 31)
+        UpdateDischarge(work, &world);
+    else
+    {
+        Emit(work, &world, work->size >> 1, 127 / (work->remaining - 30), 255 / (work->remaining - 30));
+        UpdateCharge(work, &world);
+    }
+    --work->remaining;
+}
+
+static void Die(NinjaLaser *work)
+{
+    FreePrims(work);
+    if (work->mesh)
+        GV_DestroyActor(work->mesh);
+}
+
+void *RexNewNinjaLaser(MATRIX *root, int size, int duration)
+{
+    NinjaLaser *work;
+    DG_TEX     *texture = DG_GetTexture(GV_StrCode("blue_bonbori"));
+    int         i, buffer;
+    if (!texture)
+        return NULL;
+    work = GV_NewActor(5, sizeof(*work));
+    if (!work)
+        return NULL;
+    GV_SetNamedActor(&work->actor, Act, Die, "ninjalzr.c");
+    work->map = GM_CurrentMap;
+    work->total = duration + 30;
+    work->size = size;
+    work->remaining = work->total;
+    work->root = root;
+    for (i = 0; i < 7; ++i)
+    {
+        work->prims[i] = DG_MakePrim(18, 1, 0, &work->vertices[4 * i], NULL);
+        if (!work->prims[i])
+        {
+            GV_DestroyActor(&work->actor);
+            return NULL;
+        }
+        DG_QueuePrim(work->prims[i]);
+        work->prims[i]->group_id = work->map;
+        for (buffer = 0; buffer < 2; ++buffer)
+        {
+            POLY_FT4 *packet = work->prims[i]->packs[buffer];
+            InitPacket(packet, texture);
+            setRGB0(packet, 0, 0, 0);
+        }
+    }
+    return work;
+}
diff --git a/source/kojo/rex_anime.c b/source/kojo/rex_anime.c
new file mode 100644
index 000000000..7282cca52
--- /dev/null
