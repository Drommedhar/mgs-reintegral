+void MENU_CodecMemoryView(MenuWork *work, MgsCodecActionView *view);
+void MENU_CodecMemoryAction(unsigned kind, unsigned target);
+
+static void CodecActionsView(MenuWork *work)
+{
+    MgsCodecActionView view = {0};
+    uintptr_t item = 0;
+    view.opened = work->field_2A_state == MENU_CODEC_OPEN;
+    view.mode = view.opened ? work->field_210_codec_state : 21;
+    view.frequency = codec_freq_800AB638;
+    if (!(GM_PlayerStatus & PLAYER_MENU_DISABLE)) {
+        if (work->field_2A_state == MENU_CLOSED &&
+            !(GM_GameStatus & (STATE_VOX_STREAM | STATE_TAKING_PHOTO | STATE_RADIO_OFF)) && GV_PauseLevel == 0) {
+            view.active = 1;
+            view.allowed = 1u << MGS_CODEC_OPEN;
+        } else if (view.opened) {
+            view.active = 1;
+            if (view.mode == 1 && gRadioIncomingCall_8009E708.field_0 == 0)
+                view.allowed = (1u << MGS_CODEC_TUNE) | (1u << MGS_CODEC_CALL) |
+                    (1u << MGS_CODEC_MEMORY) | (1u << MGS_CODEC_BACK);
+            else if (view.mode == 4 && work->field_212 == 0)
+                view.allowed = 1u << MGS_CODEC_ADVANCE;
+            else if (view.mode == 5 && work->field_218->field_14_bInExecBlock && !(work->field_218->field_18 & 1))
+                view.allowed = 1u << MGS_CODEC_SKIP;
+            else if (view.mode == 9 && work->field_212 == 0)
+                view.allowed = 1u << MGS_CODEC_ADVANCE;
+            else if (view.mode == 10) MENU_CodecMemoryView(work, &view);
+            else if (view.mode == 16) {
+                view.selection = work->field_218->field_1A_index;
+                view.count = codec_choice_count;
+                if (view.count) view.allowed = (1u << MGS_CODEC_SELECT) | (1u << MGS_CODEC_CONFIRM);
+            }
+            if (view.mode == 4 || view.mode == 5 || view.mode == 16)
+                item = (uintptr_t)work->field_218->field_C_pScript;
+        }
+    }
+    MgsGodotCodecActionsView(view, item);
+}
+
+static void CodecActionsApply(MenuWork *work)
+{
+    if (codec_command.kind == MGS_CODEC_TUNE) {
+        int target = codec_command.target;
+        gCodecAction = target < codec_freq_800AB638 ? CODEC_ACTION_LEFT : CODEC_ACTION_RIGHT;
+        if (target != codec_freq_800AB638) GM_SeSet2(0, 0x3F, SE_RADIO_TUNING);
+        codec_freq_800AB638 = target;
+        dword_800AB63C = dword_800ABB10 = 0;
+    } else if (work->field_210_codec_state == 10) {
+        MENU_CodecMemoryAction(codec_command.kind, codec_command.target);
+    }
+}
