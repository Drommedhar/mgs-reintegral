+        while (memory->field_0_idx >= memory->field_2 + 8) memory->field_2 += 2;
+        memory->field_6 = 0;
+        GM_SeSet2(0, 0x3f, SE_RADIO_CURSOR);
+        sub_8004D4A0(memory);
+    }
+    if (kind == MGS_CODEC_CONFIRM) CodecMemoryConfirm(0);
+}
