diff --git a/source/overlays/s19a/timer.c b/source/overlays/s19a/timer.c
new file mode 100644
--- /dev/null
+++ b/source/overlays/s19a/timer.c
@@ -0,0 +1,129 @@
+#include "game/game.h"
+#include "libgcl/libgcl.h"
+#include <stddef.h>
+
+typedef struct S19Timer
+{
+    GV_ACT   actor;
+    DG_PRIM *prim;
+    int      depth;
+    int      reserved[7];
+    int      u, width, v, height;
+    int      state;
+    int      reserved_58;
+    int      ticks;
+    int      tick_proc;
+    int      end_proc;
+} S19Timer;
+
+_Static_assert(sizeof(S19Timer) == 104, "Original garage timer layout");
+
+static void TimerDigit(S19Timer *work, POLY_FT4 *packet, int digit)
+{
+    int left = work->u + work->width * digit / 10;
+    int right = work->u + work->width * (digit + 1) / 10;
+    setUV4(packet, left, work->v, right, work->v, left, work->v + work->height, right, work->v + work->height);
+}
+
+static void TimerAct(S19Timer *work)
+{
+    int      seconds = work->ticks / 30;
+    int      minutes = seconds / 60;
+    int      digits[5] = {seconds % 60 % 10, seconds % 60 / 10, 0, minutes % 10, minutes / 10};
+    int      buffer, index;
+    GCL_ARGS args;
+    long     tick;
+    if (work->ticks % 30 == 0 && work->tick_proc >= 0)
+    {
+        tick = work->ticks;
+        args.argc = 1;
+        args.argv = &tick;
+        GCL_ExecProc(work->tick_proc, &args);
+    }
+    if (seconds == 0 && work->end_proc >= 0)
+    {
+        GCL_ExecProc(work->end_proc, NULL);
+        work->end_proc = -1;
+    }
+    for (buffer = 0; buffer < 2; ++buffer)
+    {
+        POLY_FT4 *packets = work->prim->packs[buffer];
+        for (index = 0; index < 5; ++index)
+            if (index != 2)
+                TimerDigit(work, &packets[index], digits[index]);
+    }
+    --work->ticks;
+    for (index = 0; index < 5; ++index)
+    {
+        POLY_FT4 *packets = work->prim->packs[GV_Clock];
+        setaddr(&packets[index], work->depth);
+    }
+}
+
+static void TimerDie(S19Timer *work)
+{
+    if (work->prim != NULL)
+    {
+        DG_DequeuePrim(work->prim);
+        DG_FreePrim(work->prim);
+    }
+}
+
+static int TimerResources(S19Timer *work)
+{
+    char   *option = GCL_GetOption('t');
+    DG_TEX *numbers, *colon;
+    int     buffer, index;
+    work->ticks = option ? GCL_StrToInt(option) + 29 : 5429;
+    work->tick_proc = GCL_GetOption('e') ? GCL_StrToInt(GCL_NextStr()) : -1;
+    work->end_proc = GCL_GetOption('z') ? GCL_StrToInt(GCL_NextStr()) : -1;
+    work->prim = DG_MakePrim(DG_PRIM_SORTONLY | DG_PRIM_POLY_FT4, 5, 0, NULL, NULL);
+    if (work->prim == NULL)
+        return -1;
+    DG_QueuePrim(work->prim);
+    work->prim->group_id = GM_CurrentMap;
+    numbers = DG_GetTexture(GV_StrCode("0123"));
+    colon = DG_GetTexture(GV_StrCode("dot2"));
+    if (numbers == NULL || colon == NULL)
+        return -1;
+    work->u = numbers->off_x;
+    work->width = numbers->w + 1;
+    work->v = numbers->off_y;
+    work->height = numbers->h + 1;
+    for (buffer = 0; buffer < 2; ++buffer)
+    {
+        POLY_FT4 *packets = work->prim->packs[buffer];
+        for (index = 0; index < 5; ++index)
+        {
+            POLY_FT4 *packet = &packets[index];
+            DG_TEX   *texture = index == 2 ? colon : numbers;
+            setPolyFT4(packet);
+            setSemiTrans(packet, 1);
+            setRGB0(packet, 255, 208, 208);
+            setXYWH(packet, 134 - index * 16, -100, 16, 18);
+            packet->tpage = texture->tpage;
+            packet->clut = texture->clut;
+            if (index == 2)
+                setUVWH(packet, texture->off_x, texture->off_y, texture->w, texture->h);
+            else
+                TimerDigit(work, packet, 0);
+        }
+    }
+    work->depth = 1;
+    work->state = 0;
+    return 0;
+}
+
+void *NewS19Timer(void)
+{
+    S19Timer *work = GV_NewActor(5, sizeof(*work));
+    if (work == NULL)
+        return NULL;
+    GV_SetNamedActor(&work->actor, TimerAct, TimerDie, "timer.c");
+    if (TimerResources(work) < 0)
+    {
+        GV_DestroyActor(&work->actor);
+        return NULL;
+    }
+    return work;
+}
