-static void QueueTimelineAudio(const short* buffer, int frames) {
+void Psyz_AudioSetLoading(int loading) {
+    loading_output = loading != 0;
+}
+
+static bool SilentSamples(const short* buffer, int frames) {
+    for (int sample = 0; sample < frames * N_CHANNELS; ++sample)
+        if (buffer[sample]) return false;
+    return true;
+}
+
+static void QueueTimelineAudio(const short* buffer, int frames, bool loading_frame) {
     if (!sdl_stream) {
         return;
     }
@@ -103,7 +114,14 @@ static void QueueTimelineAudio(const short* buffer, int frames) {
         }
         return;
     }
+    const bool accelerated = loading_output && loading_frame;
+    if (accelerated && SilentSamples(buffer, frames)) return;
     int queued = SDL_GetAudioStreamQueued(sdl_stream);
+    while (accelerated && !timeline_priming &&
+           queued > (int)(timeline_buffer_frames * N_CHANNELS * SAMPLE_SIZE)) {
+        SDL_Delay(1);
+        queued = SDL_GetAudioStreamQueued(sdl_stream);
+    }
     if (queued < 0) {
         ERRORF("cannot query queued audio: %s", SDL_GetError());
         abort();
@@ -158,11 +176,34 @@ static void PumpTimelineAudio(void) {
