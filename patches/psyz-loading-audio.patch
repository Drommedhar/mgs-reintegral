         due = Psyz_ClockAudioFramesDue();
     }
 }
 
+void Psyz_AudioPumpWait(void) {
+#ifdef PSYZ_POLL_IRQ_ONLY
+    if (!sdl_stream || pumping || output_paused || output_suppressed ||
+        Psyz_ClockFrameActive()) return;
+    int queued = SDL_GetAudioStreamQueued(sdl_stream);
+    if (queued < 0) {
+        ERRORF("cannot query presentation-wait audio: %s", SDL_GetError());
+        abort();
+    }
+    int frames = (int)timeline_buffer_frames - queued / (N_CHANNELS * SAMPLE_SIZE);
+    if (frames <= 0) return;
+    if (frames > BUFFER_FRAMES) frames = BUFFER_FRAMES;
+    short buffer[BUFFER_FRAMES * N_CHANNELS];
+    pumping = true;
+    Psyz_AudioLock();
+    Psyz_SpuPullSamplesServiced(buffer, frames, service_tasks);
+    Psyz_AudioUnlock();
+    audio_stats.wait_frames += (unsigned)frames;
+    QueueTimelineAudio(buffer, frames, false);
+    pumping = false;
+#endif
+}
