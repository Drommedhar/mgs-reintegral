+        sweep_tick(&spu.voice_volume[v][1], rxx->voice[v].volume.right);
+    }
+    sweep_tick(&spu.main_volume[0], rxx->main_vol.left);
+    sweep_tick(&spu.main_volume[1], rxx->main_vol.right);
+    rxx->main_volx.left = (short)spu.main_volume[0].level;
+    rxx->main_volx.right = (short)spu.main_volume[1].level;
 }
 
