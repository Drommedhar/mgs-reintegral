+static void sweep_tick(SpuVolumeSweep* sweep, unsigned short control) {
+    unsigned shift = (control >> 2) & 31;
+    unsigned increment = 0x8000u >> (shift > 11 ? shift - 11 : 0);
+    int decreasing = !!(control & 0x2000);
+    int exponential = !!(control & 0x4000);
+    int negative = !!(control & 0x1000) && !(decreasing && exponential);
+    int step = 7 - (control & 3);
+    if (!(control & 0x8000)) {
+        sweep->level = (short)(control << 1);
+        sweep->counter = 0;
+        return;
+    }
+    if ((control & 127) == 127)
+        return;
+    if (decreasing ^ negative)
+        step = ~step;
+    step *= 1 << (shift < 11 ? 11 - shift : 0);
+    if (exponential && decreasing) {
+        step = (step * sweep->level) >> 15;
+    } else if (exponential && sweep->level > 0x6000) {
+        if (shift < 10) {
+            step >>= 2;
+        } else if (shift >= 11) {
+            increment >>= 2;
+        } else {
+            step >>= 1;
+            increment >>= 1;
+        }
     }
-    return (short)((reg & 0x7FFF) << 1);
+    sweep->counter += increment ? increment : 1;
+    if (!(sweep->counter & 0x8000))
+        return;
+    sweep->counter = 0;
+    sweep->level = clamp16(sweep->level + step);
+    if (decreasing && ((negative && sweep->level > 0) ||
+                       (!negative && sweep->level < 0)))
+        sweep->level = 0;
+}
