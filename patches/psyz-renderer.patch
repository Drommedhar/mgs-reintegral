diff --git a/psyz/CMakeLists.txt b/psyz/CMakeLists.txt
index d909570..c5111e5 100644
--- a/psyz/CMakeLists.txt
+++ b/psyz/CMakeLists.txt
@@ -202,10 +202,13 @@ else()
 endif()
 
 set(PSYZ_RENDERER_DEFAULT "sdl3_gpu")
-set(PSYZ_RENDERER "${PSYZ_RENDERER_DEFAULT}" CACHE STRING "Rendering backend: sdl3_gpu or sdl3_gl")
-set_property(CACHE PSYZ_RENDERER PROPERTY STRINGS sdl3_gl sdl3_gpu)
-if(NOT PSYZ_RENDERER STREQUAL "sdl3_gpu" AND NOT PSYZ_RENDERER STREQUAL "sdl3_gl")
-    message(FATAL_ERROR "invalid PSYZ_RENDERER '${PSYZ_RENDERER}', expected sdl3_gpu or sdl3_gl")
+set(PSYZ_RENDERER "${PSYZ_RENDERER_DEFAULT}" CACHE STRING "Rendering backend: sdl3_gpu, sdl3_gl, or external")
+set_property(CACHE PSYZ_RENDERER PROPERTY STRINGS sdl3_gl sdl3_gpu external)
+if(NOT PSYZ_RENDERER MATCHES "^(sdl3_gpu|sdl3_gl|external)$")
+    message(FATAL_ERROR "invalid PSYZ_RENDERER '${PSYZ_RENDERER}'")
+endif()
+if(PSYZ_RENDERER STREQUAL "external" AND NOT WIN32)
+    message(FATAL_ERROR "The external renderer contract currently targets Windows")
 endif()
 message(STATUS "Using the ${PSYZ_RENDERER} rendering backend")
 
@@ -235,7 +238,7 @@ elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
         else()
             list(APPEND PSYZ_LIBS -lsdl3_gl32)
         endif()
-    else()
+    elseif(PSYZ_RENDERER STREQUAL "sdl3_gpu")
         list(APPEND PSYZ_SOURCES src/platform/sdl3_gpu.c)
         list(APPEND PSYZ_INC ${CMAKE_CURRENT_SOURCE_DIR}/../external/SDL/src/video/khronos)
     endif()
@@ -338,6 +341,17 @@ if(PSYZ_IS_IOS)
     target_compile_definitions(psyz PUBLIC PLATFORM_IOS=1)
 endif()
 target_include_directories(psyz PUBLIC ${PSYZ_INC})
+if(PSYZ_RENDERER STREQUAL "external")
+    if(NOT IS_DIRECTORY "${PSYZ_RENDERER_MODULE}" OR NOT EXISTS "${PSYZ_RENDERER_MODULE}/CMakeLists.txt")
+        message(FATAL_ERROR "PSYZ_RENDERER_MODULE must name a renderer source directory")
+    endif()
+    set(PSYZ_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
+    add_subdirectory("${PSYZ_RENDERER_MODULE}" "${CMAKE_CURRENT_BINARY_DIR}/external-renderer")
+    if(NOT TARGET psyz_renderer)
+        message(FATAL_ERROR "External renderer must define the psyz_renderer target")
+    endif()
+    target_link_libraries(psyz PUBLIC psyz_renderer)
+endif()
 set_property(TARGET psyz PROPERTY PSYZ_EXPORT_TO_MODULES 1)
 if(PSP)
     target_link_libraries(psyz PUBLIC ${PSYZ_LIBS})
diff --git a/psyz/cmake/title.cmake b/psyz/cmake/title.cmake
index 61276b4..cb0562f 100644
--- a/psyz/cmake/title.cmake
+++ b/psyz/cmake/title.cmake
@@ -14,9 +14,11 @@ function(psyz_title target title)
         message(FATAL_ERROR "psyz_title: cannot contain quotes or backslashes")
     endif()
 
-    if(TARGET psyz)
-        target_compile_definitions(psyz PRIVATE "PSYZ_TITLE=\"${title}\"")
-    endif()
+    foreach(renderer_target IN ITEMS psyz psyz_renderer)
+        if(TARGET ${renderer_target})
+            target_compile_definitions(${renderer_target} PRIVATE "PSYZ_TITLE=\"${title}\"")
+        endif()
+    endforeach()
 
     if(PSP)
         psyz_psp_title(${target} "${title}")
