+    }
+    work->field_1C8 &= ~0x40;
+    if (work->field_1C8 & 0x100)
+    {
+        dy = work->field_1E2 - work->field_1E0;
+        work->field_1D0.vy = work->field_1E0;
+        if (dy != 0)
+        {
+            span = abs(work->field_1F8.vy - work->field_1F8.vx) / 160;
+            work->field_1C8 |= 0x40;
+            work->field_1E4 = -dy / span;
+        }
+    }
+    else
+    {
+        work->field_1D0.vy = GM_PlayerPosition.vy - 450;
+    }
+    work->field_1D0.vz = work->field_1F8.vz;
+    if ((GV_Time & 1) && !(work->field_1C8 & 0x100))
+    {
+        work->field_1C8 |= 0x40;
+        distance = abs(work->field_1D0.vx - GM_PlayerPosition.vx);
+        work->field_1E4 = 64;
+        work->field_1D0.vy += (distance / 160) * 64;
+    }
+    work->field_1C8 &= ~0x100;
