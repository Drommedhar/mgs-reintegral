+int d18a_snake18_800CBBC8(Snake18Work *work)
+{
+    unsigned status = (work->f868 & 0x100) ? work->pad->press : work->pad->status;
+    if (work->pad->press & 0x20)
+    {
+        if ((unsigned char)work->f8A8->field_10[2] != 0x9e)
+        {
+            Snake18SetAction(work, d18a_snake18_800D3774);
+            work->f7E4 |= 4;
+        }
+        return 1;
+    }
+    if ((work->f864 >= 0 && *work->f860 == 0) || !(status & 0x80))
+        return 0;
+    work->f858 = 0;
+    if (work->f868 & 0x10)
+    {
+        Snake18SetAction(work, work->f854);
+        work->f7E4 |= 4;
+        return 1;
+    }
+    if ((work->f868 & 8) ? (GM_PlayerStatus & 0x10) : (status & 0x40))
+        Snake18SetAction(work, d18a_snake18_800D1B3C);
+    else
+        Snake18SetAction(work, d18a_snake18_800D1A6C);
+    GM_PlayerStatus |= 0x800;
+    return 1;
+}
