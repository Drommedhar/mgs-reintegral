+static void DynConActCollapse(DynCon *work, int group, int index, SVECTOR *position)
+{
+    switch (work->field_3F20[group])
+    {
+    case 0:
+        if (work->field_4050 == 2 || work->field_4050 == 3)
+            DynConSettleSaved(work, group, index);
+        else
+        {
+            if (work->field_4050 == 1)
+                work->fragments[group].state = 1;
+            DynConCollapseSound(work, position);
+            s15c_dyncon_800D6070(work, index + 4, group);
+            s15c_dyncon_800D603C(work, group);
+        }
+        break;
+    case 1:
+        DynConCollapseSound(work, position);
+        if (work->field_3F10[group] != 32)
+            s15c_dyncon_800D5114(work, group);
+        s15c_dyncon_800D5428(work, group, 4 * (32 - work->field_3F10[group]));
+        s15c_dyncon_800D5090(work, group);
+        work->entries[index + 4].rotation.vy += group < 2 ? 16 : -16;
+        s15c_dyncon_800D6070(work, index + 4, group);
+        /* Fall through: both phases update the same dynamic floor. */
+    case 2:
+        s15c_dyncon_800D6004(work, group);
+        s15c_dyncon_800D5EDC(work, group, 1);
+        break;
+    case 3:
+        DynConFall(work, group, index, position);
+        break;
+    case 4:
+    case 5:
+        DynConImpact(work, group, &work->entries[index + 4], position);
+        break;
+    }
+}
