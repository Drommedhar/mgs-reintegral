+void s15c_dyncon_800D6528(DynCon *work)
+{
+    int i;
+    GM_CurrentMap = work->map;
+    if (work->field_4050 == 1)
+        DynConActFragments(work);
+    if (s15c_container_destroy == 1)
+        GV_DestroyActor(&work->actor);
+    if (work->field_4050 == 1)
+    {
+        for (i = 0; i < 4; i++)
+            work->field_3F30[i] = 1;
+        s15c_dyncon_800D6128(work, &s15c_valcan_position, 10000);
+        s15c_dyncon_800D6128(work, &GM_PlayerPosition, 5000);
+    }
+    DynConCollectDamage(work);
+    DynConReplaceDamaged(work);
+    for (i = 0; i < 4; i++)
+        if (work->field_3F10[i] != 0 && work->field_4160[i] == 0)
+        {
+            int             damage_index = work->field_3F00[i];
+            int             index = 8 * (damage_index / 4) + damage_index % 4;
+            ContainerEntry *upper = &work->entries[index + 4];
+            SVECTOR         position;
+            DynConSoundPosition(&work->entries[index].position, &position);
+            DynConActCollapse(work, i, index, &position);
+            DG_SetPos2(&upper->position, &upper->rotation);
+            GM_ActObject2((OBJECT *)&upper->objects[1]);
+            s15c_container_phase[i] = work->field_3F20[i];
+        }
+}
