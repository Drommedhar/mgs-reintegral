+static int DynConReadSavedState(DynCon *work)
+{
+    static const int counts[3] = {8, 8, 4};
+    int              group, i, index = 0;
+    for (group = 0; group < 3; group++)
+    {
+        if (GCL_GetOption('l' + group) == NULL)
+            return -1;
+        for (i = 0; i < counts[group]; i++)
+        {
+            char          *value = GCL_NextStr();
+            unsigned short packed;
+            if (value == NULL)
+                return -1;
+            packed = GCL_StrToInt(value);
+            work->saved_state[index++] = packed >> 8;
+            work->saved_state[index++] = packed & 255;
+        }
+    }
+    return 0;
+}
