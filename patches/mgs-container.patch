+void s15c_dyncon_800D88C8(DynCon *work)
+{
+    int      values[40];
+    long     packed[20];
+    GCL_ARGS args;
+    int      i;
+    /* The retail loop also serializes the first four previous-damage values. */
+    memcpy(values, (char *)work + offsetof(DynCon, field_3CBC), sizeof(values));
+    for (i = 0; i < 20; i++)
+        packed[i] = ((values[2 * i] & 255) << 8) | (values[2 * i + 1] & 255);
+    for (i = 0; i < 3; i++)
+        if (work->save_procs[i] >= 0)
+        {
+            args.argc = i == 2 ? 4 : 8;
+            args.argv = &packed[8 * i];
+            GCL_ForceExecProc(work->save_procs[i], &args);
+        }
+}
