+static void DynConActFragments(DynCon *work)
+{
+    int i;
+    for (i = 0; i < 4; i++)
+    {
+        ContainerFragment *fragment = &work->fragments[i];
+        MATRIX             parent, local;
+        SVECTOR            position;
+        if (fragment->state == 2)
+        {
+            DG_SetPos2(&DG_ZeroVector, fragment->rotation);
+            ReadRotMatrix(&parent);
+            DG_SetPos2(fragment->position, fragment->rotation);
+            fragment->offset.vy += 300;
+            DG_PutVector(&fragment->offset, &position, 1);
+            fragment->object.objs->flag |= DG_FLAG_INVISIBLE;
+            s15c_dyncon_800D6434(work, &position, &DG_ZeroVector, i);
+            fragment->state = 3;
+        }
+        else if (fragment->state == 0 || fragment->state == 1)
+        {
+            fragment->step.vx = 0;
+            fragment->step.vz = 0;
+            fragment->step.vy -= 90;
+            if (fragment->state == 1)
+            {
+                DG_SetPos2(&DG_ZeroVector, fragment->rotation);
+                ReadRotMatrix(&parent);
+            }
+            DG_SetPos2(fragment->position, fragment->rotation);
+            DG_PutVector(&fragment->offset, &position, 1);
+            DG_SetPos2(&position, &fragment->step);
+            if (fragment->state == 1)
+            {
+                ReadRotMatrix(&local);
+                CompMatrix(&parent, &local, &parent);
+                SetRotMatrix(&parent);
+            }
+            GM_ActObject2((OBJECT *)&fragment->object);
+            DG_GetLightMatrix2(&position, fragment->light);
+        }
+    }
+}
+
+static void DynConSoundPosition(SVECTOR *container, SVECTOR *position)
+{
+    SVECTOR delta;
+    GV_SubVec3(container, &GM_PlayerPosition, &delta);
+    position->vx = GM_PlayerPosition.vx + delta.vx / 8;
+    position->vy = container->vy;
+    position->vz = GM_PlayerPosition.vz + delta.vz / 8;
+}
+
+static int DynConDamageEnabled(DynCon *work, int index)
+{
+    static const int selected[4] = {3, 21, 24, 34};
+    int              i;
+    for (i = 0; i < 4; i++)
+        if (index == selected[i] && work->field_3F30[i] == 0)
+            return 0;
+    return 1;
+}
+
+static void DynConCollectDamage(DynCon *work)
+{
+    int group, part;
+    for (group = 0; group < 9; group++)
+    {
+        int changed = 0;
+        for (part = 0; part < 4; part++)
+        {
+            int index = 4 * group + part;
+            int hit = 0;
+            if (!DynConDamageEnabled(work, index))
+                continue;
+            if (work->field_4050 == 1)
+            {
+                TARGET *target = work->entries[index].target;
+                if (target->damaged & TARGET_POWER)
+                {
+                    SVECTOR position;
+                    target->damaged &= ~TARGET_POWER;
+                    DynConSoundPosition(&work->entries[index].position, &position);
+                    GM_SeSet(&position, 189);
+                    hit = 1;
+                }
+            }
+            else if ((work->field_4050 == 2 || work->field_4050 == 3) &&
+                     work->field_3CBC[index] < work->saved_state[index])
+                hit = 1;
+            if (hit && ++work->field_3C2C[index] >= work->copies)
+            {
+                work->field_3C2C[index] = 0;
+                work->field_3CBC[index]++;
+                changed = 1;
+            }
+        }
+        if (changed)
+            s15c_dyncon_800D5910(work, group % 3, group / 3);
+    }
+}
+
+static void DynConStartCollapse(DynCon *work, int group, int index, int damage)
+{
+    if (damage == 4)
+    {
+        ContainerEntry *upper = &work->entries[index + 4];
+        work->field_3F10[group] = 32;
+        s15c_dyncon_800D5A3C(work, group, index, damage, -80, 112, -48, -24, -48, -48, -212, -48);
+        s15c_dyncon_800D5C38(work, group, index);
+        GM_FreeObject((OBJECT *)&upper->objects[0]);
+        work->object_active[index + 4][0] = 0;
+        DG_SetPos2(&upper->position, &upper->rotation);
+        s15c_dyncon_800D3EBC(&upper->objects[1], GV_StrCode("con_all"), 71);
+        work->object_active[index + 4][1] = 1;
+    }
+    if (damage == 5)
+    {
+        work->field_3F10[group] = 32;
+        s15c_dyncon_800D5A3C(work, group, index, damage, -112, 32, -80, -52, -80, -80, -240, -80);
+        if (group == 2)
+            work->field_3F40[2].vx = -work->field_3F40[2].vx;
+    }
+}
+
+static void DynConReplaceDamaged(DynCon *work)
+{
+    int i;
+    for (i = 0; i < 36; i++)
+    {
+        int             damage = work->field_3CBC[i];
+        int             index, slot, group;
+        ContainerEntry *entry;
+        SVECTOR         position;
+        if (damage == work->field_3D4C[i])
+            continue;
+        index = 8 * (i / 4) + i % 4;
+        entry = &work->entries[index];
+        DynConSoundPosition(&entry->position, &position);
+        work->field_3D4C[i] = damage;
+        if (work->field_4050 == 1)
+            GM_SeSet(&position, 180);
+        slot = damage % 2;
+        GM_FreeObject((OBJECT *)&entry->objects[1 - slot]);
+        work->object_active[index][1 - slot] = 0;
+        work->object_active[index][slot] = 1;
+        if ((i == 21 || i == 34) && (damage == 4 || damage == 5))
+        {
+            entry->rotation.vy += 2048;
+            DG_SetPos2(&entry->position, &entry->rotation);
+            entry->rotation.vy -= 2048;
+        }
+        else
+            DG_SetPos2(&entry->position, &entry->rotation);
+        s15c_dyncon_800D3EBC(&entry->objects[slot], work->models[6 * work->field_3E70[i] + damage], 71);
+        GM_ActObject2((OBJECT *)&entry->objects[slot]);
+        for (group = 0; group < 4; group++)
+            if (i == work->field_3F00[group])
+                DynConStartCollapse(work, group, index, damage);
+    }
+}
