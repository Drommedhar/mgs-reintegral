+static void DynConImpact(DynCon *work, int group, ContainerEntry *entry, SVECTOR *position)
+{
+    static unsigned char small_vibration[] = {0, 4, 127, 4, 0, 0, 0, 0};
+    static unsigned char large_vibration[] = {85, 4, 135, 8, 100, 10, 65, 12, 0, 0};
+    if (work->field_3F20[group] == 4)
+    {
+        DynConCollapseSound(work, position);
+        work->field_3F10[group]--;
+        s15c_dyncon_800D5DC0(&entry->position, &work->field_3F40[group], 2);
+        s15c_dyncon_800D5DC0(&entry->rotation, &work->field_3F60[group], 2);
+        s15c_dyncon_800D5EDC(work, group, group == 1 ? 3 : 2);
+        if (work->field_3F10[group] == 0)
+        {
+            work->field_3F10[group] = 8;
+            work->field_3F20[group]++;
+            work->field_3F60[group].vx = 1024;
+            if (work->field_4050 == 1)
+                GM_SeSet(position, 177);
+            GM_SetNoise(255, 32, &entry->position);
+            NewPadVibration(small_vibration, 1);
+            NewPadVibration(large_vibration, 2);
+        }
+    }
+    else
+    {
+        work->field_3F10[group]--;
+        s15c_dyncon_800D5DC0(&entry->position, &work->field_3F40[group], 2);
+        s15c_dyncon_800D5DC0(&entry->rotation, &work->field_3F60[group], 2);
+        if (work->field_3F10[group] == 0)
+        {
+            s15c_dyncon_800D5354(work, group, 0);
+            work->field_4040[group] = 1;
+            s15c_dyncon_800D5114(work, group);
+            if (work->field_4050 == 1)
+                GM_SeSet(position, 177);
+            GM_SetNoise(255, 32, &entry->position);
+            work->field_3F10[group] = 32;
+            work->field_3F20[group]++;
+            if (work->field_4050 == 1)
+                work->fragments[group].state = 2;
+        }
+    }
+}
