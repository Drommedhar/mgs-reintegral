+    option = GCL_GetOption('c');
+    work->copies = option ? GCL_StrToInt(option) : 1;
+    if (work->copies <= 0)
+        work->copies = 1;
+    work->map = map;
+    GM_CurrentMap = map;
+    if (s15c_dyncon_800D8510(work) < 0)
+        return -1;
+    if (work->field_4050 == 1)
+    {
+        for (i = 0; i < 3; i++)
+        {
+            option = GCL_GetOption('f' + i);
+            work->save_procs[i] = option ? GCL_StrToInt(option) : -1;
+        }
+        s15c_dyncon_800D61E0(work);
+    }
+    if ((work->field_4050 == 2 || work->field_4050 == 3) && DynConReadSavedState(work) < 0)
+        return -1;
+    memset(work->field_4160, 0, sizeof(work->field_4160));
+    memset(work->field_4040, 0, sizeof(work->field_4040));
+    return 0;
+}
