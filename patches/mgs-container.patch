+static void DynConSettleSaved(DynCon *work, int group, int index)
+{
+    static const SVECTOR positions[4] = {
+        {-4000, 749, -3500, 0}, {8000, 749, -750, 0}, {-7999, 749, 4999, 0}, {4000, 749, 8000, 0}};
+    static const SVECTOR rotations[4] = {
+        {1023, 1023, -511, 0}, {1023, 2048, -511, 0}, {1023, 1024, -511, 0}, {1023, -1023, 511, 0}};
+    ContainerEntry *entry = &work->entries[index + 4];
+    if (work->field_4050 == 2)
+    {
+        entry->position.vx = positions[group].vx;
+        entry->position.vy = positions[group].vy;
+        entry->position.vz = positions[group].vz;
+        entry->rotation.vx = rotations[group].vx;
+        entry->rotation.vy = rotations[group].vy;
+        entry->rotation.vz = rotations[group].vz;
+    }
+    else
+    {
+        entry->position.vx = group % 2 ? 10000 : -10000;
+        entry->position.vy = -10000;
+        entry->position.vz = group < 2 ? -10000 : 10000;
+        entry->rotation.vx = 0;
+        entry->rotation.vy = 0;
+        entry->rotation.vz = 0;
+    }
+    s15c_dyncon_800D5EDC(work, group, group == 1 ? 3 : 2);
+    if (work->field_4050 == 3)
+        entry->objects[0].objs->flag |= DG_FLAG_INVISIBLE;
+    s15c_dyncon_800D5354(work, group, 0);
+    work->field_4040[group] = 1;
+    work->field_4160[group] = 1;
+}
+
+static void DynConCollapseSound(DynCon *work, SVECTOR *position)
+{
+    if (work->field_4050 == 1 && GV_RandU(2) == 0)
+        GM_SeSet(position, 178);
+}
+
+static void DynConRotateFalling(DynCon *work, int group, int index)
+{
+    int time = 32 - work->field_3F10[group];
+    int half = time / 2;
+    switch (group)
+    {
+    case 0:
+        s15c_dyncon_800D5F68(work, index + 4, group, time, time, -half, time, -half, -half, 2);
+        break;
+    case 1:
+        s15c_dyncon_800D5F68(work, index + 4, group, time, time, half, -half, -half, -2 * time, 3);
+        break;
+    case 2:
+        s15c_dyncon_800D5F68(work, index + 4, group, 2 * time, -half, -half, time, -half, -2 * time, 3);
+        break;
+    case 3:
+        s15c_dyncon_800D5F68(work, index + 4, group, time, -time, half, -time, -half, half, 2);
+        break;
+    }
+}
+
+static void DynConFall(DynCon *work, int group, int index, SVECTOR *position)
+{
+    static const SVECTOR positions[4] = {
+        {-4000, 750, -3500, 0}, {8000, 750, -750, 0}, {-8000, 750, 5000, 0}, {4000, 750, 8000, 0}};
+    static const SVECTOR rotations[4] = {
+        {896, 1024, -512, 0}, {896, 2048, -512, 0}, {896, 1024, -512, 0}, {896, -1024, 512, 0}};
+    DynConCollapseSound(work, position);
+    DynConRotateFalling(work, group, index);
+    s15c_dyncon_800D6070(work, index + 4, group);
+    if (--work->field_3F10[group] == 0)
+    {
+        work->field_3F10[group] = 8;
+        work->field_3F20[group]++;
+        s15c_dyncon_800D5EA8(work, group, rotations[group].vx, rotations[group].vy, rotations[group].vz,
+                             positions[group].vx, positions[group].vy, positions[group].vz);
+        if (work->field_4050 == 1)
+            GM_SeSet(&work->entries[index + 4].position, 41);
+    }
+}
