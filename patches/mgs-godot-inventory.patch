+#ifdef MGS_GODOT_SCENE
+static void PublishWeapon(int x, int y, const PANEL *source)
+{
+    int id = source->field_0_id;
+    MgsInventoryPanel panel = {.side = 1, .id = id, .x = x + 4, .y = y, .quantity = source->field_2_num};
+    const char *name = "NO ITEM";
+    if (source->field_4_pos) panel.flags |= MGS_INVENTORY_DIM;
+    else if (!source->field_6_current) panel.flags |= MGS_INVENTORY_HIGHLIGHT;
+    if (id >= 0) {
+        panel.icon = id == WP_Socom && !GM_SilencerFlag ? 2 : gMenuWeaponRpkInfo_8009E57C[id].field_4_rpk_idx;
+        name = id == WP_Famas && GM_GameLevel == GM_LEVEL_VERYEASY ? "MP 5 SD" : gMenuWeaponRpkInfo_8009E57C[id].field_0_weapon_name;
+        if (menu_weapon_isWeaponDisabled_8003DF30(id)) panel.flags |= MGS_INVENTORY_DISABLED;
+        if (source->field_2_num >= 0 && source->field_2_num < 10000) {
+            panel.flags |= MGS_INVENTORY_COUNT;
+            panel.maximum = GM_WeaponsMax[id];
+        }
+        if (source->field_6_current && GM_MagazineMax > 0) {
+            panel.flags |= MGS_INVENTORY_MAGAZINE;
+            panel.magazine = GM_Magazine;
+            panel.magazine_max = GM_MagazineMax;
+            panel.burst = GM_Weapon == WP_Famas ? 3 : 0;
+        }
+    }
+    MgsGodotSubmitInventoryPanel(panel, name);
+}
+#endif
