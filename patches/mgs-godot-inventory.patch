  * @param ypos The y-coordinate where the item should be drawn.
  * @param pMenuSub Pointer to the current item in the inventory.
  */
+#ifdef MGS_GODOT_SCENE
+static void PublishItem(int x, int y, const PANEL *source)
+{
+    int id = source->field_0_id;
+    MgsInventoryPanel panel = {.id = id, .x = x, .y = y, .quantity = source->field_2_num};
+    const char *name = "NO ITEM";
+    if (source->field_4_pos) panel.flags |= MGS_INVENTORY_DIM;
+    else if (!source->field_6_current) panel.flags |= MGS_INVENTORY_HIGHLIGHT;
+    if (id >= 0) {
+        panel.icon = gMenuItemRpkInfo_8009E484[id].field_4_rpk_idx;
+        name = gMenuItemRpkInfo_8009E484[id].field_0_weapon_name;
+        if (is_disable_item(id)) panel.flags |= MGS_INVENTORY_DISABLED;
+        if (GM_FrozenItemsState == 1 && (id == IT_Ration || id == IT_Ketchup)) panel.flags |= MGS_INVENTORY_FROZEN;
+        if (GM_ItemTypes[id + 1] & IT_TYPE_CONSUMABLE) {
+            panel.flags |= MGS_INVENTORY_COUNT;
+            panel.maximum = GM_ItemsMax[id - IT_Ration];
+        } else if (id == IT_Card) {
+            panel.flags |= MGS_INVENTORY_LEVEL;
+            panel.level = GM_Items[IT_Card];
+        } else if (id == IT_TimerBomb) {
+            panel.flags |= MGS_INVENTORY_TIMER;
+            panel.quantity = GM_Items[id];
+        }
+    }
+    MgsGodotSubmitInventoryPanel(panel, name);
+}
+#endif
