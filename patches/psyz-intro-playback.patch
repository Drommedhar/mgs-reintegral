 #include <SDL3/SDL.h>
 #include <stdbool.h>
 #include <stdio.h>
+#include <stdlib.h>
 
 #define N_CHANNELS 2
 #define SAMPLE_SIZE sizeof(short)
+#define BUFFER_FRAMES 2048
 
 static SDL_AudioStream* sdl_stream;
 static SDL_Mutex* mutex;
+static void (*service_tasks)(void);
+static bool pumping;
+static bool queued_once;
 
+#ifndef PSYZ_POLL_IRQ_ONLY
 // Audio callback: SDL pulls audio from the SPU via this callback.
 // The audio driver synchronizes the SPU based on the pulled samples.
 static void SDLCALL audio_callback(void* userdata, SDL_AudioStream* stream,
@@ -32,6 +38,43 @@ static void SDLCALL audio_callback(void* userdata, SDL_AudioStream* stream,
