+        SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec,
+#ifdef PSYZ_POLL_IRQ_ONLY
+        NULL,
+#else
+        audio_callback,
+#endif
+        NULL);
     if (!sdl_stream) {
         ERRORF("failed to open audio device: %s", SDL_GetError());
         SDL_DestroyMutex(mutex);
@@ -85,6 +134,8 @@ void Psyz_AudioDestroy(void) {
         mutex = NULL;
     }
     is_audio_init = false;
+    service_tasks = NULL;
+    pumping = queued_once = false;
 }
 
