+
+void Psyz_AudioSetServiceCallback(void (*service)(void)) {
+    service_tasks = service;
+}
+
+void Psyz_AudioPump(void) {
+#ifdef PSYZ_POLL_IRQ_ONLY
+    if (!sdl_stream || pumping || SDL_AudioStreamDevicePaused(sdl_stream)) {
+        return;
+    }
+    int queued = SDL_GetAudioStreamQueued(sdl_stream);
+    if (queued < 0) {
+        ERRORF("cannot query queued audio: %s", SDL_GetError());
+        abort();
+    }
+    int frames = BUFFER_FRAMES - queued / (N_CHANNELS * SAMPLE_SIZE);
+    if (frames <= 0) {
+        return;
+    }
+    if (!queued && queued_once) {
+        WARNF("audio queue exhausted before game-thread refill");
+    }
+    short buffer[BUFFER_FRAMES * N_CHANNELS];
+    pumping = true;
+    SDL_LockMutex(mutex);
+    Psyz_SpuPullSamplesServiced(buffer, frames, service_tasks);
+    SDL_UnlockMutex(mutex);
+    if (!SDL_PutAudioStreamData(sdl_stream, buffer,
+                               frames * N_CHANNELS * SAMPLE_SIZE)) {
+        ERRORF("cannot queue generated audio: %s", SDL_GetError());
+        abort();
+    }
+    queued_once = true;
+    pumping = false;
+#endif
+}
 
