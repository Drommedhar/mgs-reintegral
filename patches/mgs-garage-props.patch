+    CompMatrix(work->root_matrix, &matrix, &GM_PlayerBody->objs->world);
+    v32 = GM_PlayerControl;
+    GM_PlayerControl->mov.vx = work->body.objs->world.t[0];
+    v32->mov.vy = work->body.objs->world.t[1];
+    v33 = GarageGunWorld;
+    v32->mov.vz = work->body.objs->world.t[2];
+    GM_GetHomingTarget2(v33, work->field_8CC.vy, &yaw, &pitch, GM_CurrentMap, 6000, 128);
+    objs = GM_PlayerBody->objs;
+    v35 = GM_PlayerBody->objs->world.m[0][2];
+    output.vy = 0;
+    output.vx = v35;
+    output.vz = objs->world.m[2][2];
+    Square0(&output, &output);
+    v36 = SquareRoot0(output.vx + output.vz);
+    v37 = -ratan2(objs->world.m[1][2], v36);
+    v38 = 0;
+    if (yaw != -1)
+        v38 = pitch - v37;
+    work->aim.vx = GV_NearExp4(work->aim.vx, v38);
+}
+
+void Garage_800DB510(GarageSnake *work)
+{
+    Garage_800DAE40(work);
+    Garage_800DAD68(work);
+}
