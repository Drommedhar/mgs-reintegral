+static void MakeNoise(Work *work, int count)
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+    {
+        int left = GV_RandU(256) - 128;
+        int right = left + GV_RandU(16);
+        int top = GV_RandU(256) - 128;
+        int color = GV_RandU(16) + 8;
+        POLY_FT4 *poly = &work->field_85CC[i];
+
+        setXY4(poly, left, top, right, top, left, top + 1, right, top + 1);
+        setRGB0(poly, color, color, color);
+        work->z_A8DF[i] = 3;
+    }
+}
+
+static void DistortPicture(Work *work, int frame)
+{
+    int count = BrfScenePacketCounts[work->field_A588];
+    int i;
+
+    work->field_A50C = (POLY_FT4 *)((unsigned char *)PACK_ADDR0 + 50 * 1024);
+    for (i = 0; i < count; i++)
+    {
+        POLY_FT4 *poly = &work->field_A50C[i];
+        int left, right, top, bottom;
+
+        *poly = work->field_28C[i];
+        left = poly->x0;
+        right = poly->x3;
+        top = poly->y0;
+        bottom = poly->y3;
+        if (frame < 3)
+        {
+            int shift = work->field_ADC0 * frame;
+            left = left * (22 - frame) / 20;
+            right = right * (22 - frame) / 20;
+            top += shift;
+            bottom += shift;
+        }
+        setXY4(poly, left, top, right, top, left, bottom, right, bottom);
+        poly->r0 = poly->r0 * (frame + 4) / 8;
+        poly->g0 = poly->g0 * (frame + 4) / 8;
+        poly->b0 = poly->b0 * (frame + 4) / 8;
+    }
+}
+
+static void JitterPicture(Work *work)
+{
+    int x, y, i;
+
+    do
+    {
+        x = GV_RandU(4) - 2;
+    } while (x == 0);
+    do
+    {
+        y = GV_RandU(4) - 2;
+    } while (y == 0);
+    for (i = 0; i < BrfScenePacketCounts[work->field_A588]; i++)
+    {
+        POLY_FT4 *poly = &work->field_A50C[i];
+        int left, right, top, bottom;
+
+        *poly = work->field_28C[i];
+        left = poly->x0 + x;
+        right = poly->x3 + x;
+        top = poly->y0 + y;
+        bottom = poly->y3 + y;
+        setXY4(poly, left, top, right, top, left, bottom, right, bottom);
+    }
+}
+
+int brf_800CD164(Work *work)
+{
+    int frame = work->field_ADB8;
+
+    if (work->field_ADBC == 0)
+    {
+        if (frame < 5)
+        {
+            DistortPicture(work, frame);
+        }
+        if (frame < 7)
+        {
+            MakeNoise(work, frame < 5 ? 200 : 200 * (7 - frame) / 3);
+        }
+    }
+    else if (work->field_ADBC == 1 && frame <= 0)
+    {
+        JitterPicture(work);
+    }
+    return ++work->field_ADB8;
+}
+
+static void StopScreen(Work *work)
+{
+    int i;
+
+    work->z_A590[4] = 14;
+    BrfSetTexture(&work->field_34[0], DG_GetTexture(GV_StrCode("stop")));
+    work->z_A9A7[0] = 2;
+    for (i = 1; i < 15; i++)
+    {
+        work->z_A9A7[i] = 0;
+    }
+    for (i = 0; i < BrfScenePacketCounts[work->field_A588]; i++)
+    {
+        work->z_A597[i] = 0;
+    }
+}
+
+static void FadeStopScreen(Work *work, int frame)
+{
+    int elapsed = frame - 63;
+    int color = 128 - 4 * elapsed;
+    POLY_FT4 *scanline = &((POLY_FT4 *)work->field_24->packs[GV_Clock])[1];
+
+    setRGB0(&work->field_34[0], color, color, color);
+    work->field_A510[4].g0 = 46 - 46 * elapsed / 32;
+    work->field_A510[4].b0 = 52 - 52 * elapsed / 32;
+    work->field_A510[4].r0 = 59 - 59 * elapsed / 32;
+    setRGB0(scanline, 64 - 2 * elapsed, 64 - 2 * elapsed, 64 - 2 * elapsed);
+}
+
+BOOL brf_800CF5A8(Work *work)
+{
+    int frame, i;
+
+    if (work->field_AD5C)
+    {
+        work->field_AD5C = 0;
+        work->field_AD2C = 0;
+        GM_SetSound(33554187, 0);
+        GM_SeSet2(0, 63, 192);
+        work->field_ADB8 = 0;
+        work->field_ADBC = 0;
+        work->field_ADC4 = 1;
+    }
+    frame = work->field_AD2C;
+    if (frame < 3)
+    {
+        for (i = 0; i < BrfScenePacketCounts[work->field_A588]; i++)
+        {
+            if (work->z_A597[i])
+            {
+                brf_800CDC8C(work, &work->field_28C[i]);
+            }
+        }
+    }
+    else if (frame == 3)
+    {
+        StopScreen(work);
+    }
+    else if (frame == 33)
+    {
+        BrfSetTexture(&work->field_34[0], DG_GetTexture(GV_StrCode("eject")));
+    }
+    else if (frame >= 64 && frame < 96)
+    {
+        FadeStopScreen(work, frame);
+    }
+    if (++work->field_AD2C < 34)
+    {
+        work->field_ADB8 = 0;
+        return 1;
+    }
+    return 0;
+}
