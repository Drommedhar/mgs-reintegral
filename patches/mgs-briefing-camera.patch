+
+void *CameraAlbumPacket(MenuPrim *prim, size_t size)
+{
+    void *packet = prim->next;
+    if (prim->next > prim->end || size > (size_t)(prim->end - prim->next))
+    {
+        fprintf(2, "Photo album primitive buffer exhausted\n");
+        abort();
+    }
+    prim->next += size;
+    return packet;
+}
+
+void CameraSelectFontPage(MenuPrim *prim)
+{
+    DR_TPAGE *page = CameraAlbumPacket(prim, sizeof(*page));
+    setDrawTPage(page, 0, 1, getTPage(0, 0, 960, 256));
+    addPrim(prim->ot, page);
+}
+
+static void CameraCardPage(CameraWork *work)
+{
+    DR_TPAGE *page;
+    camera_800C6054(&work->field_700, work->prims.ot, NULL);
+    page = CameraAlbumPacket(work->field_700.prim, sizeof(*page));
+    setDrawTPage(page, 1, 0, getTPage(0, 1, 960, 256));
+    addPrim(work->prims.ot, page);
+}
+
+static void CameraClosePhoto(CameraWork *work)
+{
+    GM_SeSet2(0, 63, 33);
+    if (work->f49E0)
+    {
+        work->f28 = 7;
+        work->field_498C = 0;
+        work->field_4938 = 0;
+        camera_800C864C(work);
+    }
+    else
+    {
+        work->f28 = 0;
+        camera_800C864C(work);
+        work->field_4938 = 0;
+        GV_FreeMemory(2, camera_dword_800D0704);
+        camera_800C82EC();
+    }
+}
+
+static void CameraChooseAction(CameraWork *work)
+{
+    int action = work->f2C, i;
+    if (action == 2 || action == 6)
+        CameraClosePhoto(work);
+    else if (action == 0 || action == 3)
+    {
+        GM_SeSet2(0, 63, 32);
+        work->f28 = 4;
+        work->field_493C = action == 3 ? 3 : 0;
+        work->field_4938 = work->name_cursor = 0;
+        memcpy(work->original_name, work->photo_name, 16);
+        camera_800C869C(work);
+        work->f49E0 = 1;
+    }
+    else if (action == 1 || action == 4)
+    {
+        GM_SeSet2(0, 63, 32);
+        work->f28 = 5;
+        work->field_4944 = action == 4 ? 3 : 0;
+        work->field_4938 = 0;
+        camera_800C869C(work);
+        work->f49E0 = 1;
+        work->field_4974 = work->adjustment[0];
+        work->field_4978 = work->adjustment[1];
+        work->field_497C = work->adjustment[2];
+        for (i = 0; i < 3; ++i)
+            work->color[i] = 255 * (work->adjustment[i] + 100) / 200;
+    }
+    else if (action == 5)
+    {
+        GM_SeSet2(0, 63, 32);
+        work->f28 = 6;
+        work->field_49B8 = work->field_4938 = 0;
+        camera_800C869C(work);
+        work->f49E0 = 1;
+    }
+}
+
+void camera_800CCBB0(CameraWork *work)
+{
+    static const short x[7] = {-144, -5, 90, -144, -42, 17, 100};
+    static const short width[7] = {112, 68, 54, 104, 60, 84, 44};
+    int action = work->f2C, next = action;
+    unsigned int press = work->pad->press;
+    if (press & 0x40)
+        CameraClosePhoto(work);
+    else if (press & 0x20)
+        CameraChooseAction(work);
+    else
+    {
+        if (press & PAD_LEFT)
+        {
+            if (action == 1 || action == 2 || action == 4 || action == 5 || action == 6)
+                next = action - 1;
+        }
+        else if (press & PAD_RIGHT)
+        {
+            if (action == 0 || action == 1 || action == 3 || action == 4 || action == 5)
+                next = action + 1;
+        }
+        if (next != action)
+        {
+            GM_SeSet2(0, 63, 31);
+            work->f2C = next;
+            camera_800C86BC(work, x[next], 90, width[next], 12, 255, 0);
+        }
+    }
+}
+
+static void CameraOpenPhoto(CameraWork *work)
+{
+    static const short ghost_x[4] = {-144, -42, 17, 100};
+    static const short ghost_width[4] = {104, 60, 84, 44};
+    int i, ghost;
+    camera_800C4394(work);
+    ghost = work->field_4934 != 0;
+    work->f28 = 3;
+    work->f2C = ghost ? 3 : 0;
+    for (i = 0; i < (ghost ? 4 : 3); ++i)
+        work->field_688[(ghost ? 16 : 2) + i] = 512;
+    work->field_4938 = 0;
+    work->field_688[0] = work->field_688[1] = work->field_688[5] = 1536;
+    work->field_688[6] = work->field_688[7] = 1536;
+    camera_800C86BC(work, -144, 90, ghost ? 104 : 112, 12, 255, 0);
+    if (ghost)
+        for (i = 0; i < 4; ++i)
+            setXYWH(&work->polys2[16 + i], ghost_x[i], 90, ghost_width[i], 12);
+}
+
+void camera_800CDF18(CameraWork *work)
+{
+    int result;
+    switch (work->f28)
+    {
+    case 0:
+        result = camera_800C73E4(&work->field_700, &GV_PadData[2]);
+        if (result == 1)
+            work->f28 = 9;
+        if (result == 2)
+        {
+            work->f28 = 1;
+            work->f49E0 = 0;
+            memset(work->photo_name, ' ', 16);
+            memset(work->original_name, ' ', 16);
+            work->photo_name[16] = work->original_name[16] = 0;
+        }
+        break;
+    case 1: CameraOpenPhoto(work); break;
+    case 3: CameraDrawPhotoName(work); camera_800CCBB0(work); break;
+    case 4: CameraDrawPhotoName(work); camera_800CA918(work); break;
+    case 5: CameraDrawPhotoName(work); camera_800CC3C8(work); break;
+    case 6: camera_800CBDE4(work); break;
+    case 7: camera_800CD198(work); break;
+    case 8:
+        camera_800CDCA4(work);
+        if (work->field_49D0 < 2)
+            CameraCardPage(work);
+        else
+            --work->field_49D0;
+        break;
+    case 9:
+        GCL_ExecProc(work->f20, NULL);
+        GV_DestroyActor(&work->actor);
+        break;
+    }
+}
+
+static void CameraConfirmText(int selected)
+{
+    MENU_Locate(100, 50, 16);
+    MENU_Color(86, 137, 116);
+    MENU_Printf("OVERWRITE OK?");
+    MENU_Locate(100, 105, 16);
+    if (selected == 1)
+        MENU_Color(192, 192, 192);
+    else
+        MENU_Color(46, 72, 61);
+    MENU_Printf("YES");
+    MENU_Locate(200, 105, 16);
+    if (selected == 1)
+        MENU_Color(46, 72, 61);
+    else
+        MENU_Color(192, 192, 192);
+    MENU_Printf("NO");
+}
+
+static void CameraConfirmIntro(CameraWork *work)
+{
+    int frame = work->field_4938;
+    if (frame < 10)
+    {
+        MENU_Locate(100, frame < 5 ? 90 : 90 - 8 * (frame - 4), 16);
+        MENU_Color(86, 137, 116);
+        MENU_Printf("OVERWRITE OK?");
+    }
+    else
+        CameraConfirmText(2);
+    if (frame <= 10)
+        camera_800CD0A0(&work->prims, 92, 85, 130, 15);
+    else if (frame < 14)
+        camera_800CD0A0(&work->prims, 32 * (frame - 10) + 92,
+                       5 * (frame - 10) + 85, 130 - 30 * (frame - 10), 15);
+    else
+    {
+        work->field_498C = 2;
+        camera_800CD0A0(&work->prims, 188, 100, 40, 15);
+        drawCaption_800C5EB4(&work->field_700, work->f49E4);
+        work->field_49D0 = 3;
+    }
+}
+
+void camera_800CD198(CameraWork *work)
+{
+    int selected = work->field_498C;
+    unsigned int press = work->pad->press;
+    if (selected == 0)
+    {
+        CameraConfirmIntro(work);
+        return;
+    }
+    if (selected != 1 && selected != 2)
+        return;
+    CameraConfirmText(selected);
+    camera_800CD0A0(&work->prims, selected == 1 ? 92 : 188, 100, 40, 15);
+    CameraCardPage(work);
+    if (press & (selected == 1 ? PAD_RIGHT : PAD_LEFT))
+    {
+        work->field_498C = 3 - selected;
+        GM_SeSet2(0, 63, 31);
+    }
+    else if (selected == 1 && (press & 0x20))
+    {
+        work->f28 = 8;
+        work->field_49C8 = 0;
+        GM_SeSet2(0, 63, 32);
+    }
+    else if ((press & 0x40) || (selected == 2 && (press & 0x20)))
+    {
+        GM_SeSet2(0, 63, 33);
+        work->f28 = 0;
+        GV_FreeMemory(2, camera_dword_800D0704);
+        camera_800C82EC();
+    }
+}
+
+static void CameraWritePhoto(CameraWork *work)
+{
+    memcard_write(work->field_49CC->port, camera_dword_800D0710, 0,
+                  (char *)camera_dword_800D0704, 0x4000);
+    while (memcard_status() > 0)
+        mts_wait_vbl(2);
+    if (memcard_status() == 0)
+    {
+        work->field_49C8 = 4;
+        work->field_4938 = 0;
+        drawCaption_800C5EB4(&work->field_700, camera_dword_800C3914[2]);
+        work->field_49D0 = 3;
+    }
+}
+
+void camera_800CDCA4(CameraWork *work)
+{
+    CameraConfirmText(1);
+    camera_800CD0A0(&work->prims, 92, 100, 40, 15);
+    switch (work->field_49C8)
+    {
+    case 0:
+        drawCaption_800C5EB4(&work->field_700, camera_dword_800C3914[0]);
+        work->field_49D0 = 1;
+        camera_800CDAB4(work);
+        break;
+    case 1:
+        if (!memcard_delete((unsigned char)camera_dword_800D0708, camera_dword_800D0710))
+        {
+            drawCaption_800C5EB4(&work->field_700, camera_dword_800C3914[1]);
+            work->field_49D0 = 3;
+        }
+        else
+        {
+            work->field_49CC = memcard_files((unsigned char)camera_dword_800D0708);
+            work->field_49C8 = 2;
+        }
+        break;
+    case 2:
+        camera_800CD790(work);
+        work->field_49C8 = 3;
+        break;
+    case 3: CameraWritePhoto(work); break;
+    case 4:
+    case 5:
+        if (work->field_4938 >= 30)
+        {
+            work->f28 = 0;
+            GV_FreeMemory(2, camera_dword_800D0704);
+            camera_800C82EC();
+        }
+        break;
+    }
+}
