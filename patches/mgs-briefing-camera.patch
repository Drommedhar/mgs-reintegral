+static void DrawDigit(POLY_FT4 *poly, DG_TEX *texture, int digit)
+{
+    int width = texture->w + 1;
+    int u = texture->off_x;
+    int v = texture->off_y;
+    int bottom = v + texture->h + 1;
+    int left = u + width * digit / 10;
+    int right = u + width * (digit + 1) / 10;
+
+    setUV4(poly, left, v, right, v, left, bottom, right, bottom);
+    poly->tpage = texture->tpage;
+    poly->clut = texture->clut;
+}
+
+static int DrawBounds(Work *work, DG_TEX *texture, int left, int top, int right, int bottom)
+{
+    static const int slots[6] = {5, 6, 9, 10, 13, 14};
+    int x = (right + left + 300) / 10;
+    int y = (bottom + top + 250) / 10;
+    int width = (right - left) / 10;
+    int digits[6];
+    int i;
+
+    digits[0] = x / 10;
+    digits[1] = x % 10;
+    digits[2] = y / 10;
+    digits[3] = y % 10;
+    digits[4] = width / 10;
+    digits[5] = width % 10;
+    for (i = 0; i < 6; i++)
+    {
+        DrawDigit(&work->field_34[slots[i]], texture, brf_800CC5CC(digits[i]));
+    }
+    return texture->clut;
+}
+
+int brf_800CC5E4(Work *work, POLY_FT4 *first, POLY_FT4 *second)
+{
+    DG_TEX *texture = DG_GetTexture(GV_StrCode("0123"));
+    int left = first->x0 < second->x0 ? first->x0 : second->x0;
+    int top = first->y0 < second->y0 ? first->y0 : second->y0;
+    int right = first->x1 > second->x1 ? first->x1 : second->x1;
+    int bottom = first->y2 > second->y2 ? first->y2 : second->y2;
+
+    return DrawBounds(work, texture, left, top, right, bottom);
+}
+
+int brf_800CCBD4(Work *work, POLY_FT4 *poly)
+{
+    DG_TEX *texture = DG_GetTexture(GV_StrCode("0123"));
+    return DrawBounds(work, texture, poly->x0, poly->y0, poly->x1, poly->y2);
+}
+
+void brf_800CDAEC(POLY_FT4 *packets, int count, int *data, int x, int y, int scale, int divisor)
+{
+    int i;
+
+    for (i = 0; i < count; i++, data += 3)
+    {
+        POLY_FT4 *poly = &packets[data[0]];
+        int left = (short)data[1];
+        int top = (short)((unsigned int)data[1] >> 16);
+        int right = (short)data[2];
+        int bottom = (short)((unsigned int)data[2] >> 16);
+
+        left = (left + x) * scale / divisor - x;
+        top = (top + y) * scale / divisor - y;
+        right = (right + x) * scale / divisor - x;
+        bottom = (bottom + y) * scale / divisor - y;
+        setXY4(poly, left, top, right, top, left, bottom, right, bottom);
+    }
+}
+
+int brf_800CF4E0(Work *work, int stop, int limit, int x, int y, int divisor, int count, int *data)
+{
+    int frame = work->field_AD38;
+
+    if (!stop || frame < limit)
+    {
+        brf_800CDAEC(work->field_28C, count, data, x, y, frame + divisor, divisor);
+    }
+    else if (frame == limit)
+    {
+        work->field_ADB8 = 0;
+        work->field_ADBC = 1;
+    }
+    return ++work->field_AD38;
+}
