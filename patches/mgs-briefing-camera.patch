+        slot = AddText(work, slot, 1, 29, 54);
+        first = 2;
+        count = 38;
+        x = -150;
+        y = 20;
+    }
+    else if (type == 5)
+    {
+        slot = AddText(work, slot, 40, -85, 40);
+        slot = AddText(work, slot, 41, -109, 54);
+        first = 42;
+        count = 14;
+        x = -56;
+        y = 20;
+    }
+    else
+    {
+        slot = AddImage(work, slot, "liquid_simon_waku", 18, 27, 54, 70, 1);
+        slot = AddImage(work, slot, "liquid_simon_waku", 76, 27, 112, 70, 1);
+        slot = AddImage(work, slot, "c_face_open_u", -127, -104, 127, 0, 1);
+        slot = AddImage(work, slot, "c_face_d", -127, 0, 127, 88, 1);
+        slot = AddText(work, slot, 68, -113, 54);
+        first = 69;
+        count = 34;
+        x = -60;
+        y = 10;
+    }
+    for (i = 0; i < count; i++)
+    {
+        slot = AddText(work, slot, first + i, x, y);
+    }
