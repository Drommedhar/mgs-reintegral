+    POLY_FT4 *panel;
+    setTile(tile);
+    setRGB0(tile, 0, 0, 0);
+    setXY0(tile, 0, 200);
+    setWH(tile, 210, 18);
+    addPrim(prim->ot, tile);
+    panel = CameraAlbumPacket(prim, sizeof(*panel));
+    LSTORE(0x80808080, &panel->r0);
+    setXYWH(panel, 160 - (width >> 1), y, width, height);
+    setUV4(panel, 0, 200, 210, 200, 0, 218, 210, 218);
+    panel->tpage = GV_Clock ? 293 : 288;
+    setPolyFT4(panel);
+    setSemiTrans(panel, 1);
+    addPrim(prim->ot, panel);
+}
+
+static void CameraFileText(MenuPrim *prim, MENU_CURPOS *entry, int width)
+{
+    TextConfig text = {0};
+    char label[32], time[6];
+    int blocks = (unsigned char)camera_dword_800D072C->blocks_count;
+    text.color = 0x66748956;
+    if ((unsigned int)entry->num >= 16)
+    {
+        text.xpos = width >> 1;
+        text.ypos = 208;
+        text.flags = 2;
+        CameraFormat(label, sizeof(label), "NEW FILE [ NEED %d BLOCK%s ]", blocks, blocks > 1 ? "S" : "");
+        _menu_number_draw_string2(prim, &text, label);
+        return;
+    }
+    text.xpos = 178;
+    text.ypos = 203;
+    if (entry->mes[0] == 'G')
+    {
+        CameraFormat(label, sizeof(label), "DISC %d", (((unsigned char)entry->mes[5] - 64) >> 3) + 1);
+        _menu_number_draw_string(prim, &text, label);
+    }
+    else
+        _menu_number_draw_string(prim, &text, "TIME");
+    text.xpos = 180;
+    text.ypos = 210;
+    time[0] = entry->mes[1];
+    time[1] = entry->mes[2];
+    time[2] = ':';
+    time[3] = entry->mes[3];
+    time[4] = entry->mes[4];
+    time[5] = 0;
+    _menu_number_draw_string(prim, &text, time);
+}
+
+static void CameraFileSprite(MenuPrim *prim, u_long *ot, int row)
+{
+    SPRT *sprite = CameraAlbumPacket(prim, sizeof(*sprite));
+    DR_TPAGE *page;
+    camera_800C5D2C(sprite);
+    setUV0(sprite, row < 4 ? 0 : 128, 274 + 14 * (row < 4 ? row : row - 4));
+    setWH(sprite, 128, 14);
+    setXY0(sprite, 0, 205);
+    addPrim(ot, sprite);
+    page = CameraAlbumPacket(prim, sizeof(*page));
+    setDrawTPage(page, 0, 1, getTPage(0, 1, 960, 256));
+    addPrim(prim->ot, page);
+}
+
+static void CameraFileBorders(MenuPrim *prim, int width, int bottom)
+{
+    int i, x = -(width + 10) / 2;
+    for (i = 0; i < 2; ++i)
+    {
+        LINE_F2 *line = CameraAlbumPacket(prim, sizeof(*line));
+        setXY2(line, x + 160, 78, x + 160, bottom + 4);
+        LSTORE(0x748956, &line->r0);
+        setLineF2(line);
+        setSemiTrans(line, 1);
+        addPrim(prim->ot, line);
+        x += width + 10;
+    }
+}
+
+static void CameraFileCapacity(MenuWork *work, SELECT_INFO *info)
+{
+    TextConfig text = {0};
+    char label[32];
+    int blocks = camera_dword_800D0748[camera_dword_800C3880]->free_blocks;
+    text.xpos = camera_dword_800D0754->max_num == 1 ? 160 : (camera_dword_800C3880 ? 224 : 96);
+    text.ypos = 68;
+    text.flags = 2;
+    text.color = 0x66748956;
+    CameraFormat(label, sizeof(label), "FREE: %d BLOCK%s", blocks, blocks > 1 ? "S" : "");
+    _menu_number_draw_string2(work->prim, &text, label);
+    if (GV_Time % 32 >= 11)
+    {
+        if (info->top > 0)
+            menu_draw_triangle(work->prim, &camera_dword_800C38A4);
+        if (info->top + 6 < (unsigned char)info->max_num)
+            menu_draw_triangle(work->prim, &camera_dword_800C38B4);
+    }
+}
+
+void camera_800C6110(MenuWork *work, u_long *ot, SELECT_INFO *info)
+{
+    int row, entry, height, collapsed_height, width = 210, y = 80;
+    int count = (unsigned char)info->max_num - info->top;
+    if (!info->max_num)
+        return;
+    if (count > 6)
+        count = 6;
+    if (info->open_count > 0)
+    {
+        if (--info->open_count >= 5)
+            return;
+        width = 52 * (4 - info->open_count);
+    }
+    collapsed_height = info->field_18 ? 18 : 0;
+    if (info->field_18 > 0)
+        collapsed_height = 4 * --info->field_18;
+    for (row = 0; row < count; ++row)
+    {
+        entry = info->top + row;
+        height = entry == info->current ? 18 : collapsed_height;
+        CameraFileBackdrop(work->prim, y, width, height);
+        if (entry == info->current && info->enable)
+            camera_800C5B00(160, y + 9, info->height, 16, 2);
+        y += height;
+        CameraFileText(work->prim, &info->menu[entry], width);
+        CameraFileSprite(work->prim, ot, row);
+    }
+    CameraFileBorders(work->prim, width, y);
+    if (info->field_18 < 0)
+        CameraFileCapacity(work, info);
+}
