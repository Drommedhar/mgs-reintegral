+static const BiographyLine biography_lines[] = {
+    {53, 54, 32, 32},     {77, 79, 32, 56},     {91, 93, 32, 67},     {101, 103, 32, 74},   {126, 128, 32, 96},
+    {143, 148, 56, 110},  {156, 158, 67, 117},  {181, 183, 74, 139},  {208, 210, 96, 163},  {237, 239, 110, 189},
