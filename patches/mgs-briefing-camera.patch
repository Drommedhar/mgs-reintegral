+        {
+            work->z_A597[panel->polygon] = 9;
+            work->z_A597[panel->polygon + 1] = 10;
+            if (i > 0)
+                for (int j = 0; j < panels[i - 1].glyph_count; ++j)
+                    work->z_A597[panels[i - 1].first_glyph + j] = 0;
+            GM_SeSet2(0, 63, 187);
