@@ -0,0 +1,105 @@
+#include "graph_native.h"
+
+void BrfSetTexture(POLY_FT4 *poly, DG_TEX *texture)
+{
+    int u = texture->off_x;
+    int v = texture->off_y;
+    int right = u + texture->w + 1;
+    int bottom = v + texture->h + 1;
+
+    setUV4(poly, u, v, right, v, u, bottom, right, bottom);
+    poly->tpage = texture->tpage;
+    poly->clut = texture->clut;
+}
+
+static void ChangeFog(Work *work, POLY_FT4 *poly, int phase, int white, int second)
+{
+    static const char *normal[2][2] = {{"a_fog_normal_3", "a_fog_normal_1"},
+                                       {"a_fog_normal_4", "a_fog_normal_2"}};
+    static const char *pale[2][3] = {{"a_fog_haku_3", "a_fog_haku_2", "a_fog_haku_1"},
+                                     {"a_fog_haku_1", "a_fog_haku_3", "a_fog_haku_2"}};
+    const char *name;
+
+    if (phase < 1 || phase > (white ? 3 : 2))
+    {
+        return;
+    }
+    name = white ? pale[second][phase - 1] : normal[second][phase - 1];
+    BrfSetTexture(poly, brf_800CABF4(work, GV_StrCode(name)));
+    if (second)
+    {
+        work->field_AD74 = white ? (phase == 1 ? 2 : 3) : 3 - phase;
+    }
+}
+
+static void FadeFog(Work *work, int first, int second, int white)
+{
+    POLY_FT4 *a = &work->field_28C[first];
+    POLY_FT4 *b = &work->field_28C[second];
+    int frame = work->field_AD38;
+    int level;
+
+    if (frame < 32)
+    {
+        level = 4 * frame;
+        setRGB0(a, 128 - level, 128 - level, 128 - level);
+        setRGB0(b, level, level, level);
+        work->field_AD38++;
+    }
+    else if (frame == 32)
+    {
+        ChangeFog(work, a, work->field_AD74, white, 0);
+        setRGB0(a, 0, 0, 0);
+        setRGB0(b, 128, 128, 128);
+        work->field_AD38++;
+    }
+    else if (frame < 64)
+    {
+        level = 4 * (frame - 32);
+        setRGB0(a, level, level, level);
+        setRGB0(b, 128 - level, 128 - level, 128 - level);
+        work->field_AD38++;
+    }
+    else if (frame == 64)
+    {
+        ChangeFog(work, b, work->field_AD74, white, 1);
+        work->field_AD38 = 0;
+        setRGB0(a, 128, 128, 128);
+        setRGB0(b, 0, 0, 0);
+    }
+}
+
+void brf_800CAE84(Work *work, int first, int second)
+{
+    FadeFog(work, first, second, 0);
+}
+
+void brf_800CB23C(Work *work, int first, int second)
+{
+    FadeFog(work, first, second, 0);
+}
+
+void brf_800CB5F4(Work *work, int first, int second)
+{
+    FadeFog(work, first, second, 1);
+}
+
+int brf_800CBE34(Work *work, POLY_FT4 *poly)
+{
+    int frame = work->field_AD30 % 128;
+    const char *name = NULL;
+
+    if (frame >= 0 && frame <= 24 && frame % 6 == 0)
+    {
+        name = "b_face_open_u";
+    }
+    else if (frame >= 3 && frame <= 21 && frame % 6 == 3)
+    {
+        name = "b_face_angry_piku";
+    }
+    if (name)
+    {
+        BrfSetTexture(poly, brf_800CABF4(work, GV_StrCode(name)));
+    }
+    return ++work->field_AD30;
+}
