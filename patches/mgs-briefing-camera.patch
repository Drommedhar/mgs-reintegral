+
+unsigned char *BrfTextureCursor = (unsigned char *)MEM_BOTTOM - 0x13000;
+
+static BrfImageBits BrfBeginBits(const unsigned char *data, int bits)
+{
+    BrfImageBits stream = {data, 0, (1u << bits) - 1, bits, 32 / bits, 0};
+    return stream;
+}
+
+static unsigned int BrfReadBits(BrfImageBits *stream)
+{
+    if (!stream->remaining)
+    {
+        memcpy(&stream->word, stream->data, sizeof(stream->word));
+        stream->data += sizeof(stream->word);
+        stream->remaining = stream->count;
+    }
+    unsigned int value = stream->word & stream->mask;
+    stream->word >>= stream->bits;
+    --stream->remaining;
+    return value;
+}
+
+static void BrfDecodePixels(const BrfPackedImage *header, const unsigned char *data, unsigned char *output)
+{
+    int count_bits = header->code_bits & 15;
+    int pixel_bits = header->code_bits >> 4;
+    if (!count_bits || !pixel_bits)
+    {
+        fprintf(2, "Invalid briefing image code widths: %u\n", header->code_bits);
+        abort();
+    }
+    int           per_word = 32 / count_bits;
+    int           count_words = (header->runs + per_word - 1) / per_word;
+    BrfImageBits  counts = BrfBeginBits(data, count_bits);
+    BrfImageBits  pixels = BrfBeginBits(data + count_words * 4, pixel_bits);
+    unsigned char low = 0;
+    int           pending = 0;
+    for (int run = 0; run < header->runs; ++run)
+    {
+        unsigned int count = BrfReadBits(&counts) + 1;
+        unsigned int pixel = BrfReadBits(&pixels);
+        while (count--)
+        {
+            if (header->bytes_per_pixel)
+                *output++ = pixel;
+            else if (pending)
+            {
+                *output++ = low + (pixel << 4);
+                pending = 0;
+            }
+            else
+            {
+                low = pixel;
+                pending = 1;
+            }
+        }
+    }
+}
+
+static int BrfImageBytes(const BrfPackedImage *header)
+{
+    int width = header->width;
+    if (!(header->flags & 1))
+        width >>= 1;
+    return width * header->height + 0x210;
+}
+
+static void BrfDecodeImage(const BrfPackedImage *header, unsigned char *buffer)
+{
+    RECT *palette = (RECT *)buffer;
+    RECT *image = (RECT *)(buffer + 0x208);
+    int   width = header->width;
+    if (!(header->flags & 1))
+        width >>= 1;
+    setRECT(palette, header->palette_x, header->palette_y, header->palette_count, 1);
+    setRECT(image, header->x, header->y, width >> 1, header->height);
+    const unsigned char *colors = (const unsigned char *)(header + 1);
+    memcpy(buffer + 8, colors, header->palette_count * 2);
+    const unsigned char *codes = colors + ((header->palette_count + 1) & ~1) * 2;
+    BrfDecodePixels(header, codes, buffer + 0x210);
+}
+
+void brf_800C56C0(Work *work, void *data, int cache_id)
+{
+    const BrfPackedImage *header = data;
+    int                   allocation = (BrfImageBytes(header) / 4 + 1) * 4;
+    if (BrfTextureCursor + allocation > (unsigned char *)MEM_BOTTOM - 1)
+        BrfTextureCursor = (unsigned char *)MEM_BOTTOM - 0x13000;
+    unsigned char *buffer = BrfTextureCursor;
+    BrfTextureCursor += allocation;
+    BrfDecodeImage(header, buffer);
+    RECT *palette = (RECT *)buffer;
+    RECT *image = (RECT *)(buffer + 0x208);
+    LoadImage(palette, (u_long *)(buffer + 8));
+    LoadImage(image, (u_long *)(buffer + 0x210));
+    if (cache_id)
+        brf_800C5478(work, (unsigned short)cache_id, header->flags & 1, (header->flags & 0x30) >> 4, image, palette,
+                     palette->w);
+}
+
+void brf_800C5A68(Work *work, void *data, int cache_id)
+{
+    const BrfPackedImage *header = data;
+    int                   size = BrfImageBytes(header);
+    unsigned char        *buffer = GV_Malloc(size);
+    if (!buffer)
+    {
+        printf("Cannot Alloc Expansion Memory! size = %d\n", size);
+        return;
+    }
+    BrfDecodeImage(header, buffer);
+    RECT *palette = (RECT *)buffer;
+    RECT *image = (RECT *)(buffer + 0x208);
+    if (cache_id)
+        brf_800C5584(work, (unsigned short)cache_id, header->flags & 1, (header->flags & 0x30) >> 4, image, palette,
+                     palette->w, buffer);
+}
