@@ -0,0 +1,74 @@
+#include "select_native.h"
+
+void brf_800C62B0(Work *work, int x, int y, int width, int height, int color, int style)
+{
+    POLY_FT4 *polys = work->field_E60;
+    for (int i = 0; i < 9; ++i)
+    {
+        work->field_58[i] = 2;
+        setRGB0(&polys[i], color, color, color);
+    }
+    if ((unsigned int)style > 2)
+        return;
+    int                        outer = 8 - style * 2;
+    int                        inner = style * 2;
+    short                      xs[] = {x - outer, x + inner, x + width - inner, x + width + outer};
+    short                      ys[] = {y - outer, y + inner, y + height - inner, y + height + outer};
+    static const unsigned char cells[9][2] = {{0, 0}, {2, 0}, {0, 2}, {2, 2}, {1, 0}, {1, 2}, {0, 1}, {2, 1}, {1, 1}};
+    for (int i = 0; i < 9; ++i)
+    {
+        int col = cells[i][0], row = cells[i][1];
+        setXY4(&polys[i], xs[col], ys[row], xs[col + 1], ys[row], xs[col], ys[row + 1], xs[col + 1], ys[row + 1]);
+    }
+}
+
+void brf_800C7B94(Work *work)
+{
+    POLY_FT4 *from = &work->field_780[work->field_FD8];
+    POLY_FT4 *to = &work->field_780[work->field_FDC];
+    int       duration = work->field_FE0, time = work->field_D0;
+    int       source[] = {from->x0, from->y0, from->x3 - from->x0, from->y3 - from->y0};
+    int       target[] = {to->x0, to->y0, to->x3 - to->x0, to->y3 - to->y0};
+    int       box[4];
+    for (int i = 0; i < 4; ++i)
+        box[i] = source[i] + (target[i] - source[i]) * time / duration;
+    switch (work->field_FD4)
+    {
+    case 1:
+        break;
+    case 2:
+    case 8:
+        box[1] = source[1];
+        box[3] = source[3];
+        break;
+    case 3:
+    case 9:
+        box[0] = target[0];
+        box[2] = target[2];
+        break;
+    case 4:
+    case 6:
+        box[0] = source[0];
+        box[2] = source[2];
+        break;
+    case 5:
+    case 7:
+        box[1] = target[1];
+        box[3] = target[3];
+        break;
+    default:
+        return;
+    }
+    brf_800C62B0(work, box[0], box[1], box[2], box[3], 128, 1);
+    if (time < duration)
+        return;
+    if (work->field_FD4 & 1)
+        work->field_FD4 = 0;
+    else
+    {
+        int mode = work->field_FD4;
+        work->field_FD4++;
+        work->field_D0 = 0;
+        work->field_FE0 = mode == 6 ? 1 : mode == 8 ? 2 : 3;
+    }
+}
