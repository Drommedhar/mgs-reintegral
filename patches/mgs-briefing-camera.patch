+static void AnimateBiographyLine(BriefingGraphWork *work, int time)
+{
+    if (time == 145)
+    {
+        brf_800D1A04(work, 32, 110);
+        return;
+    }
+    unsigned index = 0;
+    while (index + 1 < sizeof(biography_lines) / sizeof(biography_lines[0]) &&
+           time >= biography_lines[index + 1].first_frame)
+        ++index;
+    const BiographyLine *line = &biography_lines[index];
+    if (index != 0 && time == line->transition_frame)
+        brf_800D1A04(work, line->first_glyph, time == 657 ? 560 : line->next_glyph);
+    else
+        brf_800D18D8(work, line->transition_frame, line->first_glyph, line->next_glyph);
+}
