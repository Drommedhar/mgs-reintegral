+
+int CameraUnpackPhoto(const unsigned char *input, size_t input_size, unsigned short *output,
+                      size_t output_capacity)
+{
+    size_t source = 4, used = 1, words, limit;
+    unsigned int header, byte, second, run;
+    int level;
+    if (!input || input_size < 4 || !output)
+        return 0;
+    header = (input[0] << 8) | input[1];
+    words = header * 2;
+    limit = header * 4;
+    if (!header || header > 0x7fff || words + 2 > output_capacity)
+        return 0;
+    output[0] = header;
+    output[1] = 0x3800;
+    output[2] = (input[2] << 8) | input[3];
+    while (source < limit)
+    {
+        if (source >= input_size || used >= words)
+            return 0;
+        byte = input[source++];
+        if (!(byte & 0x80))
+        {
+            if (byte == 15)
+            {
+                output[2 + used++] = 0xfe00;
+                if (source >= input_size)
+                    return 0;
+                second = input[source++];
+                if (second == 15)
+                    break;
+                if (source >= input_size || used >= words)
+                    return 0;
+                output[2 + used++] = (second << 8) | input[source++];
+            }
+            else
+                output[2 + used++] = (((byte & 15) - 8) & 1023) | ((byte >> 4) << 10);
+        }
+        else
+        {
+            if (source >= input_size)
+                return 0;
+            run = (byte >> 1) & 63;
+            level = input[source++] + ((byte & 1) << 8) - 256;
+            output[2 + used++] = (run << 10) | (level & 1023);
+        }
+    }
+    while (used < words)
+        output[2 + used++] = 0xfe00;
+    return (int)(words + 2);
+}
+
+void camera_800C3B9C(int unused, u_short *output)
+{
+    (void)unused;
+    if (!CameraUnpackPhoto(camera_dword_800D0700, CAMERA_PHOTO_BYTES - CAMERA_PHOTO_HEADER,
+                          output, sizeof(CameraRunlevel) / (sizeof(unsigned short))))
+    {
+        fprintf(2, "Photo album contains an invalid compressed image\n");
+        abort();
+    }
+}
+
+void camera_800C3A7C(unsigned long *runlevel, RECT *rectangle)
+{
+    unsigned long cell[128];
+    int left = rectangle->x, top = rectangle->y;
+    int right = left + rectangle->w, bottom = top + rectangle->h;
+    DecDCTReset(0);
+    rectangle->w = 16;
+    rectangle->h = 16;
+    DecDCTin(runlevel, 0);
+    for (rectangle->x = left; rectangle->x < right; rectangle->x += 16)
+    {
+        for (rectangle->y = top; rectangle->y < bottom; rectangle->y += 16)
+        {
+            DecDCTout(cell, 128);
+            DecDCToutSync(0);
+            LoadImage(rectangle, cell);
+        }
+    }
+    rectangle->x = left;
+    rectangle->y = top;
+}
+
+static int CameraDecodeCharacter(unsigned int first, unsigned int second)
+{
+    if (first == 0x82)
+        return (unsigned char)(second - 31);
+    if (first != 0x81)
+        return -1;
+    switch (second)
+    {
+    case 0x40: return ' ';
+    case 0x46: return ':';
+    case 0x48: return '?';
+    case 0x49: return '!';
+    case 0x6d: return '[';
+    case 0x6e: return ']';
+    default: return -1;
+    }
+}
+
+void CameraReadPhotoTitle(CameraWork *work, const unsigned char *photo)
+{
+    int count = 0, character, number;
+    if (photo[13] == 0x40)
+        number = photo[27] - 79;
+    else if (photo[7] == 0x66)
+    {
+        number = photo[25] - 79;
+        while (count < 16 && photo[28 + count * 2])
+        {
+            character = CameraDecodeCharacter(photo[28 + count * 2], photo[29 + count * 2]);
+            if (character >= 0)
+                work->photo_name[count] = character;
+            ++count;
+        }
+        if (count == 16)
+            count = 15;
+    }
+    else
+        return;
+    work->photo_number = number;
+    work->name_cursor = 0;
+    work->name_length = count;
+    memcpy(work->title, "PHOTO 00", 9);
+    work->title[7] = number + '0';
+    work->separator[0] = ':';
+    work->separator[1] = 0;
+}
+
+void camera_800C4394(CameraWork *work)
+{
+    unsigned int header;
+    int i;
+    RECT image = {0, 256, 288, 176};
+    CameraReadPhotoTitle(work, camera_dword_800D0700);
+    memcpy(&header, camera_dword_800D0700 + 256, sizeof(header));
+    camera_dword_800D0700 += CAMERA_PHOTO_HEADER;
+    work->field_4934 = header & 255;
+    for (i = 0; i < 3; ++i)
+    {
+        work->adjustment[i] = ((header >> (8 + 8 * i)) & 255) - 128;
+        work->color[i] = 255 * (work->adjustment[i] + 100) / 200;
+    }
+    camera_800C3B9C(0, (unsigned short *)CameraRunlevel);
+    camera_800C3A7C(CameraRunlevel, &image);
+    camera_800C3D3C(work);
+    if (work->field_4934)
+        camera_800C4350(work);
+}
+
+static void CameraEncodeCharacter(unsigned char *output, unsigned int character)
+{
+    unsigned int second;
+    switch (character)
+    {
+    case ' ': second = 0x40; break;
+    case ':': second = 0x46; break;
+    case '?': second = 0x48; break;
+    case '!': second = 0x49; break;
+    case '[': second = 0x6d; break;
+    case ']': second = 0x6e; break;
+    default:
+        output[0] = 0x82;
+        output[1] = character + 31;
+        return;
+    }
+    output[0] = 0x81;
+    output[1] = second;
+}
+
+void camera_800CD790(CameraWork *work)
+{
+    unsigned char encoded[40] = {0};
+    char title[64] = {0};
+    unsigned int header;
+    int i, count = work->name_length + 1;
+    if (count < 0 || count > 16 || !camera_dword_800D0704)
+    {
+        fprintf(2, "Photo album cannot encode an invalid name or missing photo\n");
+        abort();
+    }
+    encoded[0] = encoded[2] = 0x82;
+    encoded[1] = work->photo_number / 10 + 79;
+    encoded[3] = work->photo_number % 10 + 79;
+    encoded[4] = 0x81;
+    encoded[5] = 0x40;
+    for (i = 0; i < count; ++i)
+        CameraEncodeCharacter(encoded + 6 + 2 * i, (unsigned char)work->photo_name[i]);
+    CameraFormat(title, sizeof(title), "%s%s%s%s", camera_dword_800D03D0,
+                 camera_dword_800D011C, camera_dword_800D03D8, encoded);
+    title[6] = 0x81;
+    title[7] = 0xe7;
+    memcpy(camera_dword_800D0704 + 4, title, sizeof(title));
+    header = (unsigned char)work->field_4934;
+    for (i = 0; i < 3; ++i)
+        header |= (unsigned int)(unsigned char)(work->adjustment[i] + 128) << (8 + 8 * i);
+    memcpy(camera_dword_800D0704 + 256, &header, sizeof(header));
+}
