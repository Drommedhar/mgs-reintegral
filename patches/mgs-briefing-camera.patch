+static int AddNames(Work *work, int slot, int type)
+{
+    static const short positions[8][2] = {{-89, 34}, {-89, 49}, {-33, 34}, {53, 34},
+                                          {45, 49},  {-21, 34}, {-97, 34}, {-89, 49}};
+    int i;
+
+    if (type == 6)
+    {
+        slot = AddText(work, slot, 56, 17, 40);
+        slot = AddText(work, slot, 57, 45, 54);
+        slot = AddText(work, slot, 58, -113, 40);
+        slot = AddImage(work, slot, "a_back_u", -127, -104, 127, 0, 0);
+        return AddImage(work, slot, "a_back_d", -127, -104, 127, 0, 0);
+    }
+    if (type == 7)
+    {
+        return AddText(work, slot, 59, 33, 55);
+    }
+    for (i = 0; i < 8; i++)
+    {
+        slot = AddText(work, slot, 60 + i, positions[i][0], positions[i][1]);
