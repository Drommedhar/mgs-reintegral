+        header.secCount != (unsigned)Stsector_offset ||
+        header.nSectors != StRingAddr[StRingIdx2].nSectors)) {
+        ERRORF("STR frame %u has missing or reordered sectors", header.frameCount);
+        exit(EXIT_FAILURE);
+    }
+    if (header.secCount == 0 && !ReserveStreamFrame(&header))
+        return;
+    if (!StCdIntrFlag || header.frameCount != (unsigned)Stframe_no ||
+        header.secCount != (unsigned)Stsector_offset ||
