new file mode 100644
index 0000000..431cbfb
--- /dev/null
+++ b/psyz/src/psyz/mdec_decode.c
@@ -0,0 +1,132 @@
+/*
+ * Run-level, IDCT and color conversion adapted from allkern/psxe mdec.c,
+ * commit 8459c63ed78c703f46e3c51daa65a2fdf96d02e6.
+ * Copyright (c) 2024 Allkern (Lisandro AlarcÛn), MIT license.
+ * See ../../LICENSE-psxe.txt. Native adaptation bounds every input/output access.
+ */
+#include "mdec_decode.h"
+#include <string.h>
+
+static const unsigned char zigzag[64] = {
+     0,  1,  8, 16,  9,  2,  3, 10, 17, 24, 32, 25, 18, 11,  4,  5,
+    12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13,  6,  7, 14, 21, 28,
+    35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51,
+    58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63
+};
+
+static int Clamp(int value, int minimum, int maximum)
+{
+    return value < minimum ? minimum : (value > maximum ? maximum : value);
+}
+
+static int Signed10(unsigned value)
+{
+    value &= 0x3ff;
+    return value & 0x200 ? (int)value - 1024 : (int)value;
+}
+
+static void InverseDct(int16_t block[64], const short scale[64])
+{
+    int16_t temporary[64];
+    int16_t *source = block;
+    int16_t *destination = temporary;
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        for (unsigned x = 0; x < 8; ++x) {
+            for (unsigned y = 0; y < 8; ++y) {
+                int64_t sum = 0;
+                for (unsigned z = 0; z < 8; ++z)
+                    sum += (int64_t)source[y + z * 8] * (scale[x + z * 8] >> 3);
+                destination[x + y * 8] = (int16_t)((sum + 0xfff) >> 13);
+            }
+        }
+        int16_t *swap = source;
+        source = destination;
+        destination = swap;
+    }
+}
+
+static int DecodeBlock(PsyzMdecInput *input, const unsigned char quant[64],
+                       const short scale[64], int16_t block[64])
+{
+    memset(block, 0, 64 * sizeof(*block));
+    while (input->next != input->end && *input->next == 0xfe00)
+        ++input->next;
+    if (input->next == input->end)
+        return 0;
+    unsigned code = *input->next++;
+    unsigned quant_scale = code >> 10;
+    unsigned position = 0;
+    int value = Signed10(code) * quant[0];
+    for (;;) {
+        if (!quant_scale)
+            value = Signed10(code) * 2;
+        block[quant_scale ? zigzag[position] : position] = (int16_t)Clamp(value, -1024, 1023);
+        if (input->next == input->end)
+            return 0;
+        code = *input->next++;
+        position += (code >> 10) + 1;
+        if (position >= 64)
+            break;
+        value = (Signed10(code) * quant[position] * (int)quant_scale + 4) >> 3;
+    }
+    InverseDct(block, scale);
+    return 1;
+}
+
+static void ConvertColor(const int16_t blocks[6][64], unsigned command,
+                         unsigned char *output)
+{
+    unsigned depth = (command >> 27) & 3;
+    unsigned is_signed = command & (1u << 26);
+    unsigned bit15 = (command & (1u << 25)) ? 0x8000 : 0;
+    for (unsigned y = 0; y < 16; ++y) {
+        for (unsigned x = 0; x < 16; ++x) {
+            unsigned chroma = (x / 2) + (y / 2) * 8;
+            unsigned block = 2 + (x / 8) + (y / 8) * 2;
+            int luma = blocks[block][(x % 8) + (y % 8) * 8];
+            int red = blocks[0][chroma];
+            int blue = blocks[1][chroma];
+            int green = (int)(-0.3437f * blue - 0.7143f * red);
+            red = (int)(1.402f * red);
+            blue = (int)(1.772f * blue);
+            unsigned r = (unsigned char)Clamp(luma + red, -128, 127);
+            unsigned g = (unsigned char)Clamp(luma + green, -128, 127);
+            unsigned b = (unsigned char)Clamp(luma + blue, -128, 127);
+            if (!is_signed) {
+                r ^= 0x80;
+                g ^= 0x80;
+                b ^= 0x80;
+            }
+            unsigned pixel = x + y * 16;
+            if (depth == 3) {
+                unsigned color = (r >> 3) | ((g >> 3) << 5) | ((b >> 3) << 10) | bit15;
+                output[pixel * 2] = (unsigned char)color;
+                output[pixel * 2 + 1] = (unsigned char)(color >> 8);
+            } else {
+                output[pixel * 3] = (unsigned char)r;
+                output[pixel * 3 + 1] = (unsigned char)g;
+                output[pixel * 3 + 2] = (unsigned char)b;
+            }
+        }
+    }
+}
+
+int Psyz_MdecDecodeMacroblock(PsyzMdecInput *input, const DECDCTENV *env,
+                              unsigned command, void *output, size_t output_bytes)
+{
+    unsigned depth = (command >> 27) & 3;
+    int16_t blocks[6][64];
+    size_t size = depth == 3 ? 512 : 768;
+    if (!input || !env || !output || input->next > input->end || depth < 2 || output_bytes < size)
+        return -1;
+    while (input->next != input->end && *input->next == 0xfe00)
+        ++input->next;
+    if (input->next == input->end)
+        return 0;
+    for (unsigned i = 0; i < 6; ++i) {
+        if (!DecodeBlock(input, i < 2 ? env->iq_c : env->iq_y, env->dct, blocks[i]))
+            return -1;
+    }
+    ConvertColor(blocks, command, output);
+    return 1;
+}
