+typedef struct {
+    const unsigned char *data;
+    size_t bytes;
+    size_t bit;
+} BitReader;
+
+static unsigned Peek(const BitReader *reader, unsigned count)
+{
+    unsigned value = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        size_t bit = reader->bit + i;
+        size_t byte = ((bit / 16) * 2) + ((bit % 16 < 8) ? 1 : 0);
+        value <<= 1;
+        if (byte < reader->bytes)
+            value |= (reader->data[byte] >> (7 - bit % 8)) & 1;
+    }
+    return value;
+}
+
+static int Consume(BitReader *reader, unsigned count)
+{
+    if (count > reader->bytes * 8 - reader->bit)
+        return 0;
+    reader->bit += count;
+    return 1;
+}
+
+void Psyz_VlcBuild(PsyzVlcTable *table)
+{
+    uint32_t *output = (uint32_t *)table;
+    for (unsigned i = 0; i < TABLE_LENGTH; ++i) {
+        uint32_t value = _compressed_table[i] & 0x001fffff;
+        for (unsigned j = (_compressed_table[i] >> 21) + 1; j > 0; --j)
+            *output++ = value;
+    }
+}
+
+static int DecodeAc(BitReader *reader, const PsyzVlcTable *table, uint16_t *value)
+{
+    unsigned bits;
+    if (Peek(reader, 2) == 2) {
+        *value = 0xfe00;
+        bits = 2;
+    } else if (Peek(reader, 6) == 1) {
+        *value = (uint16_t)Peek(reader, 22);
+        bits = 22;
+    } else {
+        uint32_t entry = Peek(reader, 8) ? table->ac[Peek(reader, 13)]
+                                       : table->ac00[Peek(reader, 17)];
+        *value = (uint16_t)entry;
+        bits = entry >> 16;
+        if (!bits || bits > 17)
+            return 0;
+    }
+    return Consume(reader, bits);
+}
+
+int Psyz_VlcDecode(const void *input, size_t input_bytes, uint32_t *output,
+                   size_t output_words, const PsyzVlcTable *table)
+{
+    uint16_t header[4];
+    if (!input || !output || !table || input_bytes < 8 || input_bytes > 0x20000)
+        return -1;
+    memcpy(header, input, sizeof(header));
+    if (header[1] != 0x3800 || header[3] > 2 || !header[3] ||
+        header[2] > 63 || !header[0] || output_words <= header[0])
+        return -1;
+    BitReader reader = {(const unsigned char *)input + 8, input_bytes - 8, 0};
+    uint16_t *decoded = (uint16_t *)(output + 1);
+    unsigned remaining = header[0] * 2u;
+    unsigned dc = 1;
+    output[0] = 0x38000000u | header[0];
+    while (remaining) {
+        uint16_t value;
+        if (dc) {
+            unsigned coefficient = Peek(&reader, 10);
+            if (!Consume(&reader, 10))
+                return -1;
+            if (coefficient == 0x1ff) {
+                while (remaining--)
+                    *decoded++ = 0xfe00;
+                return 0;
+            }
+            value = (uint16_t)(coefficient | (header[2] << 10));
+        } else if (!DecodeAc(&reader, table, &value)) {
+            return -1;
+        }
+        dc = value == 0xfe00;
+        *decoded++ = value;
+        --remaining;
+    }
+    return 0;
+}
