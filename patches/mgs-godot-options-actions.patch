+#ifdef MGS_GODOT_SCENE
+static void OptionsSelect(Work *work, unsigned target)
+{
+    if (work->f920 == 9) {
+        const RECT rects[] = {{-149,-70,88,12}, {-149,38,88,12}, {90,66,56,12}};
+        const RECT *rect = &rects[target];
+        work->f29E4 = target;
+        option_800C449C(work, rect->x, rect->y, rect->w, rect->h, 255, 1);
+    } else {
+        while (work->f920 != target) option_800C5150(work, target > work->f920 ? 1 : 0);
+    }
+}
+
+static void OptionsBack(Work *work)
+{
+    if (work->f920 == 7 || work->f920 == 9) {
+        option_800C5150(work, 3);
+        GM_SeSet2(0, 63, SE_MENU_EXIT);
+    } else {
+        SetGameOptionFlag(work);
+    }
+}
+
+static void OptionsSet(Work *work, unsigned target, unsigned value)
+{
+    OptionsSelect(work, target);
+    if (work->f920 == 9) {
+        if (target == 0) {
+            work->f29E8 = value;
+            option_800C4780(work);
+        } else {
+            work->f29EC = value;
+            option_800C4A6C(work);
+        }
+    } else {
+        if (work->f924[target] != value) option_800C4B68(work);
+        if (target == 5) work->f2B50 = 1;
+    }
+    GM_SeSet2(0, 63, SE_MENU_TOGGLE);
+}
+
+static int OptionsAction(Work *work)
+{
+    MgsOptionsAction action;
+    if (!MgsGodotOwnsOptions() || !MgsOptionsActionsTake(OptionsState(work), &action)) return 0;
+    switch (action.kind) {
+    case MGS_OPTIONS_SELECT:
+        OptionsSelect(work, action.target);
+        GM_SeSet2(0, 63, SE_MENU_CURSOR);
+        break;
+    case MGS_OPTIONS_SET:
+        OptionsSet(work, action.target, action.value);
+        break;
+    case MGS_OPTIONS_ACTIVATE:
+        OptionsSelect(work, action.target);
+        if (action.target == 10) SetGameOptionFlag(work);
+        else {
+            option_800C5150(work, 2);
+            GM_SeSet2(0, 63, SE_MENU_SELECT);
+        }
+        break;
+    case MGS_OPTIONS_BACK:
+        OptionsBack(work);
+        break;
+    }
+    MgsOptionsActionsComplete(MGS_OPTIONS_APPLIED);
+    return 1;
+}
+#endif
