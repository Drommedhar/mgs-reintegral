+static void TitleMenuLayout(Work *work)
+{
+    static const int widths[] = {38, 40, 26, 32, 30, 44};
+    const int selected = work->fA78;
+    if (selected < 0 || selected > 5) return;
+    const int items[] = {selected ? selected - 1 : 4, selected, selected >= 4 ? 0 : selected + 1};
+    for (int item = 0; item < 6; ++item) work->fE0[item] = 0;
+    for (int row = 0; row < 3; ++row) {
+        const int item = items[row], half = widths[item], y = 55 + row * 15;
+        POLY_GT4 *poly = &work->f934_polys[item];
+        title_open_800C4B94(poly, row == 0 ? 0 : 128, row == 0 ? 0 : 192, row == 0 ? 0 : 128,
+                          row == 2 ? 0 : 128, row == 2 ? 0 : 192, row == 2 ? 0 : 128);
+        setXY4(poly, -half, y, half, y, -half, y + 8, half, y + 8);
+        SetSemiTrans(poly, row != 1);
+        work->fE0[item] = 256;
+    }
+    work->fA98 = 2;
+    work->f184 = 0;
+}
