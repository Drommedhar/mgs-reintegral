--- /dev/null
+++ b/source/onoda/open/open_actions.h
@@ -0,0 +1,28 @@
+/* Included after TitleMenuLayout; commands share the native transition branches. */
+static void TitleSelect(Work *work, int target)
+{
+    int *selection = &work->fA78;
+    if (work->fA74 == 21) {
+        selection = &work->f24E4;
+        --target;
+    } else if (work->fA74 == 18 || work->fA74 == 19) {
+        selection = &work->f24E0;
+    }
+    if (*selection == target) return;
+    *selection = target;
+    GM_SeSet2(0, 63, SE_MENU_CURSOR);
+    if (work->fA74 == 7) {
+        work->fB14 = work->fB1C = 0;
+        TitleMenuLayout(work);
+    }
+}
+
+static int TitleAction(Work *work)
+{
+    MgsTitleAction action;
+    if (!MgsTitleActionsTake(TitleUiState(work), TitleUiReady(work), &action)) return 0;
+    if (action.kind != MGS_TITLE_BACK && (work->fA74 == 7 || work->fA74 == 18 || work->fA74 == 19 || work->fA74 == 21))
+        TitleSelect(work, action.target);
+    MgsTitleActionsComplete(MGS_TITLE_APPLIED);
+    return action.kind;
+}
