+
+static void file_packet(void) {
+    file_posted = 0;
+    unsigned int spec = file_success ? EvSpIOE : EvSpERROR;
+    if (file_success) file_remaining -= 128;
+    else file_remaining = 0;
+    Psyz_KernelRaise(HwCARD, spec);
+    if (!file_remaining) Psyz_KernelRaise(SwCARD, spec);
