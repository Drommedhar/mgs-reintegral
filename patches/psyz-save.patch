+    unsigned int count = 0;
+    *blocks = 0;
+    if (_stat(path, &status) != 0 || !(status.st_mode & _S_IFDIR) ||
+        snprintf(pattern, sizeof(pattern), "%s\\*", path) >= sizeof(pattern)) {
+        return 0;
+    }
+    intptr_t search = _findfirst(pattern, &entry);
+    if (search == -1) {
+        return errno == ENOENT;
+    }
+    int valid = 1;
+    do {
+        if ((entry.attrib & _A_SUBDIR) || entry.name[0] == '.') {
+            continue;
+        }
+        if (!decode_card_name(decoded, entry.name) || entry.size == 0 ||
+            entry.size > CARD_BLOCKS * CARD_BLOCK_BYTES) {
+            valid = 0;
+            break;
+        }
+        *blocks += (entry.size + CARD_BLOCK_BYTES - 1) / CARD_BLOCK_BYTES;
+        if (++count > CARD_BLOCKS || *blocks > CARD_BLOCKS) {
