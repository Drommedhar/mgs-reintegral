+static int decode_card_name(char* output, const char* name) {
+    unsigned int count = 0;
+    while (*name) {
+        unsigned char value = (unsigned char)*name++;
+        if (value == '%') {
+            unsigned int code;
+            int used = 0;
+            if (strlen(name) < 2 || sscanf(name, "%2x%n", &code, &used) != 1 || used != 2 || !code) {
