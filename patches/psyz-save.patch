+int Psyz_CardFileBusy(void) { return file_remaining != 0; }
+
+int Psyz_CardFileComplete(long channel, unsigned int bytes, int success) {
+    if (file_remaining || (channel != 0 && channel != 16) || !bytes || bytes > 15 * 8192) {
+        return 0;
+    }
+    if (!file_callback_installed) {
+        previous_card_vsync = Psyz_SetVSyncCb(card_frame);
+        file_callback_installed = 1;
+    }
+    last_chan = channel;
+    file_success = success && bytes % 128 == 0;
+    file_remaining = file_success ? bytes : 128;
+    return 1;
