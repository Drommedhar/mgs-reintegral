+#ifdef MGS_NATIVE
+static void draw_countdown_tile(MenuPrim *prim, OT_TYPE *ot, int x, int y, int width, int height, unsigned int color)
+{
+    TILE *tile;
+    _NEW_PRIM(tile, prim);
+    setTile(tile);
+    setSemiTrans(tile, 1);
+    setXY0(tile, x, y);
+    setWH(tile, width, height);
+    setRGB0(tile, color & 255, (color >> 8) & 255, (color >> 16) & 255);
+    addPrim(ot, tile);
+}
+
+static void draw_countdown_mode(MenuPrim *prim, OT_TYPE *ot, unsigned int code)
+{
+    DR_TPAGE *mode;
+    _NEW_PRIM(mode, prim);
+    setlen(mode, 1);
+    mode->code[0] = code;
+    addPrim(ot, mode);
+}
+
+void s19b_countdwn_800C3C90(MenuWork *work, OT_TYPE *ot)
+{
+    int           remaining = countdown_time * 100 / 30;
+    unsigned int  color = remaining % 100 < 50 ? 0x818 : 0x182589;
+    RadioUnknown *digits = &s19b_dword_800C327C;
+    int           divisor = 100;
+    int           group;
+    int           pulse;
+
+    if (countdown_time > 0 && --countdown_time == 0)
+    {
+        exec_countdown_proc();
+    }
+    for (group = 0; group < 8; group += 2)
+    {
+        draw_countdown_tile(work->prim, ot, s19b_dword_800C32B0[group] - 34, s19b_dword_800C32B0[group + 1] - 26, 1, 2,
+                            color);
+    }
+    for (group = 5; group >= 0; group -= 2)
+    {
+        int part = remaining % divisor;
+        remaining /= divisor;
+        sub_8003FD50(work->prim, s19b_dword_800C32A0[group] - 34, s19b_dword_800C32A8[group] - 26, part % 10, digits,
+                     1);
+        sub_8003FD50(work->prim, s19b_dword_800C32A0[group - 1] - 34, s19b_dword_800C32A8[group - 1] - 26, part / 10,
+                     digits, 1);
+        digits = &s19b_dword_800C3258;
+        divisor = 60;
+    }
+    for (group = 0; group < 8; group += 4)
+    {
+        draw_countdown_tile(work->prim, ot, s19b_dword_800C32B8[group] - 34, s19b_dword_800C32B8[group + 1] - 26,
+                            s19b_dword_800C32B8[group + 2], s19b_dword_800C32B8[group + 3], 0x182589);
+    }
+    draw_countdown_mode(work->prim, ot, 0xe100045f);
+    pulse = GV_Time % 16;
+    draw_image(work->prim, -34, -25, pulse >= 8 ? 128 : 128 - 16 * pulse, warn1_texture);
+    draw_image(work->prim, -33, -13, 128, warn2_texture);
+    draw_countdown_tile(work->prim, ot, -34, -26, 69, 52, 222);
+    draw_countdown_mode(work->prim, ot, 0xe100041f);
+}
