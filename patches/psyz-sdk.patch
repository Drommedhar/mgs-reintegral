diff --git a/psyz/src/platform/sdl3_common.h b/psyz/src/platform/sdl3_common.h
index b3bbb45..d1c7518 100644
--- a/psyz/src/platform/sdl3_common.h
+++ b/psyz/src/platform/sdl3_common.h
@@ -537,6 +537,22 @@ struct Gamepad {
 static bool is_pads_init = false;
 static struct Gamepad gamepads[16] = {0};
 
+int Psyz_PadsSupportsRumble(int port) {
+    if (port < 0 || port >= 2 || !gamepads[port].dev) {
+        return 0;
+    }
+    return SDL_GetBooleanProperty(SDL_GetGamepadProperties(gamepads[port].dev),
+                                  SDL_PROP_GAMEPAD_CAP_RUMBLE_BOOLEAN, false);
+}
+
+int Psyz_PadsRumble(int port, unsigned short low, unsigned short high,
+                    unsigned duration_ms) {
+    if (!Psyz_PadsSupportsRumble(port)) {
+        return 0;
+    }
+    return SDL_RumbleGamepad(gamepads[port].dev, low, high, duration_ms);
+}
+
 static void UpdatePlatformTouchControls(void) {
 #ifdef PLATFORM_IOS
     Psyz_IosSetTouchControlsVisible(is_pads_init && !gamepads[0].dev);
