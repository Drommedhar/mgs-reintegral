+static void SaveUiStorage(int port, const MEMCARD *card)
+{
+    MgsSaveFile files[MGS_SAVE_FILE_LIMIT] = {0};
+    if (!card) {
+        MgsSaveUiStorage(port, NULL, 0, -1);
+        return;
+    }
+    if (card->file_count > MGS_SAVE_FILE_LIMIT) {
+        fputs("Save UI: native file count exceeds storage capacity.\n", stderr);
+        exit(EXIT_FAILURE);
+    }
+    for (unsigned index = 0; index < card->file_count; ++index) {
+        memcpy(files[index].name, card->files[index].name, sizeof(files[index].name));
+        files[index].bytes = card->files[index].size;
+    }
+    MgsSaveUiStorage(port, files, card->file_count, card->free_blocks);
+    const MgsSaveView *view = MgsSaveUiGetView();
+    for (unsigned row = 0; row < view->count; ++row) {
+        if (!view->entries[row].metadata_valid) continue;
+        char *name = NULL, *unused = NULL;
+        getAreaName_8004CF20(view->entries[row].area, &name, &unused);
+        MgsSaveUiLocation(view->entries[row].area, MgsLanguageText(name));
+    }
+}
+
+static int SaveUiUpdate(GV_PAD *pad)
+{
+    if (save_ui_closing && mts_get_task_status(MTSID_MEMORY_CARD) == 0) {
+        GV_FreeMemory(GV_PACKET_MEMORY0, stack_800ABB50);
+        GM_Result = dword_800ABB54;
+        MgsSaveUiEnd();
+        save_ui_owned = 0;
+        return dword_800ABB48 == 2 ? 2 : 1;
+    }
+    unsigned input = 0;
+    if (pad->press & (PAD_UP | PAD_LEFT)) input |= MGS_SAVE_UP;
+    if (pad->press & (PAD_DOWN | PAD_RIGHT)) input |= MGS_SAVE_DOWN;
+    if (pad->press & PAD_CIRCLE) input |= MGS_SAVE_ACCEPT;
+    if (pad->press & PAD_CROSS) input |= MGS_SAVE_CANCEL;
+    uint32_t request = dword_800ABB58;
+    MgsSaveResponse response = MgsSaveMenuStep(request, dword_800AB6FC, input);
+    const MgsSaveView *view = MgsSaveUiGetView();
+    dword_800ABB80 = view->state == MGS_SAVE_BROWSE ? 3 : view->state == MGS_SAVE_CONFIRM ? 5 :
+        view->state == MGS_SAVE_RESULT ? 2 : 1;
+    if (input & (MGS_SAVE_UP | MGS_SAVE_DOWN)) GM_SeSet2(0, 0x3F, SE_MENU_CURSOR);
+    if (!response.ready) return 0;
+    if (input & (MGS_SAVE_ACCEPT | MGS_SAVE_CANCEL)) GM_SeSet2(0, 0x3F, SE_MENU_SELECT);
+    dword_800ABB5C = response.value;
+    dword_800ABB58 = 0;
+    if (request & 0x80000000) save_ui_closing = 1;
+    /* Port selection is polled by the worker; all other requests sleep. */
+    if (request != 0x20000001) mts_wup_tsk(MTSID_MEMORY_CARD);
+    return 0;
+}
