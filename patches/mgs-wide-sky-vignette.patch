+#endif
 
 typedef struct _GasEfctPrims
 {
     DR_TPAGE tpage[2];
     POLY_G4  poly[2][16];
+#ifdef MGS_NATIVE
+    POLY_F4  border[2][16];
+#endif
 } GasEfctPrims;
 
 typedef struct _Work
@@ -286,6 +292,27 @@ void d11c_800C4FFC(Work *work)
     d11c_800C49A4(work, prims->poly[1]);
 }
 
+#ifdef MGS_NATIVE
+static void ExtendVignette(Work *work, OT_TYPE *ot)
+{
+    int halfwidth = MgsVideoHalfWidth();
+    int i;
+    POLY_G4 *ring = work->prims->poly[GV_Clock];
+    POLY_F4 *border = work->prims->border[GV_Clock];
+    if (halfwidth <= 160) return;
+    for (i = 0; i < 16; i++, ring++, border++)
+    {
+        setPolyF4(border);
+        setSemiTrans(border, 1);
+        setRGB0(border, ring->r2, ring->g2, ring->b2);
+        setXY4(border, ring->x2, ring->y2, ring->x3, ring->y3,
+               ring->x2 * halfwidth / 160, ring->y2 * halfwidth / 160,
+               ring->x3 * halfwidth / 160, ring->y3 * halfwidth / 160);
+        addPrim(ot, border);
+    }
+}
+#endif
+
 void d11c_800C5094(Work *work, int arg1)
 {
     MATRIX   sp10;
@@ -335,6 +362,9 @@ void d11c_800C5094(Work *work, int arg1)
             addPrim(ot, poly);
         }
 
+#ifdef MGS_NATIVE
+        ExtendVignette(work, ot);
+#endif
         addPrim(ot, &work->prims->tpage[GV_Clock]);
     }
 }
