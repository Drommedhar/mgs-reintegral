+#include "mgs_godot_inventory_actions.h"
+
+int menu_item_open(MenuWork *work);
+int is_disable_item(int id);
+void MENU_ItemSelect(MenuWork *work, int id);
+int MENU_ItemCanUse(int id, int quantity);
+void MENU_ItemUse(Menu_Item_Unknown *panels);
+
+static int inventory_controlled;
+int MENU_InventoryControlled(void) { return inventory_controlled; }
+
+static Menu_Inventory *InventoryMenu(MenuWork *work, unsigned side)
+{
+    return side ? &work->field_1F0_menu_weapon : &work->field_1DC_menu_item;
+}
+
+static void InventoryEntry(MgsInventoryActionView *view, unsigned side, int id, int quantity)
+{
+    MgsInventoryEntry entry = {side, id, quantity, 0};
+    if (id == -1 || (side ? !menu_weapon_isWeaponDisabled_8003DF30(id) : quantity > 0 && !is_disable_item(id)))
+        entry.flags |= MGS_INV_EQUIPPABLE;
+    if (!side && MENU_ItemCanUse(id, quantity)) entry.flags |= MGS_INV_USABLE;
+    view->entries[view->count++] = entry;
+}
+
+static void InventoryEntries(MenuWork *work, MgsInventoryActionView *view, unsigned side)
+{
+    if (view->mode == side + 1) {
+        Menu_Item_Unknown *panels = InventoryMenu(work, side)->field_C_alloc;
+        for (int i = 0; i < panels->field_0_main.field_0_array_count; ++i) {
+            PANEL *panel = &panels->field_20_array[i];
+            InventoryEntry(view, side, panel->field_0_id, panel->field_2_num);
+        }
+    } else {
+        InventoryEntry(view, side, -1, 1);
+        if (GM_GameStatus & STATE_EQUIP_OFF) return;
+        for (int id = 0; id < (side ? 10 : IT_Max); ++id) {
+            int quantity = side ? GM_Weapons[id] : GM_Items[id];
+            if (quantity >= (side ? 0 : 1)) InventoryEntry(view, side, id, quantity);
+        }
+    }
+}
+
+static MgsInventoryActionView InventoryView(MenuWork *work)
+{
+    MgsInventoryActionView view = {0};
+    if ((GV_PauseLevel & GV_PAUSE_PAUSE) || GM_LoadComplete <= 0 || GM_LoadRequest || GM_GameStatus < 0) return view;
+    view.mode = work->field_2A_state == MENU_LEFT_OPEN ? 1 : work->field_2A_state == MENU_RIGHT_OPEN ? 2 : 0;
+    if (!view.mode && work->field_2A_state != MENU_CLOSED) return view;
+    view.active = 1;
+    view.owned = view.mode && inventory_controlled;
+    view.equipped[0] = GM_Item;
+    view.equipped[1] = GM_Weapon;
+    view.selection = -1;
+    if (!view.mode) {
+        if (!(GM_GameStatus & (STATE_TAKING_PHOTO | STATE_MENU_DISABLE)) &&
+            !(GM_PlayerStatus & (PLAYER_MENU_DISABLE | PLAYER_PAD_OFF)) && !(GM_Camera.flag & 0x101) &&
+            (GM_GameStatus & (STATE_VOX_STREAM | GAME_FLAG_BIT_13)) != STATE_VOX_STREAM) {
+            if ((work->field_28_flags & 4) && !(GM_PlayerStatus & PLAYER_ITEM_DISABLE) &&
+                work->field_1DC_menu_item.field_8_panel_conf->field_4_input) view.open_mask |= 1;
+            if ((work->field_28_flags & 2) && !(GM_PlayerStatus & PLAYER_WEAPON_DISABLE) &&
+                work->field_1F0_menu_weapon.field_8_panel_conf->field_4_input) view.open_mask |= 2;
+        }
+    } else {
+        Menu_Inventory *menu = InventoryMenu(work, view.mode - 1);
+        Menu_Item_Unknown *panels = menu->field_C_alloc;
+        view.selection = panels->field_20_array[panels->field_0_main.field_4_selected_idx].field_0_id;
+        if (menu->field_10_state == 1 && sub_8003D52C() > 255 && !panels->field_0_main.field_10) {
+            view.allowed = (1u << MGS_INV_SELECT) | (1u << MGS_INV_EQUIP) | (1u << MGS_INV_CLOSE);
+            if (view.mode == 1) view.allowed |= 1u << MGS_INV_USE;
+        }
+    }
+    InventoryEntries(work, &view, 0);
+    InventoryEntries(work, &view, 1);
+    return view;
+}
+
+static void InventorySelect(MenuWork *work, unsigned side, int id)
+{
+    Menu_Item_Unknown *panels = InventoryMenu(work, side)->field_C_alloc;
+    if (panels->field_20_array[panels->field_0_main.field_4_selected_idx].field_0_id == id) return;
+    if (!side) MENU_ItemSelect(work, id);
+    else {
+        menu_panel_8003D2BC(panels, id);
+        dword_800AB5E0 = dword_800AB5E4 = 0;
+    }
+    GM_SeSet2(0, 63, SE_ITEM_SELECT);
+}
+
+static uint32_t InventoryApply(MenuWork *work, const MgsInventoryAction *action)
+{
+    Menu_Inventory *menu = InventoryMenu(work, action->side);
+    if (action->kind == MGS_INV_OPEN) {
+        int opened = action->side ? menu_weapon_update_helper_8003E4B8(work) : menu_item_open(work);
+        if (!opened) return MGS_INV_BUSY;
+        work->field_2A_state = action->side ? MENU_RIGHT_OPEN : MENU_LEFT_OPEN;
+        dword_800AB584 = menu->field_8_panel_conf;
+        GV_PauseLevel |= GV_PAUSE_MENU;
+    } else if (action->kind == MGS_INV_USE) MENU_ItemUse(menu->field_C_alloc);
+    else {
+        if (action->kind != MGS_INV_CLOSE) InventorySelect(work, action->side, action->target);
+        if (action->kind == MGS_INV_EQUIP || action->kind == MGS_INV_CLOSE) menu->field_10_state = 3;
+    }
+    inventory_controlled = 1;
+    return MGS_INV_APPLIED;
+}
+
+void MENU_InventoryActionsUpdate(MenuWork *work, int apply)
+{
+    if (!MgsGodotOwnsInventoryActions()) return;
+    if (work->field_2A_state == MENU_CLOSED) inventory_controlled = 0;
+    MgsInventoryActionView view = InventoryView(work);
+    MgsGodotInventoryActionsView(&view);
+    MgsInventoryAction action;
+    if (apply && MgsInventoryActionsTake(&action)) MgsInventoryActionsComplete(InventoryApply(work, &action));
+}
+
+void MENU_InventoryActionsBegin(void)
+{
+    inventory_controlled = 0;
+    MgsGodotInventoryActionsBegin();
+}
+
+void MENU_InventoryActionsEnd(void)
+{
+    inventory_controlled = 0;
+    MgsGodotInventoryActionsEnd();
+}
