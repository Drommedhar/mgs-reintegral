diff --git a/source/takabe/puthzd.c b/source/takabe/puthzd.c
new file mode 100644
index 000000000..0e0dab54a
--- /dev/null
+++ b/source/takabe/puthzd.c
@@ -0,0 +1,170 @@
+#include "puthzd.h"
+#include "thing.h"
+#include "libgv/libgv.h"
+#include "libgcl/libgcl.h"
+#include "game/game.h"
+
+typedef struct
+{
+    GV_ACT actor;
+    int map;
+    int name;
+    int translated;
+    SVECTOR offset;
+    HZD_DEF *definition;
+    HZD_GRP *group;
+    HZD_HDL *handler;
+    int n_floors;
+    int n_walls;
+    HZD_SEG *walls;
+    HZD_FLR *floors;
+} PutHzdWork;
+
+_Static_assert(sizeof(PutHzdWork) == 0x50, "PutHzd actor layout");
+
+static unsigned short PutHzdMessages[] = {0xd182, 0x006b};
+
+static void PutHzdTranslatePoint(HZD_VEC *point, const SVECTOR *offset)
+{
+    point->x += offset->vx;
+    point->y += offset->vy;
+    point->z += offset->vz;
+}
+
+/* Integral s11h 800CCDC8: HZD vectors store x,z,y,h, including floor bounds. */
+static void PutHzdTranslate(PutHzdWork *work, HZD_GRP *group)
+{
+    int i;
+    HZD_FLR *floor;
+
+    for (i = 0; i < work->n_walls; ++i)
+    {
+        work->walls[i] = group->walls[i];
+        PutHzdTranslatePoint(&work->walls[i].p1, &work->offset);
+        PutHzdTranslatePoint(&work->walls[i].p2, &work->offset);
+    }
+    for (i = 0; i < work->n_floors; ++i)
+    {
+        floor = &work->floors[i];
+        *floor = group->floors[i];
+        PutHzdTranslatePoint(&floor->b1, &work->offset);
+        PutHzdTranslatePoint(&floor->b2, &work->offset);
+        PutHzdTranslatePoint(&floor->p1, &work->offset);
+        PutHzdTranslatePoint(&floor->p2, &work->offset);
+        PutHzdTranslatePoint(&floor->p3, &work->offset);
+        PutHzdTranslatePoint(&floor->p4, &work->offset);
+    }
+}
+
+static void PutHzdQueue(PutHzdWork *work, HZD_GRP *group)
+{
+    unsigned char *flags = (unsigned char *)group->wallsFlags;
+    int i;
+
+    for (i = 0; i < work->n_walls; ++i)
+    {
+        HZD_QueueDynamicSegment2(work->handler, &work->walls[i],
+                                flags[i] | (flags[group->n_walls + i] << 8));
+    }
+    for (i = 0; i < work->n_floors; ++i)
+    {
+        HZD_QueueDynamicFloor(work->handler, &work->floors[i]);
+    }
+}
+
+static void PutHzdAct(PutHzdWork *work)
+{
+    GM_CurrentMap = work->map;
+    if (THING_Msg_CheckMessage(work->name, 2, PutHzdMessages) == 1)
+    {
+        THING_Hzd_800C4874(work->n_walls, work->walls, work->n_floors, work->floors);
+        GV_DestroyActor(&work->actor);
+    }
+}
+
+static void PutHzdDie(PutHzdWork *work)
+{
+    int i;
+
+    for (i = 0; i < work->n_walls; ++i)
+    {
+        HZD_DequeueDynamicSegment(work->handler, &work->walls[i]);
+    }
+    for (i = 0; i < work->n_floors; ++i)
+    {
+        HZD_DequeueDynamicFloor(work->handler, &work->floors[i]);
+    }
+    if (work->translated)
+    {
+        GV_Free(work->walls);
+    }
+}
+
+static int PutHzdGetResources(PutHzdWork *work, int name, int where)
+{
+    HZD_GRP *group;
+    int size;
+
+    work->map = GM_CurrentMap = where;
+    work->name = name;
+    work->handler = GM_GetMap(where)->hzd;
+    if (GCL_GetOption('p'))
+    {
+        work->translated = 1;
+        GCL_StrToSV(GCL_NextStr(), &work->offset.vx);
+    }
+    if (!GCL_GetOption('h'))
+    {
+        return 0;
+    }
+    work->definition = GV_GetCache(GV_CacheID(GCL_StrToInt(GCL_NextStr()), 'h'));
+    if (!work->definition)
+    {
+        return -1;
+    }
+    work->group = group = work->definition->groups;
+    if (group->n_walls < 0 || group->n_floors < 0)
+    {
+        return -1;
+    }
+    if (work->translated)
+    {
+        size = sizeof(HZD_SEG) * group->n_walls + sizeof(HZD_FLR) * group->n_floors;
+        work->walls = GV_Malloc(size);
+        if (!work->walls)
+        {
+            return -1;
+        }
+        work->floors = (HZD_FLR *)(work->walls + group->n_walls);
+    }
+    else
+    {
+        work->walls = group->walls;
+        work->floors = group->floors;
+    }
+    work->n_walls = group->n_walls;
+    work->n_floors = group->n_floors;
+    if (work->translated)
+    {
+        PutHzdTranslate(work, group);
+    }
+    PutHzdQueue(work, group);
+    return 0;
+}
+
+void *NewPutHzd(int name, int where, int argc, char **argv)
+{
+    PutHzdWork *work = GV_NewActor(GV_ACTOR_USER, sizeof(PutHzdWork));
+
+    if (!work)
+    {
+        return NULL;
+    }
+    GV_SetNamedActor(&work->actor, PutHzdAct, PutHzdDie, "puthzd.c");
+    if (PutHzdGetResources(work, name, where) < 0)
+    {
+        GV_DestroyActor(&work->actor);
+        return NULL;
+    }
+    return work;
+}
