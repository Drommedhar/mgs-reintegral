diff --git a/source/kojo/inverlt.c b/source/kojo/inverlt.c
new file mode 100644
index 000000000..f93c468fb
--- /dev/null
+++ b/source/kojo/inverlt.c
@@ -0,0 +1,150 @@
+#include "inverlt.h"
+#include "libgv/libgv.h"
+#include "libdg/libdg.h"
+#include "game/game.h"
+#include "okajima/stngrnd.h"
+#include "okajima/stgfd_io.h"
+
+typedef struct
+{
+    GV_ACT actor;
+    int map;
+    DG_PRIM *prims[8];
+    RECT rects[8];
+    SVECTOR vertices[8];
+    int scales[8];
+    int timer;
+    SVECTOR position;
+} InverseLightWork;
+
+_Static_assert(sizeof(InverseLightWork) == 0xf0, "InverseLight actor layout");
+
+/* Integral s11h 800CD638. Integer division truncates toward zero. */
+static void InverseLightVertex(InverseLightWork *work, int index, const SVECTOR *screen)
+{
+    work->vertices[index].vx = screen->vx - screen->vx * work->scales[index] / 16;
+    work->vertices[index].vy = screen->vy - screen->vy * work->scales[index] / 16;
+    work->vertices[index].vz = 320;
+}
+
+static void InverseLightProject(InverseLightWork *work, SVECTOR *screen)
+{
+    int packed, p, flag;
+
+    SetRotMatrix(&DG_Chanl(0)->eye_inv);
+    SetTransMatrix(&DG_Chanl(0)->eye_inv);
+    RotTransPers(&work->position, &packed, &p, &flag);
+    screen->vx = (short)packed;
+    screen->vy = (short)((unsigned int)packed >> 16);
+}
+
+static void InverseLightAct(InverseLightWork *work)
+{
+    SVECTOR screen;
+    int i;
+
+    if (work->timer <= 0)
+    {
+        GV_DestroyActor(&work->actor);
+        return;
+    }
+    GM_CurrentMap = work->map;
+    if (work->timer == 15)
+    {
+        AN_Stn_G_Sonic(&work->position);
+        AN_Stn_G_Center(&work->position);
+        NewStnFade();
+        sub_800790E8();
+    }
+    if (work->timer == 14)
+    {
+        sub_8007913C();
+    }
+    InverseLightProject(work, &screen);
+    for (i = 0; i < 8; ++i)
+    {
+        InverseLightVertex(work, i, &screen);
+    }
+    --work->timer;
+}
+
+static void InverseLightDie(InverseLightWork *work)
+{
+    int i;
+
+    for (i = 0; i < 8; ++i)
+    {
+        if (work->prims[i])
+        {
+            DG_DequeuePrim(work->prims[i]);
+            DG_FreePrim(work->prims[i]);
+        }
+    }
+}
+
+static int InverseLightPrim(InverseLightWork *work, int index, DG_TEX *texture)
+{
+    DG_PRIM *prim;
+    POLY_FT4 *packet;
+    int buffer;
+
+    prim = GM_MakePrim(DG_PRIM_RECTANGLE | DG_PRIM_ON_CAMERA | DG_PRIM_POLY_FT4,
+                       1, &work->vertices[index], &work->rects[index]);
+    if (!prim)
+    {
+        return -1;
+    }
+    work->prims[index] = prim;
+    prim->raise = 320;
+    for (buffer = 0; buffer < 2; ++buffer)
+    {
+        packet = (POLY_FT4 *)prim->packs[buffer];
+        setPolyFT4(packet);
+        setRGB0(packet, 30 - 5 * buffer, 30 - 5 * buffer, 30 - 5 * buffer);
+        DG_SetPacketTexture4(packet, texture);
+        setSemiTrans(packet, 1);
+    }
+    return 0;
+}
+
+void *NewInverseLight(SVECTOR *position)
+{
+    static const short dimensions[8][2] = {
+        {8, 8}, {34, 11}, {6, 20}, {25, 33},
+        {12, 37}, {70, 50}, {11, -7}, {50, -9}
+    };
+    InverseLightWork *work;
+    DG_TEX *texture;
+    SVECTOR screen;
+    int i;
+
+    work = GV_NewActor(GV_ACTOR_USER, sizeof(InverseLightWork));
+    if (!work)
+    {
+        return NULL;
+    }
+    GV_SetNamedActor(&work->actor, InverseLightAct, InverseLightDie, "inverlt.c");
+    work->timer = 15;
+    work->map = GM_CurrentMap;
+    work->position = *position;
+    InverseLightProject(work, &screen);
+    texture = DG_GetTexture(GV_StrCode("refrection6"));
+    if (!texture)
+    {
+        GV_DestroyActor(&work->actor);
+        return NULL;
+    }
+    for (i = 0; i < 8; ++i)
+    {
+        work->rects[i].x = work->rects[i].y = dimensions[i][0] / 2;
+        work->rects[i].w = work->rects[i].h = dimensions[i][0];
+        work->scales[i] = dimensions[i][1];
+        InverseLightVertex(work, i, &screen);
+        if (InverseLightPrim(work, i, texture) < 0)
+        {
+            GV_DestroyActor(&work->actor);
+            return NULL;
+        }
+    }
+    return work;
+}
