diff --git a/source/overlays/s10a/animal/zako10/zk10act.c b/source/overlays/s10a/animal/zako10/zk10act.c
new file mode 100644
index 000000000..07903f025
--- /dev/null
+++ b/source/overlays/s10a/animal/zako10/zk10act.c
@@ -0,0 +1,318 @@
+#include "zako10.h"
+
+#include "enemy/asiato.h"
+
+/*---------------------------------------------------------------------------*/
+
+static void SetRadarParam(Work *work)
+{
+    VISION            *vision;
+    RADAR_SIGHT_PARAM *r_param;
+
+    vision = &work->vision;
+    r_param = &work->control.radar_param;
+
+    r_param->dir = vision->facedir;
+    r_param->dis = vision->length;
+    r_param->range = vision->range * 2;
+    r_param->r = 0;
+}
+
+static void CheckTarget(Work *work)
+{
+    if (work->modetime[7] & 0x4)
+    {
+        if (work->target->damaged & (TARGET_CAPTURE | TARGET_POWER))
+        {
+            work->modetime[6] |= 0x4;
+        }
+        else if ((work->touch.damaged & TARGET_TOUCH) &&
+                 (GM_PlayerStatus & (PLAYER_MOVE | PLAYER_CB_BOX)) != PLAYER_CB_BOX)
+        {
+            work->modetime[6] |= 0xC;
+        }
+    }
+}
+
+static int ZoneDist(HZD_HDL *hzd, SVECTOR *vec1, SVECTOR *vec2)
+{
+    int from, to;
+
+    from = HZD_GetAddress(hzd, vec1, -1);
+    to = HZD_GetAddress(hzd, vec2, -1);
+    from &= 0xFF;
+    to &= 0xFF;
+    return HZD_ZoneDistance(hzd, from, to);
+}
+
+static void CheckNoise(Work *work)
+{
+    CONTROL *control;
+
+    if (!(work->modetime[7] & 0x1))
+        return;
+    if (work->act_status & 0x68)
+        return;
+
+    control = &work->control;
+    if (!(control->map->index & GM_PlayerMap))
+        return;
+    if (GM_NoisePower == 0)
+        return;
+
+    switch (GM_NoisePower)
+    {
+    case 5:
+        if (GV_DiffVec3(&GM_NoisePosition, &control->mov) < 500)
+            work->modetime[6] |= 0x1;
+        break;
+    case 200:
+        if (GV_DiffVec3(&GM_NoisePosition, &control->mov) < 8000)
+            work->modetime[6] |= 0x1;
+        break;
+    case 100:
+        if (GV_DiffVec3(&GM_NoisePosition, &control->mov) >= 8000)
+            break;
+        if (ZoneDist(control->map->hzd, &control->mov, &GM_NoisePosition) >= 300)
+            break;
+        work->modetime[6] |= 0x1;
+        GM_NoiseLength = 0;
+        GM_NoisePower = 0;
+        break;
+    case 255:
+        work->modetime[6] |= 0x1;
+        break;
+    }
+}
+
+static void CheckBox(Work *work)
+{
+    if (!(work->modetime[7] & 0x2))
+        return;
+    if (work->vision.pad != 2)
+        return;
+    if (!(GM_PlayerStatus & PLAYER_CB_BOX))
+        return;
+
+    if (GV_DiffVec3(&work->player_pos, &GM_PlayerPosition) > 50 || work->player_dir != GM_WhereList[0]->rot.vy)
+    {
+        if (Z10_Command.alert_mode == 1)
+            return;
+        work->player_pos = GM_PlayerPosition;
+        work->player_dir = GM_WhereList[0]->rot.vy;
+        work->modetime[6] |= 0x2;
+    }
+    else if (GV_DiffVec3(&work->control.mov, &GM_PlayerPosition) < 1500)
+    {
+        work->modetime[6] |= 0x40;
+    }
+
+    work->vision.pad = 0;
+    work->modetime[6] |= 0x80;
+}
+
+static void CheckAsiato(Work *work)
+{
+    HZD_HDL *hzd;
+    SVECTOR *pos;
+    VISION  *vis;
+
+    if (!(work->modetime[7] & 0x10) || work->think2 == 5)
+        return;
+
+    hzd = work->control.map->hzd;
+    pos = &work->control.mov;
+    vis = &work->vision;
+
+    if (AsiatoCheck(hzd, pos) && SearchNearAsiato(hzd, pos, vis->facedir, vis->range, vis->length) >= 0)
+    {
+        work->modetime[6] |= 0x10;
+    }
+}
+
+static void CheckAlert(Work *work)
+{
+    work->modetime[6] = 0;
+    CheckNoise(work);
+
+    if (Z10_Command.alert_mode != 1)
+    {
+        CheckTarget(work);
+        CheckBox(work);
+        CheckAsiato(work);
+    }
+}
+
+static void UpdateAlert(Work *work)
+{
+    switch (work->vision.pad)
+    {
+    case 0:
+        if (work->field_B90 != 2 || !(GM_PlayerStatus & PLAYER_INTRUDE) || work->vision.length == 0)
+        {
+            work->field_B90 = 0;
+            work->alert_level -= 4;
+        }
+        break;
+    case 1:
+        work->field_B90 = 1;
+        work->alert_level--;
+        break;
+    case 2:
+        work->field_B90 = 2;
+        work->alert_level++;
+        break;
+    }
+
+    if (work->alert_level < 0)
+    {
+        work->alert_level = 0;
+    }
+    else if (work->alert_level > 255)
+    {
+        work->alert_level = 255;
+    }
+}
+
+static void CheckVision(Work *work)
+{
+    SVECTOR  tmp;
+    CONTROL *control;
+    SVECTOR *pos;
+    int      dir, dis, height;
+    MAP     *map;
+
+    control = &work->control;
+    pos = &GM_PlayerPosition;
+    GV_SubVec3(pos, &control->mov, &tmp);
+
+    dir = GV_VecDir2(&tmp);
+    work->sn_dir = dir;
+
+    dis = GV_VecLen3(&tmp);
+    work->sn_dis = dis;
+
+    height = ABS(pos->vy - work->control.mov.vy);
+
+    if (!(work->control.map->index & GM_PlayerMap))
+    {
+        work->vision.pad = 0;
+        return;
+    }
+
+    if (GM_PlayerStatus & PLAYER_INTRUDE)
+    {
+        work->vision.pad = 0;
+        return;
+    }
+
+    if ((Z10_Command.time % Z10_Command.n_watchers) != work->param.index)
+    {
+        return;
+    }
+
+    if (dis > (Z10_EyeLength + 2000))
+    {
+        work->vision.pad = 0;
+        return;
+    }
+
+    if (height > 2000)
+    {
+        work->vision.pad = 0;
+        return;
+    }
+
+    if (dis >= 500 && GV_DiffDirAbs(work->vision.facedir, dir) >= work->vision.range)
+    {
+        work->vision.pad = 0;
+        return;
+    }
+
+    map = work->control.map;
+    if (!HZD_OnlineHazardCheck(map->hzd, pos, &control->mov, HZD_CHK_ALL, HZD_SEG_NO_PLAYER) &&
+        !GM_OnlineTargetCheckAny(&control->mov, pos, map->index, &tmp))
+    {
+        if (dis > work->vision.length)
+        {
+            work->vision.pad = 1;
+        }
+        else
+        {
+            work->vision.pad = 2;
+        }
+    }
+    else
+    {
+        work->vision.pad = 0;
+    }
+}
+
+/*---------------------------------------------------------------------------*/
+
+void Z10_ActionMain(Work *work)
+{
+    if (work->act.motion1 <= 48)
+    {
+        SetRadarParam(work);
+        CheckVision(work);
+        CheckAlert(work);
+        UpdateAlert(work);
+        Z10_Think(work);
+        Z10_ExecPutChars(work);
+    }
+
+    Z10_ActionUpdate(work);
+}
+
+void Z10_PushMove(Work *work)
+{
+    TARGET  *trg;
+    int      turn, motion1;
+    CONTROL *control;
+
+    trg = work->target;
+    turn = 0;
+
+    if (!(trg->damaged & TARGET_PUSH))
+        return;
+
+    GV_AddVec3(&trg->offset, &work->control.step, &work->control.step);
+    trg->damaged &= ~TARGET_PUSH;
+
+    motion1 = work->act.motion1;
+    if (motion1 == 1 || motion1 == 2)
+    {
+        if (trg->offset.pad != 0)
+        {
+            if (GV_Time & 256)
+            {
+                if (work->param.index & 1)
+                {
+                    turn = trg->offset.pad * 1024;
+                }
+                else
+                {
+                    turn = (trg->offset.pad + 2) * 1024;
+                }
+            }
+            else
+            {
+                if (work->param.index & 1)
+                {
+                    turn = (trg->offset.pad + 2) * 1024;
+                }
+                else
+                {
+                    turn = trg->offset.pad * 1024;
+                }
+            }
+
+            turn &= 4095;
+        }
+
+        control = &work->control;
+        control->turn.vy = turn;
+        control->r_sphere = GV_NearExp2(control->r_sphere, work->act.field_1C);
+    }
+}
diff --git a/source/overlays/s10a/animal/zako10/zk10com.c b/source/overlays/s10a/animal/zako10/zk10com.c
new file mode 100644
index 000000000..e31546c0d
--- /dev/null
+++ b/source/overlays/s10a/animal/zako10/zk10com.c
@@ -0,0 +1,366 @@
+#include "zako10.h"
+#include "enemy/asiato.h"
+#include "game/vibrate.h"
+#include "libgcl/libgcl.h"
+
+SVECTOR      Z10_TargetSize = {300, 1500, 300, 0};
+SVECTOR      Z10_TargetForce;
+SVECTOR      Z10_AttackSize = {800, 500, 800, 0};
+SVECTOR      Z10_AttackForce = {100, 0, 0, 0};
+SVECTOR      Z10_TouchSize = {300, 800, 300, 0};
+SVECTOR      Z10_TouchForce;
+SVECTOR      Z10_NoPoint = {30000, 30000, 30000, 0};
+int          Z10_EyeLength = 4000;
+Z10Commander Z10_Command;
+int          Z10_Mode, Z10_Alert, Z10_Unknown, Z10_Activated;
+int          Z10_PlayerAddress, Z10_PlayerMap;
+SVECTOR      Z10_PlayerPosition;
+
+static const int     chase_distance[8] = {4000, 4000, 7000, 8000, 8000, 8000, 8000, 8000};
+static unsigned char vibration_h[] = {1, 10, 0, 0};
+static unsigned char vibration_l[] = {255, 10, 0, 0};
+
+typedef struct
+{
+    GV_ACT actor;
+    int    unused;
+} CommanderWork;
+
+int Z10_SetWorkID(Work *work)
+{
+    for (int index = 0; index < 8; index++)
+    {
+        Z10Watcher *watcher = &Z10_Command.watchers[index];
+        if (watcher->work == NULL)
+        {
+            watcher->work = work;
+            watcher->state = 2;
+            return index;
+        }
+    }
+    return -1;
+}
+
+void Z10_ResetWorkID(int index)
+{
+    Z10_Command.watchers[index].work = NULL;
+    Z10_Command.watchers[index].state = 1;
+}
+
+void Z10_TargetLast(void)
+{
+    Z10_Command.target_addr = Z10_PlayerAddress;
+    Z10_Command.target_pos = Z10_PlayerPosition;
+    Z10_Command.target_map = Z10_PlayerMap;
+}
+
+void Z10_TargetNoise(void)
+{
+    Z10_Command.target_addr = HZD_GetAddress(GM_WhereList[0]->map->hzd, &GM_NoisePosition, -1);
+    Z10_Command.target_pos = GM_NoisePosition;
+    Z10_Command.target_map = GM_PlayerMap;
+}
+
+int Z10_FindRoute(int map, int zone)
+{
+    Z10RouteMap *routes = &Z10_Command.routes;
+    if (routes->map != map)
+        return 0;
+    for (int index = 0; index < routes->count; index++)
+        if (routes->data[index][0] == zone)
+            return routes->data[index][1];
+    return -1;
+}
+
+static int ReadRoutes(Z10RouteMap *routes)
+{
+    int count = 0;
+    do
+    {
+        routes->data[count][0] = GCL_StrToInt(GCL_NextStr());
+        routes->data[count][1] = GCL_StrToInt(GCL_NextStr());
+        count++;
+    } while (GCL_NextStr() != NULL);
+    return count;
+}
+
+static int ReadZones(short *zones)
+{
+    int   count = 0;
+    char *value;
+    while ((value = GCL_NextStr()) != NULL)
+        zones[count++] = GCL_StrToInt(value);
+    return count;
+}
+
+static void FindFarZone(void)
+{
+    int longest = 0;
+    int farthest = 0;
+    for (int index = 0; index < Z10_Command.n_zones; index++)
+    {
+        HZD_ZON *zone = HZD_GetZone(Z10_Command.map->hzd, Z10_Command.zones[index]);
+        SVECTOR  position = {zone->x, GM_PlayerPosition.vy, zone->z, 0};
+        int      distance = GV_DiffVec3(&position, &GM_PlayerPosition);
+        if (distance > longest)
+        {
+            longest = distance;
+            farthest = index;
+        }
+    }
+    Z10_Command.far_zone = farthest;
+}
+
+static void SortWatchers(void)
+{
+    int distance[8];
+    int count = Z10_Command.n_watchers;
+    for (int index = 0; index < count; index++)
+        distance[index] = Z10_Command.watchers[Z10_Command.order[index]].work->sn_dis;
+    int last = count - 1;
+    while (last >= 0)
+    {
+        int swapped = -1;
+        for (int index = 1; index <= last; index++)
+        {
+            if (distance[index] < distance[index - 1])
+            {
+                int temporary = distance[index - 1];
+                distance[index - 1] = distance[index];
+                distance[index] = temporary;
+                temporary = Z10_Command.order[index - 1];
+                Z10_Command.order[index - 1] = Z10_Command.order[index];
+                Z10_Command.order[index] = temporary;
+                swapped = index - 1;
+            }
+        }
+        last = swapped;
+    }
+    for (int index = 0; index < count; index++)
+    {
+        int id = Z10_Command.order[index];
+        Z10_Command.watchers[id].work->chase_dis = chase_distance[id];
+    }
+}
+
+static void UpdateWatcher(Z10Watcher *watcher)
+{
+    switch (watcher->field_8)
+    {
+    case 0:
+        if (watcher->state == 1)
+        {
+            watcher->field_8 = 1;
+            watcher->field_0 = 1;
+            Z10_Command.field_64++;
+        }
+        break;
+    case 1:
+        if (--watcher->field_0 <= 0)
+        {
+            watcher->field_8 = 2;
+            watcher->field_0 = 0;
+        }
+        break;
+    case 2:
+        if ((Z10_Command.alert_mode == 0 && (Z10_Command.field_110 & 1)) ||
+            (Z10_Command.alert_mode == 1 && Z10_Command.field_64 < 255 &&
+             (unsigned char)watcher->work->param.next == 255))
+        {
+            FindFarZone();
+            watcher->state = 2;
+            watcher->field_8 = 0;
+        }
+        break;
+    }
+}
+
+static void UpdateAlertLevel(int level)
+{
+    if (Z10_Command.alert_level - level < 5)
+        Z10_Command.alert_level = level;
+    else
+        Z10_Command.alert_level -= 4;
+    if (Z10_Command.alert_level < Z10_Alert)
+        Z10_Command.alert_level = Z10_Alert;
+    Z10_Alert = 0;
+}
+
+static void UpdateAlertMode(void)
+{
+    switch (Z10_Command.alert_mode)
+    {
+    case 0:
+        if (Z10_Command.alert_level >= 255)
+        {
+            Z10_Command.alert_mode = 1;
+            Z10_Command.alert_level = 255;
+            GM_SeSet2(0, 63, 42);
+            Z10_Command.field_64 = 0;
+        }
+        break;
+    case 1:
+        if (Z10_Command.alert_level <= 0)
+        {
+            Z10_Command.alert_mode = 2;
+            Z10_Command.alert_time = 300;
+        }
+        GM_AlertMax = MAX(GM_AlertMax, MIN(Z10_Command.alert_level, 256));
+        break;
+    case 2:
+        if (--Z10_Command.alert_time <= 0)
+        {
+            Z10_Command.alert_mode = 0;
+            Z10_Command.alert_time = 0;
+        }
+        if (Z10_Command.alert_level >= 255)
+        {
+            Z10_Command.alert_level = 255;
+            Z10_Command.alert_mode = 1;
+            Z10_Command.field_64 = 0;
+        }
+        GM_AlertMax = MAX(GM_AlertMax, MIN(Z10_Command.alert_time, 256));
+        break;
+    }
+    Z10_Mode = Z10_Command.alert_mode;
+}
+
+static void UpdateCommander(void)
+{
+    int alert = 0;
+    for (int index = 0; index < Z10_Command.n_watchers; index++)
+    {
+        Z10Watcher *watcher = &Z10_Command.watchers[index];
+        if (watcher->state == 2)
+            alert = MAX(alert, watcher->work->alert_level);
+        else if (watcher->state == 1)
+            UpdateWatcher(watcher);
+    }
+    UpdateAlertLevel(alert);
+    UpdateAlertMode();
+    SortWatchers();
+    Z10_Command.field_110 = 0;
+}
+
+static void UpdatePlayer(void)
+{
+    int address = GM_PlayerAddress;
+    if ((address & 255) == ((address >> 8) & 255) && (address & 255) != 255)
+    {
+        Z10_PlayerAddress = address;
+        Z10_PlayerPosition = GM_PlayerPosition;
+        Z10_PlayerMap = GM_PlayerMap;
+    }
+}
+
+static int ExecProcs(char *parameter)
+{
+    int count = 0;
+    while (parameter)
+    {
+        int proc = GCL_StrToInt(parameter);
+        parameter = GCL_NextStr();
+        GCL_ExecProc(proc, NULL);
+        count++;
+    }
+    return count;
+}
+
+static int ReceiveCommand(void)
+{
+    GV_MSG *message;
+    return GV_ReceiveMessage(Z10_Command.name, &message) > 0 ? message->message[0] : -1;
+}
+
+static void UpdateActivation(void)
+{
+    if (Z10_Activated == 1)
+    {
+        if (Z10_Command.time2 >= 31 && GM_StreamStatus() == 1)
+            GM_StreamPlayStart();
+    }
+    else if (Z10_Activated == 0 && ReceiveCommand() == 1)
+    {
+        Z10_Activated = 1;
+        NewPadVibration(vibration_h, 1);
+        NewPadVibration(vibration_l, 2);
+        if (GM_StreamStatus() == -1)
+            GM_VoxStream(Z10_Command.voice, 0x40000000);
+        Z10_Command.time2 = 0;
+    }
+    Z10_Command.time2++;
+}
+
+static void Act(CommanderWork *work)
+{
+    (void)work;
+    UpdateActivation();
+    UpdatePlayer();
+    UpdateCommander();
+    Z10_Command.time++;
+}
+
+/* The original commander destructor at 800CEC3C has no side effects. */
+static void Die(CommanderWork *work)
+{
+    (void)work;
+}
+
+static void GetResources(int name, int where)
+{
+    Z10_Activated = Z10_Command.field_24 = Z10_Command.alert_level = 0;
+    Z10_Command.name = name;
+    for (int index = 0; index < 8; index++)
+    {
+        Z10_Command.watchers[index] = (Z10Watcher){0};
+        Z10_Command.order[index] = index;
+    }
+    Z10_Command.time = Z10_Command.alert_mode = Z10_Mode = Z10_Alert = 0;
+    Z10_Command.map = GM_GetMap((short)where);
+    if (GCL_GetOption('v'))
+        Z10_Command.n_zones = ReadZones(Z10_Command.zones);
+    else
+    {
+        Z10_Command.n_zones = 1;
+        Z10_Command.zones[0] = 0;
+    }
+    Z10_Command.far_zone = 0;
+    char *option = GCL_GetOption('f');
+    if (option)
+        GCL_StrToInt(option);
+    Z10_Unknown = 1;
+    NewAsiato(0, 0, 0, NULL);
+    if (GCL_GetOption('j'))
+        Z10_Command.routes.count = ReadRoutes(&Z10_Command.routes);
+    else
+    {
+        Z10_Command.routes.count = 1;
+        Z10_Command.routes.data[0][0] = Z10_Command.routes.data[0][1] = 0;
+    }
+    Z10_Command.routes.map = where;
+    Z10_Command.voice = GCL_GetOption('b') ? GCL_StrToInt(GCL_NextStr()) : 0;
+    Z10_Command.n_watchers = 0;
+    option = GCL_GetOption('n');
+    if (option)
+        Z10_Command.n_watchers = ExecProcs(option);
+    Z10_Command.max_activations = 0;
+    option = GCL_GetOption('c');
+    if (option)
+        Z10_Command.max_activations = ExecProcs(option);
+    Z10_Command.activation_delay = 0;
+    option = GCL_GetOption('s');
+    if (option)
+        Z10_Command.activation_delay = ExecProcs(option);
+    Z10_Command.field_114 = 0;
+}
+
+void *NewZako10Commander(int name, int where)
+{
+    CommanderWork *work = GV_NewActor(GV_ACTOR_PREV, sizeof(CommanderWork));
+    if (work)
+    {
+        GV_SetNamedActor(work, Act, Die, "zk10com.c");
+        GetResources(name, where);
+    }
+    return work;
+}
