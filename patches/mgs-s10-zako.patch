diff --git a/source/overlays/s10a/animal/zako10/action.c b/source/overlays/s10a/animal/zako10/action.c
new file mode 100644
index 000000000..f74ac8d71
--- /dev/null
+++ b/source/overlays/s10a/animal/zako10/action.c
@@ -0,0 +1,230 @@
+#include "zako10.h"
+
+short Z10_ActionTable[52] = {0, 1, 1, 2};
+
+static void Idle(Work *work, int time);
+static void Walk(Work *work, int time);
+static void Turn(Work *work, int time);
+static void ReadyGun(Work *work, int time);
+static void Fire(Work *work, int time);
+
+/* Integral's CAA80, CAB70, CADAC..CADBC and CAF50..CAFA0 are jr ra/nop. */
+static void InactiveAction(Work *work, int time)
+{
+    (void)work;
+    (void)time;
+}
+
+static int TouchSide(int from, int to)
+{
+    if (to < 0 || from < 0)
+        return 0;
+    int difference = GV_DiffDirS(from, to);
+    if (difference < -896 || difference > 896)
+        return 0;
+    return difference < 0 ? 2 : 1;
+}
+
+static void ReviseReadyGun(Work *work)
+{
+    int player_height = GM_PlayerBody->objs->objs[6].world.t[1];
+    int height = work->body.objs->objs[6].world.t[1];
+    int angle = ratan2(work->sn_dis, player_height - height) & 4095;
+    int rotation = GV_NearExp8(work->adjust[2].vx, angle - 1024);
+    work->adjust[2].vx = work->adjust[6].vx = rotation;
+    work->adjust[7].vx = rotation < 0 ? rotation * 3 : rotation * 3 / 2;
+}
+
+static int SelectAction(Work *work)
+{
+    int press = work->pad.press;
+    if (press & 0x1802EC7)
+    {
+        if (work->action2 == NULL)
+        {
+            work->action2 = InactiveAction;
+            work->time2 = 0;
+        }
+        work->control.turn.vx = work->control.turn.vz = 0;
+        GM_ConfigMotionAdjust(&work->body, NULL);
+        return 0;
+    }
+    if (press & 0x100)
+        SetMode(work, InactiveAction);
+    else if (press & 0x20)
+        SetMode(work, Turn);
+    else if (press & 0x400000)
+        SetMode(work, InactiveAction);
+    else if (press & 0x30000)
+    {
+        SetMode(work, ReadyGun);
+        work->adjust[2].vx = 0;
+    }
+    else
+        return 0;
+    return 1;
+}
+
+static void Idle(Work *work, int time)
+{
+    work->target->class |= TARGET_FLAG;
+    work->act_status |= 1;
+    if (Z10_Command.alert_mode == 0)
+        work->target->class |= TARGET_C4;
+    work->vision.length = Z10_EyeLength;
+    if (time == 0)
+        SetAction(work, 0, 4);
+    if (SelectAction(work))
+    {
+        UnsetMode(work);
+        return;
+    }
+    if (work->pad.dir >= 0)
+    {
+        if (GV_DiffDirAbs(work->control.rot.vy, work->pad.dir) >= 256)
+            work->control.turn.vy = work->pad.dir;
+        else
+        {
+            SetAction(work, work->pad.field_4 & 1 ? 2 : 1, 4);
+            SetMode(work, Walk);
+        }
+    }
+    work->vision.facedir = work->control.rot.vy;
+}
+
+static void Walk(Work *work, int time)
+{
+    (void)time;
+    work->target->class |= TARGET_FLAG;
+    if (Z10_Command.alert_mode == 0)
+        work->target->class |= TARGET_C4;
+    work->vision.length = Z10_EyeLength;
+    if (SelectAction(work))
+    {
+        UnsetMode(work);
+        return;
+    }
+    CONTROL *control = &work->control;
+    int      direction = work->pad.dir;
+    int      motion = work->act.motion1;
+    int      touch = -1;
+    if ((work->pad.field_4 & 1) && motion != 2)
+        SetAction(work, 2, 4);
+    if (direction < 0)
+    {
+        SetMode(work, Idle);
+        UnsetMode(work);
+        return;
+    }
+    if (control->n_touches > 0)
+    {
+        touch = GV_VecDir2(&control->vecs[0]);
+        if (control->n_touches > 1)
+        {
+            int second = GV_VecDir2(&control->vecs[1]);
+            if (GV_DiffDirAbs(direction, second) < GV_DiffDirAbs(direction, touch))
+                touch = second;
+        }
+    }
+    int side = TouchSide(direction, touch);
+    if (side == 1)
+        direction = (touch - 1024) & 4095;
+    else if (side == 2)
+        direction = (touch + 1024) & 4095;
+    if (work->body.objs->bound_mode == 0)
+        control->rot.vy = direction;
+    control->turn.vy = direction;
+    int speed = motion == 1 ? 50 : motion == 2 ? 100 : 0;
+    control->step.vx = speed * rsin(direction) / 4096;
+    control->step.vz = speed * rcos(direction) / 4096;
+    work->vision.facedir = control->rot.vy;
+}
+
+static void Turn(Work *work, int time)
+{
+    work->target->class |= TARGET_FLAG;
+    work->vision.length = Z10_EyeLength;
+    if (time == 0)
+        SetAction(work, 16, 4);
+    if (work->body.is_end || !(work->pad.press & 0x20))
+        SetMode(work, Idle);
+    else
+    {
+        work->control.turn.vy = work->sn_dir;
+        work->control.step.vx = work->control.step.vz = 0;
+        work->vision.facedir = work->control.rot.vy;
+    }
+}
+
+static void ReadyGun(Work *work, int time)
+{
+    work->target->class |= TARGET_FLAG;
+    work->vision.length = Z10_EyeLength;
+    int press = work->pad.press;
+    if (time == 0)
+    {
+        SetAction(work, press & 0x10000 ? 3 : 5, 4);
+        GM_ConfigMotionAdjust(&work->body, work->adjust);
+        GM_SeSetMode(&work->control.mov, 178, 1);
+    }
+    ReviseReadyGun(work);
+    if (!(press & 0x30000))
+        SetMode(work, Idle);
+    else if (press & 0x40000)
+        SetModeNoAdjust(work, Fire);
+    else if (press & 0x80000)
+        SetMode(work, InactiveAction);
+    else if (press & 0x300000)
+        SetModeNoAdjust(work, InactiveAction);
+    else
+    {
+        work->control.turn.vy = work->pad.dir;
+        work->vision.facedir = work->control.rot.vy;
+    }
+}
+
+static void Fire(Work *work, int time)
+{
+    work->target->class |= TARGET_FLAG;
+    work->vision.length = Z10_EyeLength;
+    if (time == 0)
+    {
+        SetAction(work, 4, 0);
+        Z10_SetPutChar(work, 3);
+        GM_ConfigMotionAdjust(&work->body, work->adjust);
+    }
+    ReviseReadyGun(work);
+    SetModeNoAdjust(work, ReadyGun);
+}
+
+void Z10_ActionUpdate(Work *work)
+{
+    ACT     *act = &work->act;
+    CONTROL *control = &work->control;
+    work->trigger = 0;
+    work->vision.length = 0;
+    work->target->class = TARGET_AVAIL;
+    work->field_8FC = 0;
+    work->act_status = 0;
+    work->suppress_step = 0;
+    ACTION action = work->action;
+    control->height = work->body.height * work->scale / 4096;
+    control->hzd_height = control->levels[0] + 750;
+    int time = work->time++;
+    if (action == NULL)
+        action = work->action = Idle;
+    action(work, time);
+    if (work->action2)
+    {
+        time = work->time2++;
+        work->action2(work, time);
+    }
+    control->r_sphere = act->field_1E ? -1 : GV_NearExp2(control->r_sphere, act->field_1C);
+    work->hom->flag = (work->target->class & TARGET_POWER) != 0;
+    if (act->field_04 < 0 && control->grounded)
+        act->field_04 = 0;
+    act->field_04 -= 16;
+    control->step.vy = act->field_04;
+    if (work->mark_time > 0)
+        work->mark_time--;
+}
diff --git a/source/overlays/s10a/animal/zako10/put.c b/source/overlays/s10a/animal/zako10/put.c
new file mode 100644
index 000000000..c7063020d
--- /dev/null
+++ b/source/overlays/s10a/animal/zako10/put.c
@@ -0,0 +1,156 @@
+#include "zako10.h"
+#include "anime/animconv/anime.h"
+#include "enemy/l_sight.h"
+#include "okajima/bullet.h"
+
+extern void *AN_Breath(MATRIX *world);
+extern void *AN_HeadMark(MATRIX *world, int mark);
+
+static void    PutSound(Work *work);
+static void    PutBreath(Work *work);
+static void    PutLaserSight(Work *work);
+static void    PutBullet(Work *work);
+static int     ClearPutChar(Work *work, PUTFUNC function);
+static PUTFUNC put_chars[] = {PutSound, PutBreath, PutLaserSight, PutBullet};
+static SVECTOR bullet_offset = {5, -500, 80, 0};
+
+void Z10_PutMark(Work *work, int mark)
+{
+    MATRIX *world;
+
+    if (!(work->control.map->index & GM_PlayerMap))
+        return;
+    world = &work->body.objs->objs[6].world;
+
+    if (mark == 0)
+        GM_SeSet(&work->control.mov, SE_EXCLAMATION);
+    if (work->mark_time != 0)
+        GV_DestroyActor(work->mark);
+
+    work->mark = AN_HeadMark(world, mark);
+    work->mark_time = 30;
+}
+
+static void PutSound(Work *work)
+{
+    int action = work->act.motion1;
+    int frame = work->m_ctrl.info1.frame;
+    int left = 160 + (work->param.index % 4) * 2;
+    int right = left + 1;
+    if ((action == 1 && frame == 22) || (action == 2 && frame == 16))
+        GM_SeSet(&work->control.mov, right);
+    else if ((action == 1 && frame == 11) || (action == 2 && frame == 8))
+        GM_SeSet(&work->control.mov, left);
+}
+
+static void PutBreath(Work *work)
+{
+    int frame;
+
+    if (Z10_Command.alert_mode == 1)
+        return;
+    if (!(work->control.map->index & GM_PlayerMap))
+        return;
+
+    if (work->act.motion2 == 20)
+    {
+        if (work->m_ctrl.info2.frame == 31)
+        {
+            AN_Breath(&work->body.objs->objs[6].world);
+        }
+    }
+    else if (work->act.motion2 == 22)
+    {
+        frame = work->m_ctrl.info2.frame;
+        if (frame == 15 || frame == 35 || frame == 50 || frame == 60 || frame == 70 || frame == 74 || frame == 78)
+        {
+            AN_Breath(&work->body.objs->objs[6].world);
+        }
+    }
+    else if (work->act.motion2 == 19)
+    {
+        frame = work->m_ctrl.info2.frame;
+        if (frame == 30 || frame == 40 || frame == 50 || frame == 60 || frame == 70 || frame == 80 || frame == 90 ||
+            frame == 95 || frame == 100 || frame == 105)
+        {
+            AN_Breath(&work->body.objs->objs[6].world);
+        }
+    }
+    else
+    {
+        if ((GV_Time % 64) == (work->param.index * 16))
+        {
+            AN_Breath(&work->body.objs->objs[6].world);
+        }
+    }
+}
+
+static void PutLaserSight(Work *work)
+{
+    if (work->vision.pad != 2)
+        return;
+    NewLSight(&GM_PlayerPosition, &work->control.mov, MAKE_RGB(143, 0, 0));
+}
+
+static void PutBullet(Work *work)
+{
+    SVECTOR rotation = DG_ZeroVector;
+    MATRIX  bullet;
+    rotation.vx = GV_RandS(16);
+    rotation.vz = GV_RandU(128);
+    MATRIX *world = &work->body.objs->objs[4].world;
+    DG_SetPos(world);
+    DG_MovePos(&bullet_offset);
+    DG_RotatePos(&rotation);
+    ReadRotMatrix(&bullet);
+    NewBulletEnemy(&bullet, 2, 1, 0, (GV_Time & 3) != 0);
+    GM_SeSetMode(&work->control.mov, 45, 1);
+    AN_BulletSmoke(world, 0);
+    AN_FamasFlash(&bullet);
+    ClearPutChar(work, PutBullet);
+}
+
+int Z10_SetPutChar(Work *work, int index)
+{
+    int i;
+
+    for (i = 0; i < 8; i++)
+    {
+        if (work->putchar[i] == NULL)
+        {
+            work->putchar[i] = put_chars[index];
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+static int ClearPutChar(Work *work, PUTFUNC func)
+{
+    int i;
+
+    for (i = 0; i < 8; i++)
+    {
+        if (work->putchar[i] == func)
+        {
+            work->putchar[i] = NULL;
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+void Z10_ExecPutChars(Work *work)
+{
+    int i;
+    void (*func)(Work *);
+
+    for (i = 0; i < 8; i++)
+    {
+        func = work->putchar[i];
+        if (func != NULL)
+            func(work);
+    }
+}
diff --git a/source/overlays/s10a/animal/zako10/think.c b/source/overlays/s10a/animal/zako10/think.c
new file mode 100644
index 000000000..d7aa8a151
--- /dev/null
+++ b/source/overlays/s10a/animal/zako10/think.c
@@ -0,0 +1,653 @@
+#include "zako10.h"
+#include "enemy/asiato.h"
+#include "enemy/eyeflash.h"
+
+extern int NearAsiato(void);
+
+static const unsigned short action_chance[] = {100, 50, 25, 10};
+static const unsigned short action_time[] = {300, 15, 30, 60, 90, 0, 0, 30000};
+static const int            action_press[32] = {0, 1, 2, 4, 4, 64, 128, 512, 1024, 2048, 256, 65536, 0,
+                                                0, 0, 0, 0, 1, 2,  4,   4,   64,   128,  512, 1024,  2048};
+
+static void TargetStart(Work *work)
+{
+    work->target_addr = work->start_addr;
+    work->target_pos = work->start_pos;
+    work->target_map = work->start_map;
+}
+
+static void TargetPlayer(Work *work)
+{
+    work->target_addr = Z10_PlayerAddress;
+    work->target_pos = Z10_PlayerPosition;
+    work->target_map = Z10_PlayerMap;
+}
+
+static void TargetNoise(Work *work)
+{
+    work->target_addr = HZD_GetAddress(GM_WhereList[0]->map->hzd, &GM_NoisePosition, -1);
+    work->target_pos = GM_NoisePosition;
+    work->target_map = Z10_PlayerMap;
+}
+
+static void TargetLast(Work *work)
+{
+    work->target_addr = Z10_Command.target_addr;
+    work->target_pos = Z10_Command.target_pos;
+    work->target_map = Z10_Command.target_map;
+}
+
+static void TargetNext(Work *work)
+{
+    int      next = (unsigned char)work->param.next;
+    HZD_ZON *zone = HZD_GetZone(work->control.map->hzd, next);
+    work->target_addr = next | (next << 8);
+    work->target_pos.vx = zone->x;
+    work->target_pos.vy = zone->y;
+    work->target_pos.vz = zone->z;
+    work->target_map = work->start_map;
+}
+
+static void NextNode(Work *work)
+{
+    if (++work->next_node >= work->n_nodes)
+        work->next_node = 0;
+    work->target_pos = work->nodes[work->next_node];
+    work->target_addr = HZD_GetAddress(work->control.map->hzd, &work->target_pos, -1);
+    work->target_map = work->start_map;
+}
+
+static void ResetThink(Work *work)
+{
+    work->think1 = work->think2 = work->think3 = 0;
+    work->count3 = 0;
+    work->route_action = 0;
+}
+
+static void FoundPlayer(Work *work)
+{
+    work->think2 = 7;
+    work->think3 = 11;
+    work->count3 = 0;
+}
+
+static void PursuePlayer(Work *work)
+{
+    work->think1 = 1;
+    if ((unsigned char)work->param.next == 255)
+    {
+        work->think2 = 8;
+        work->think3 = 14;
+    }
+    else
+    {
+        work->think2 = 10;
+        work->think3 = 23;
+        TargetNext(work);
+    }
+    work->count3 = 0;
+    work->pad.field_4 = 1;
+}
+
+static void PursueLast(Work *work)
+{
+    if ((unsigned char)work->param.next == 255)
+        TargetLast(work);
+    else
+        TargetNext(work);
+    work->think1 = 1;
+    work->think2 = 10;
+    work->think3 = 23;
+    work->count3 = 0;
+    work->pad.field_4 = 1;
+}
+
+static void LeaveAlert(Work *work)
+{
+    work->think1 = 2;
+    if ((unsigned char)work->param.next == 255 && work->chase_dis < 7000)
+    {
+        TargetLast(work);
+        work->think2 = 12;
+    }
+    else if ((unsigned char)work->param.next != 255 &&
+             !HZD_InsideZone(work->control.map->hzd, &work->control.mov, (unsigned char)work->param.next))
+    {
+        TargetNext(work);
+        work->think2 = 11;
+    }
+    else
+    {
+        work->think2 = 13;
+        work->think3 = 24;
+        work->think4 = 2;
+        work->count3 = 0;
+        work->pad.field_4 = 0;
+        return;
+    }
+    work->count3 = 0;
+    work->pad.field_4 = 1;
+}
+
+static void HeardNoise(Work *work)
+{
+    if (GM_NoisePower == 5)
+    {
+        work->think2 = 1;
+        work->think3 = 7;
+    }
+    else if (GM_NoisePower == 200 || GM_NoisePower == 255)
+    {
+        TargetNoise(work);
+        Z10_TargetNoise();
+        work->think2 = 7;
+        work->think3 = 12;
+    }
+    else
+    {
+        TargetNoise(work);
+        work->think2 = 1;
+        work->think3 = 5;
+        work->modetime[0] = 0;
+    }
+    work->count3 = 0;
+}
+
+static int WaitReturn(Work *work)
+{
+    if (work->count3 == 0)
+        work->pad.sound = 245;
+    else if (work->count3 >= 33)
+        return 1;
+    work->count3++;
+    return 0;
+}
+
+static int Navigate(Work *work)
+{
+    MAP     *map = work->control.map;
+    HZD_HDL *hzd = map->hzd;
+    int      target = work->target_addr;
+    if (work->target_map != map->index)
+    {
+        int      next = Z10_FindRoute(map->index, work->target_map);
+        HZD_ZON *zone = HZD_GetZone(hzd, next);
+        work->target_pos.vx = zone->x;
+        work->target_pos.vy = zone->y;
+        work->target_pos.vz = zone->z;
+        target = next | (next << 8);
+    }
+    int address = HZD_GetAddress(hzd, &work->control.mov, work->current_addr);
+    work->current_addr = address;
+    int     reached = HZD_ReachTo(hzd, address, work->next_addr);
+    SVECTOR difference;
+    if (target == work->last_addr && reached > 0)
+    {
+        GV_SubVec3(&work->next_pos, &work->control.mov, &difference);
+        return GV_VecDir2(&difference);
+    }
+    work->last_addr = target;
+    if (HZD_ReachTo(hzd, address, target) >= 2)
+    {
+        int      next = HZD_Navigate(hzd, address, target, &work->control.mov);
+        HZD_ZON *zone = HZD_GetZone(hzd, next);
+        work->next_pos.vx = zone->x;
+        work->next_pos.vy = zone->y;
+        work->next_pos.vz = zone->z;
+        next &= 255;
+        work->next_addr = next | (next << 8);
+        GV_SubVec3(&work->next_pos, &work->control.mov, &difference);
+        return GV_VecDir2(&difference);
+    }
+    if (work->target_map == work->control.map->index)
+    {
+        work->next_pos = work->target_pos;
+        work->next_addr = target;
+        GV_SubVec3(&work->next_pos, &work->control.mov, &difference);
+        work->pad.dir = GV_VecDir2(&difference);
+        return -1;
+    }
+    int next = Z10_FindRoute(work->target_map, work->control.map->index);
+    work->control.map = GM_GetMap(work->target_map);
+    HZD_ZON *zone = HZD_GetZone(work->control.map->hzd, next);
+    work->control.mov.vx = zone->x;
+    work->control.mov.vy = zone->y;
+    work->control.mov.vz = zone->z;
+    work->current_addr = work->last_addr = -1;
+    return work->control.rot.vy;
+}
+
+static int MoveDirect(Work *work, int range)
+{
+    int x = work->target_pos.vx - work->control.mov.vx;
+    int z = work->target_pos.vz - work->control.mov.vz;
+    if (x > -range && x < range && z > -range && z < range)
+        return 1;
+    SVECTOR difference = {x, 0, z, 0};
+    work->pad.dir = GV_VecDir2(&difference);
+    work->count3++;
+    return 0;
+}
+
+static int MoveRoute(Work *work)
+{
+    if (work->pad.time != 0)
+    {
+        work->pad.press |= work->pad.field_8;
+        work->pad.time--;
+    }
+    return MoveDirect(work, 350) != 0;
+}
+
+static int SelectRouteAction(Work *work)
+{
+    int command = work->target_pos.pad;
+    int chance = (command & 0x1C00) >> 10;
+    if (GV_RandU(100) >= action_chance[chance & 3] || work->route_action == 1)
+    {
+        work->pad.time = work->pad.field_8 = 0;
+        work->route_action = 0;
+        return 0;
+    }
+    if (chance & 4)
+        work->route_action = 1;
+    work->pad.time = action_time[(command & 0xE0) >> 5];
+    work->pad.field_8 = action_press[command & 31];
+    if (command & 16)
+        return 0;
+    work->pad.dir = (command & 0x300) * 4;
+    return 1;
+}
+
+static int WaitRouteAction(Work *work)
+{
+    if (work->pad.time != 0)
+    {
+        work->pad.press |= work->pad.field_8;
+        work->pad.time--;
+    }
+    else if (work->action2 == NULL)
+        return 1;
+    return 0;
+}
+
+static int Surprise(Work *work)
+{
+    if (work->count3 == 0)
+    {
+        Z10_PutMark(work, 0);
+        GM_SeSet(&work->control.mov, 83);
+        NewEyeflash(&work->body.objs->objs[6].world, &work->control.mov, "kirari01", 0);
+    }
+    if ((unsigned)work->count3 >= 20)
+        return 1;
+    work->pad.press |= 0x20;
+    work->count3++;
+    return 0;
+}
+
+static int SurpriseNoise(Work *work)
+{
+    if (work->count3 == 0)
+    {
+        GM_SeSet(&work->control.mov, 83);
+        Z10_PutMark(work, 0);
+    }
+    if ((unsigned)work->count3 >= 21)
+        return 1;
+    work->count3++;
+    return 0;
+}
+
+static int MoveToTarget(Work *work)
+{
+    if (!(work->count3 & 31))
+    {
+        work->current_addr = work->last_addr = -1;
+        Navigate(work);
+    }
+    work->pad.dir = Navigate(work);
+    if (work->pad.dir < 0)
+        return 1;
+    work->count3++;
+    return 0;
+}
+
+static int MoveToPlayer(Work *work)
+{
+    TargetPlayer(work);
+    if (work->target_map != work->control.map->index)
+        return -1;
+    if (work->count3 & 16)
+    {
+        work->current_addr = HZD_GetAddress(work->control.map->hzd, &work->control.mov, -1);
+        if (HZD_ReachTo(work->control.map->hzd, work->current_addr, work->target_addr) >= 2)
+            return -1;
+    }
+    return MoveDirect(work, 1500);
+}
+
+static int Attack(Work *work, int action)
+{
+    int time = work->count3;
+    int ready = action == 17 ? 0x20000 : 0x10000;
+    work->pad.press |= ready;
+    if ((action == 16 && time == 4) || (action == 17 && time == 8) || (action == 21 && time >= 20))
+        return 1;
+    if (action == 19)
+    {
+        if (time == 30)
+            work->pad.press |= 0x100000;
+        else if (work->body.is_end)
+            return 1;
+    }
+    else if (action == 20)
+    {
+        if (time == 0)
+            work->pad.press |= 0x40000;
+        else if (work->body.is_end)
+            return 1;
+    }
+    else if (action == 21)
+    {
+        if (time < 10 && !(time & 1))
+            work->pad.press |= 0x40000;
+    }
+    else if (action == 16 && time == 0)
+        work->pad.press |= 0x40000;
+    else if (action == 17 && time == 0)
+        work->pad.press |= 0x80000;
+    work->pad.dir = work->sn_dir;
+    work->count3++;
+    return 0;
+}
+
+static void ReturnToRoute(Work *work)
+{
+    if (work->think3 == 3 && WaitReturn(work))
+    {
+        TargetStart(work);
+        work->next_node = work->n_nodes - 1;
+        ResetThink(work);
+        work->pad.field_4 = 1;
+    }
+    if (work->alert_level >= 2)
+        FoundPlayer(work);
+}
+
+static int ReloadRoute(Work *work)
+{
+    MAP     *map = GM_GetMap(work->start_map);
+    HZD_PAT *route = &map->hzd->def->routes[work->param.root];
+    work->n_nodes = route->n_points;
+    if (work->n_nodes <= 0)
+        return -1;
+    for (int index = 0; index < work->n_nodes; index++)
+    {
+        HZD_PTP *point = &route->points[index];
+        work->nodes[index] = (SVECTOR){point->x, point->y, point->z, point->command};
+    }
+    work->start_pos = work->nodes[0];
+    work->start_addr = HZD_GetAddress(map->hzd, &work->start_pos, -1);
+    return 0;
+}
+
+static int CheckRouteChange(Work *work)
+{
+    if ((unsigned char)work->param.c_root == Z10_Command.field_24)
+        return 0;
+    work->param.c_root = Z10_Command.field_24;
+    ReloadRoute(work);
+    return 1;
+}
+
+static void PatrolEvents(Work *work)
+{
+    int events = work->modetime[6];
+    if (events & 4)
+    {
+        work->think2 = work->think3 = 4;
+        work->count3 = 0;
+        work->modetime[2] = 0;
+    }
+    else if (events & 2)
+    {
+        work->think2 = 2;
+        work->think3 = 5;
+        work->count3 = 0;
+    }
+    else if (events & 1)
+        HeardNoise(work);
+    else if (events & 16)
+    {
+        work->think2 = work->think3 = 5;
+        work->modetime[4] = NearAsiato();
+        work->count3 = 0;
+    }
+    else if (work->alert_level >= 3)
+    {
+        Z10_TargetLast();
+        FoundPlayer(work);
+    }
+}
+
+static void Patrol(Work *work)
+{
+    if (work->think3 == 0 && MoveToTarget(work))
+    {
+        work->pad.field_4 = 0;
+        work->think2 = 0;
+        work->think3 = 1;
+        NextNode(work);
+        work->count3 = 0;
+    }
+    else if (work->think3 == 1 && MoveRoute(work))
+    {
+        if (CheckRouteChange(work))
+        {
+            TargetStart(work);
+            work->next_node = work->n_nodes - 1;
+            ResetThink(work);
+            work->pad.field_4 = 1;
+            return;
+        }
+        if (SelectRouteAction(work))
+            work->think3 = 2;
+        else
+        {
+            NextNode(work);
+            work->count3 = 0;
+        }
+    }
+    else if (work->think3 == 2 && WaitRouteAction(work))
+    {
+        NextNode(work);
+        work->think3 = 1;
+        work->count3 = 0;
+    }
+    PatrolEvents(work);
+}
+
+static void StartAlert(Work *work)
+{
+    if (work->think3 == 11 && Surprise(work))
+    {
+        PursuePlayer(work);
+        work->pad.sound = Z10_Command.alert_mode ? 246 : 240;
+        work->alert_level = 255;
+    }
+    else if (work->think3 == 12 && SurpriseNoise(work))
+    {
+        work->think1 = 1;
+        work->think2 = 10;
+        work->think3 = 23;
+        work->pad.field_4 = 1;
+        work->pad.sound = 240;
+        work->count3 = 0;
+        work->alert_level = 255;
+    }
+    else if (work->think3 == 13 && SurpriseNoise(work))
+    {
+        PursuePlayer(work);
+        work->pad.sound = 240;
+        work->alert_level = 255;
+    }
+}
+
+static void CheckAttackRange(Work *work)
+{
+    if ((Z10_Command.time / 4) % 4 == work->param.index)
+    {
+        if ((unsigned char)work->param.next == 255)
+        {
+            if (work->current_addr != Z10_PlayerAddress &&
+                (work->chase_dis < work->sn_dis || (work->chase_dis <= 4000 && work->vision.pad != 2)))
+                PursuePlayer(work);
+        }
+        else if (work->vision.pad != 2 &&
+                 !HZD_InsideZone(work->control.map->hzd, &work->control.mov, (unsigned char)work->param.next))
+            PursuePlayer(work);
+    }
+    if (work->vision.pad == 2)
+    {
+        Z10_TargetLast();
+        work->alert_level = 255;
+    }
+}
+
+static void AttackPlayer(Work *work)
+{
+    int action = work->think3;
+    if ((action == 16 || action == 17 || (action >= 19 && action <= 22)) && Attack(work, action))
+    {
+        work->think3 = 22;
+        work->count3 = 0;
+    }
+    CheckAttackRange(work);
+}
+
+static void ChasePlayer(Work *work)
+{
+    if (work->think3 == 14)
+    {
+        TargetPlayer(work);
+        if (MoveToTarget(work))
+        {
+            work->think3 = 15;
+            work->count3 = 0;
+        }
+    }
+    else if (work->think3 == 15)
+    {
+        int reached = MoveToPlayer(work);
+        if (reached != 0)
+        {
+            if (reached < 0)
+                work->think3 = 14;
+            else
+            {
+                work->think2 = 9;
+                work->think3 = 22;
+            }
+            work->count3 = 0;
+        }
+    }
+    if (work->sn_dis < work->chase_dis)
+    {
+        if (work->chase_dis < 7000 && work->vision.pad != 2)
+        {
+            Z10_TargetLast();
+            return;
+        }
+        work->think2 = 9;
+        work->think3 = 22;
+        work->count3 = 0;
+    }
+    if (work->vision.pad == 2)
+        work->alert_level = 255;
+    Z10_TargetLast();
+}
+
+static void ChaseLast(Work *work)
+{
+    if (work->think3 == 23 && MoveToTarget(work))
+    {
+        work->think2 = 9;
+        work->think3 = 22;
+        work->count3 = 0;
+    }
+    if ((unsigned char)work->param.next == 255 && (work->modetime[6] & 1))
+    {
+        Z10_TargetLast();
+        work->think2 = 7;
+        work->think3 = 13;
+        work->count3 = 0;
+    }
+    else if (work->vision.pad == 2)
+    {
+        work->think2 = 9;
+        work->think3 = 22;
+        work->count3 = 0;
+    }
+}
+
+static void PhaseNormal(Work *work)
+{
+    switch (work->think2)
+    {
+    case 0:
+        Patrol(work);
+        break;
+    case 6:
+        ReturnToRoute(work);
+        break;
+    case 7:
+        work->control.radar_atr |= 0x1000;
+        StartAlert(work);
+        break;
+    }
+    if (Z10_Command.alert_mode != 0)
+        PursueLast(work);
+}
+
+static void PhaseAlert(Work *work)
+{
+    switch (work->think2)
+    {
+    case 7:
+        StartAlert(work);
+        break;
+    case 8:
+        ChasePlayer(work);
+        break;
+    case 9:
+        AttackPlayer(work);
+        break;
+    case 10:
+        ChaseLast(work);
+        break;
+    }
+    if (Z10_Command.alert_mode != 1)
+        LeaveAlert(work);
+}
+
+void Z10_Think(Work *work)
+{
+    work->pad.dir = -1;
+    work->pad.press = 0;
+    if (work->think1 == 0 || work->think1 == 1)
+    {
+        work->act.field_1E = 1;
+        if (work->think1 == 0)
+            PhaseNormal(work);
+        else
+            PhaseAlert(work);
+    }
+    if (Z10_Activated <= 0)
+    {
+        work->alert_level = 0;
+        work->control.radar_atr = 0;
+    }
+    else
+        work->alert_level = 255;
+}
