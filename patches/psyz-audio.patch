     if (kernel_lock) {
@@ -252,6 +254,48 @@ static void LatchLine(int line) {
     KernelUnlock();
 }
 
+void Psyz_KernelInterrupt(unsigned int irq) {
+    if (irq < IRQ_COUNT) {
+        LatchLine((int)irq);
+    }
+}
+
+static void DispatchDma(void) {
+    unsigned completed = dma_pending;
+    dma_pending = 0;
+    for (unsigned channel = 0; channel < LEN(dma_callbacks); ++channel) {
+        if ((completed & (1u << channel)) && dma_callbacks[channel]) {
+            dma_callbacks[channel]();
+        }
+    }
+}
+
+void* DMACallback(int dma, void (*func)()) {
+    void (*previous)(void);
+    if (dma < 0 || dma >= LEN(dma_callbacks)) {
+        return NULL;
+    }
+    KernelLock();
+    previous = dma_callbacks[dma];
+    dma_callbacks[dma] = func;
+    irq_callbacks[IRQ_DMA] = DispatchDma;
+    irq_mask |= 1u << IRQ_DMA;
+    ServicePending();
+    KernelUnlock();
+    return (void*)previous;
+}
+
+void Psyz_DmaComplete(PsyzDmaChannel channel) {
+    if ((unsigned)channel >= LENU(dma_callbacks)) {
+        return;
+    }
+    KernelLock();
+    dma_pending |= 1u << channel;
+    irq_latched |= 1u << IRQ_DMA;
+    ServicePending();
+    KernelUnlock();
+}
+
