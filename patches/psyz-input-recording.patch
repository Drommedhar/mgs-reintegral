 #define N_CHANNELS 2
 #define SAMPLE_SIZE sizeof(short)
@@ -44,8 +45,59 @@ void Psyz_AudioSetServiceCallback(void (*service)(void)) {
     service_tasks = service;
 }
 
+static void QueueTimelineAudio(const short* buffer, int frames) {
+    if (!sdl_stream) {
+        return;
+    }
+    if (SDL_AudioStreamDevicePaused(sdl_stream)) {
+        if (!SDL_ClearAudioStream(sdl_stream)) {
+            ERRORF("cannot clear paused audio: %s", SDL_GetError());
+            abort();
+        }
+        return;
+    }
+    int queued = SDL_GetAudioStreamQueued(sdl_stream);
+    if (queued < 0) {
+        ERRORF("cannot query queued audio: %s", SDL_GetError());
+        abort();
+    }
+    if (queued > BUFFER_FRAMES * N_CHANNELS * SAMPLE_SIZE * 4) {
+        WARNF("movie audio output backlog cleared; emulated samples preserved");
+        if (!SDL_ClearAudioStream(sdl_stream)) {
+            ERRORF("cannot clear backlogged audio: %s", SDL_GetError());
+            abort();
+        }
+    }
+    if (!SDL_PutAudioStreamData(sdl_stream, buffer,
+                               frames * N_CHANNELS * SAMPLE_SIZE)) {
+        ERRORF("cannot queue generated audio: %s", SDL_GetError());
+        abort();
+    }
+}
+
+static void PumpTimelineAudio(void) {
+    short buffer[BUFFER_FRAMES * N_CHANNELS];
+    unsigned due = Psyz_ClockAudioFramesDue();
+    while (due) {
+        unsigned frames = due > BUFFER_FRAMES ? BUFFER_FRAMES : due;
+        Psyz_AudioLock();
+        Psyz_SpuPullSamplesServiced(buffer, (int)frames, service_tasks);
+        Psyz_AudioUnlock();
+        QueueTimelineAudio(buffer, (int)frames);
+        due = Psyz_ClockAudioFramesDue();
+    }
+}
+
 void Psyz_AudioPump(void) {
 #ifdef PSYZ_POLL_IRQ_ONLY
+    if (Psyz_ClockDeterministic()) {
+        if (!pumping) {
+            pumping = true;
+            PumpTimelineAudio();
+            pumping = false;
+        }
+        return;
+    }
     if (!sdl_stream || pumping || SDL_AudioStreamDevicePaused(sdl_stream)) {
         return;
     }
diff --git a/psyz/src/psyz/clock.c b/psyz/src/psyz/clock.c
new file mode 100644
index 0000000..496400b
--- /dev/null
+++ b/psyz/src/psyz/clock.c
@@ -0,0 +1,80 @@
+#include <psyz/clock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "clock_internal.h"
+#include "os.h"
+
+/* 8820000 Hz represents both video periods and each SPU sample exactly. */
+enum { NTSC_FRAME_TICKS = 147147, PAL_FRAME_TICKS = 176400, SAMPLE_TICKS = 200 };
+static int deterministic;
+static int frame_active;
+static uint64_t now_ticks, target_ticks, last_blank_ticks, audio_samples;
+static uint32_t vblanks;
+
+static void RequireFrame(int condition) {
+    if (!condition) {
+        fputs("PsyZ deterministic clock: invalid frame/sample order.\n", stderr);
+        abort();
+    }
+}
+
+int Psyz_ClockSetDeterministic(int enabled) {
+#ifndef PSYZ_POLL_IRQ_ONLY
+    if (enabled) {
+        return -1;
+    }
+#endif
+    if (frame_active) {
+        return -1;
+    }
+    deterministic = enabled != 0;
+    now_ticks = target_ticks = last_blank_ticks = audio_samples = 0;
+    vblanks = 0;
+    return 0;
+}
+
+int Psyz_ClockDeterministic(void) { return deterministic; }
+
+uint32_t Psyz_ClockNowUs(void) {
+    return deterministic ? (uint32_t)(now_ticks * 50 / 441) : Psyz_OsNowUs();
+}
+
+uint32_t Psyz_ClockVBlanks(void) { return vblanks; }
+
+unsigned Psyz_ClockScanlines(void) {
+    return (unsigned)((now_ticks - last_blank_ticks) * 50 / (441 * 64));
+}
+
+void Psyz_ClockBeginFrame(int pal) {
+    if (!deterministic) {
+        return;
+    }
+    RequireFrame(!frame_active);
+    target_ticks += pal ? PAL_FRAME_TICKS : NTSC_FRAME_TICKS;
+    frame_active = 1;
+}
+
+unsigned Psyz_ClockAudioFramesDue(void) {
+    return deterministic && frame_active ?
+        (unsigned)(target_ticks / SAMPLE_TICKS - audio_samples) : 0;
+}
+
+int Psyz_ClockAdvanceAudioSample(void) {
+    if (!deterministic || !frame_active) {
+        return 0;
+    }
+    RequireFrame(Psyz_ClockAudioFramesDue() != 0);
+    now_ticks = ++audio_samples * SAMPLE_TICKS;
+    return 1;
+}
+
+void Psyz_ClockEndFrame(void) {
+    if (!deterministic) {
+        return;
+    }
+    RequireFrame(frame_active && Psyz_ClockAudioFramesDue() == 0);
+    now_ticks = target_ticks;
+    last_blank_ticks = now_ticks;
+    ++vblanks;
+    frame_active = 0;
+}
