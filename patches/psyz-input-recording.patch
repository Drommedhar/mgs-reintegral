 #define PSYZ_PAD_BUF_LEN 34
 
+/**
+ * @brief Observe or replace both controller packets after a backend poll.
+ *
+ * The callback receives writable copies of both complete packets and channel-0
+ * controller kinds. Its results are published before the requesting pad read
+ * returns. Cached reads do not invoke it again. Do not poll or read pads from
+ * inside the callback. Packet pointers are valid only for this call.
+ */
+typedef void (*PsyzPadPollHook)(char frames[2][PSYZ_PAD_BUF_LEN],
+                               PsyzControllerKind kinds[2], void* userdata);
+
+/**
+ * @brief Set the hook for subsequent backend input samples, or NULL to remove.
+ *
+ * Registration and callbacks run on the thread that reads pads. Changing the
+ * hook does not invalidate the current sample or skip platform event polling.
+ */
+void Psyz_PadsSetPollHook(PsyzPadPollHook hook, void* userdata);
