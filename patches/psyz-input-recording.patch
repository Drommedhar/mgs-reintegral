+#ifndef PSYZ_CLOCK_H
+#define PSYZ_CLOCK_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Select a deterministic emulated clock before starting the game kernel.
+ * Nonzero enables NTSC 60000/1001 Hz or PAL 50 Hz VBlanks with 44100 Hz audio.
+ * Host rendering remains paced normally; device consumption cannot advance
+ * emulated time. Requires the polled-IRQ backend. Returns 0, or -1 if unsupported
+ * or called during an active frame. Reconfiguration resets the clock epoch.
+ */
+int Psyz_ClockSetDeterministic(int enabled);
+int Psyz_ClockDeterministic(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
