diff --git a/source/libdg/light.c b/source/libdg/light.c
index 3d296f8ff..f95708adc 100644
--- a/source/libdg/light.c
+++ b/source/libdg/light.c
@@ -46,6 +46,43 @@ typedef struct {
 static FIXLIGHT SECTION(".bss") fix_lights[ MAX_FIX_LIGHTS ];
 static TLIGHT   SECTION(".bss") tlights[ 2 ];
 
+#ifdef MGS_GODOT_SCENE
+unsigned MgsGodotCopyTemporaryLights(void *destination, unsigned capacity)
+{
+    const TLIGHT *source = &tlights[~GV_Time & 1];
+    if ((unsigned)source->n_lights > capacity)
+    {
+        printf("Godot temporary light capacity exceeded\n");
+        exit(EXIT_FAILURE);
+    }
+    memcpy(destination, source->lights, source->n_lights * sizeof(DG_LIT));
+    return source->n_lights;
+}
+#endif
+
+#ifdef MGS_REMIX_SCENE
+unsigned MgsRemixCopyLights(void *output, unsigned capacity)
+{
+    DG_LIT *destination = output;
+    unsigned count = 0;
+    for (int group = 0; group <= MAX_FIX_LIGHTS; ++group)
+    {
+        const DG_LIT *source = group == MAX_FIX_LIGHTS ? tlights[~GV_Time & 1].lights : fix_lights[group].lights;
+        const int size = group == MAX_FIX_LIGHTS ? tlights[~GV_Time & 1].n_lights : fix_lights[group].n_lights;
+        for (int i = 0; i < size; ++i)
+        {
+            if (count == capacity)
+            {
+                printf("Remix scene light capacity exceeded\n");
+                exit(EXIT_FAILURE);
+            }
+            destination[count++] = source[i];
+        }
+    }
+    return count;
+}
+#endif
+
 /*---------------------------------------------------------------------------*/
 
 void DG_InitLightSystem( void )
