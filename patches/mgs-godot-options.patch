+            if (poly == &groups[group][item]) work->ui_textures[index] = name;
+}
+
+static void OptionsView(Work *work)
+{
+    MgsOptionsFrame frame = {.active = 1, .selection = work->f920, .animation = work->f2B58,
+        .vibration = work->f2B54, .test = work->f2B50, .controller_row = work->f29E4,
+        .controller_type = work->f29E8, .reverse = work->f29EC};
+    for (unsigned index = 0; index < 8; ++index) frame.values[index] = work->f924[index];
+    const POLY_FT4 *groups[] = {work->field_34, work->field_5D4, work->field_674, work->field_46C};
+    const int *layers[] = {work->f2A00, work->f2AFC, work->f2B0C, work->f2A6C};
+    const unsigned sizes[] = {27, 4, 17, 9};
+    MgsOptionsElement elements[MGS_OPTIONS_ELEMENTS];
+    unsigned index = 0;
+    for (unsigned group = 0; group < 4; ++group) {
+        for (unsigned item = 0; item < sizes[group]; ++item, ++index) {
+            const POLY_FT4 *poly = &groups[group][item];
+            unsigned r = poly->r0, g = poly->g0, b = poly->b0;
+            if (work->f920 == 11) {
+                r -= r * work->f2B58 / 16;
+                g -= g * work->f2B58 / 16;
+                b -= b * work->f2B58 / 16;
+            }
+            elements[index] = (MgsOptionsElement){.texture = work->ui_textures[index],
+                .x = poly->x0 + 160, .y = poly->y0 + 112,
+                .width = poly->x1 - poly->x0, .height = poly->y2 - poly->y0,
+                .rgb = r | (g << 8) | (b << 16), .layer = layers[group][item] / 256,
+                .blend = (poly->code & 2) ? 1 + ((poly->tpage >> 5) & 3) : 0};
+        }
+    }
+    MgsGodotOptionsView(frame, elements);
+    if (work->f920 == 0 || work->f920 == 11) return;
+    for (unsigned text = 0; text < MGS_OPTIONS_TEXTS; ++text) {
+        if (!(work->ui_text_mask & (1u << text))) continue;
+        const RECT *rect = &work->fEC4[text].rect;
+        MgsGodotOptionsText(text, (MgsSubtitleFrame){.active = 1, .visible = 1,
+            .x = rect->x, .y = rect->y, .width = rect->w, .height = rect->h}, work->kcb[text].cbuffer);
+    }
+}
+#endif
