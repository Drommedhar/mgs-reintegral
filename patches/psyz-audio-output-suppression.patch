+int Psyz_AudioSetOutputSuppressed(int suppressed) {
+    if (!Psyz_ClockDeterministic())
+        return -1;
+    if (sdl_stream && (!SDL_PauseAudioStreamDevice(sdl_stream) ||
+                       !SDL_ClearAudioStream(sdl_stream))) {
+        ERRORF("cannot reset accelerated audio output: %s", SDL_GetError());
+        return -1;
+    }
+    output_suppressed = suppressed != 0;
+    timeline_priming = true;
+    queued_once = false;
+    last_refill_ns = 0;
+    return 0;
+}
+
 int Psyz_AudioIsPaused(void) {
     return !sdl_stream || SDL_AudioStreamDevicePaused(sdl_stream);
 }
