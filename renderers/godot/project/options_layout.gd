static func texture_id(name: String) -> int:
	var value := 0
	for byte in name.to_ascii_buffer(): value = (((value << 5) | (value >> 11)) + byte) & 65535
	return value

static func focus_rects(target: Rect2) -> Array[Rect2]:
	var x := target.position.x
	var y := target.position.y
	var w := target.size.x
	var h := target.size.y
	return [Rect2(x-6,y-6,8,8),Rect2(x+w-2,y-6,8,8),
		Rect2(x-6,y+h-2,8,8),Rect2(x+w-2,y+h-2,8,8),
		Rect2(x+2,y-6,w-4,8),Rect2(x+2,y+h-2,w-4,8),
		Rect2(x-6,y+2,8,h-4),Rect2(x+w-2,y+2,8,h-4),Rect2(x+2,y+2,w-4,h-4)]
